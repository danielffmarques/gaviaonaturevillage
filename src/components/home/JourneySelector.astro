---
// src/components/home/JourneySelector.astro
import { EXPERIENCE_PROGRAMS } from '../../utils/data';

const journeys = [
  { id: 'casal', label: 'A Dois & Romance', desc: 'Privacidade, pôr do sol no Sky Lounge e rituais de spa a dois' },
  { id: 'familia', label: 'Em Família', desc: 'Quinta pedagógica, piscina biológica e espaço seguro para brincar' },
  { id: 'wellness', label: 'Retiro & Bem-Estar', desc: 'Circuito de hidromassagem, sauna panorâmica e massagens na natureza' },
  { id: 'aventura', label: 'Aventura & Trilhos', desc: 'Passadiços do Alamal, descidas no Rio Tejo e rotas PR1 a PR8' },
];
---

<section id="experiencias" class="py-16 md:py-24 bg-sand-warm/60 border-t border-b border-sand-border/70">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Cabeçalho da Secção -->
    <div class="text-center max-w-3xl mx-auto mb-10 md:mb-14">
      <h2 class="font-catamaran font-extrabold text-2xl sm:text-3xl lg:text-4xl uppercase tracking-wide text-charcoal mb-4">
        Como deseja viver o Gavião?
      </h2>
      <p class="font-catamaran text-charcoal-muted text-sm sm:text-base leading-relaxed">
        Cada estadia tem um ritmo próprio. Escolha o seu estilo de viagem e descubra as comodidades, roteiros e programas desenhados para si.
      </p>
    </div>

    <!-- Seletor de Abas Interativo -->
    <div class="flex flex-wrap justify-center gap-2 sm:gap-3 mb-10">
      {journeys.map((j, idx) => (
        <button
          type="button"
          data-journey-tab={j.id}
          class={`journey-tab-btn px-4 sm:px-6 py-3 rounded-full text-xs sm:text-sm font-catamaran font-bold tracking-wider uppercase transition-all duration-300 flex items-center gap-2 border ${
            idx === 0 
              ? 'bg-charcoal text-white border-charcoal shadow-md' 
              : 'bg-white text-charcoal border-sand-border hover:border-natureGold hover:text-natureGold'
          }`}
        >
          {j.id === 'casal' && (
            <svg class="w-4 h-4 shrink-0 text-natureGold" fill="currentColor" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
          )}
          {j.id === 'familia' && (
            <svg class="w-4 h-4 shrink-0 text-natureGold" fill="currentColor" viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
          )}
          {j.id === 'wellness' && (
            <svg class="w-4 h-4 shrink-0 text-natureGold" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2c-.4 2.6-2.1 4.8-4.4 5.8 1.9 1 3.4 2.7 4.4 4.8 1-2.1 2.5-3.8 4.4-4.8C14.1 6.8 12.4 4.6 12 2zm-5.5 8c-.6 2.3-2.1 4.3-4.5 5.3 1.9.9 3.5 2.4 4.5 4.3.9-1.9 2.5-3.4 4.5-4.3C8.6 14.3 7.1 12.3 6.5 10zm11 0c-.6 2.3-2.1 4.3-4.5 5.3 1.9.9 3.5 2.4 4.5 4.3.9-1.9 2.5-3.4 4.5-4.3-2.4-1-3.9-3-4.5-5.3z"/></svg>
          )}
          {j.id === 'aventura' && (
            <svg class="w-4 h-4 shrink-0 text-natureGold" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm2.19 12.19L6 18l3.81-8.19L18 6l-3.81 8.19z"/></svg>
          )}
          <span>{j.label}</span>
        </button>
      ))}
    </div>

    <!-- Painéis de Conteúdo por Jornada -->
    <div class="relative">
      {EXPERIENCE_PROGRAMS.map((prog, idx) => (
        <div 
          id={`journey-panel-${prog.journey}`}
          class={`journey-panel transition-all duration-500 ${idx === 0 ? 'block opacity-100' : 'hidden opacity-0'}`}
        >
          <div class="bg-white rounded-xl shadow-soft border border-sand-border overflow-hidden grid grid-cols-1 lg:grid-cols-12 items-center">
            
            <!-- Imagem com badge -->
            <div class="lg:col-span-6 relative h-64 sm:h-80 lg:h-[420px] overflow-hidden group">
              <img 
                src={prog.image} 
                alt={prog.title} 
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-charcoal-dark/70 via-transparent to-transparent lg:hidden"></div>
              <div class="absolute bottom-4 left-4 lg:hidden text-white font-bold text-lg font-catamaran">
                {prog.title}
              </div>
            </div>

            <!-- Conteúdo Descritivo -->
            <div class="lg:col-span-6 p-6 sm:p-8 lg:p-10 flex flex-col justify-between h-full">
              <div>
                <span class="text-natureGold font-bold text-xs uppercase tracking-widest font-montserrat block mb-2">
                  Duração Recomendada: {prog.duration}
                </span>
                <h3 class="font-catamaran font-bold text-xl sm:text-2xl text-charcoal mb-3">
                  {prog.title}
                </h3>
                <p class="font-playfair italic text-sm text-natureGold-dark mb-4">
                  "{prog.subtitle}"
                </p>
                <p class="font-catamaran text-charcoal-muted text-sm sm:text-base leading-relaxed mb-6">
                  {prog.description}
                </p>

                <!-- Destaques -->
                <div class="mb-8">
                  <h4 class="text-xs font-bold uppercase tracking-wider text-charcoal mb-3 font-montserrat">
                    O Que Está Incluído & Destaques:
                  </h4>
                  <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs sm:text-sm text-charcoal">
                    {prog.highlights.map(h => (
                      <li class="flex items-center gap-2">
                        <span class="w-1.5 h-1.5 rounded-full bg-natureGold"></span>
                        {h}
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <!-- CTAs -->
              <div class="flex flex-wrap items-center gap-4 pt-4 border-t border-sand-border">
                <a 
                  href="#reserva" 
                  class="btn-primary text-xs sm:text-sm py-2.5 px-6"
                >
                  Consultar Disponibilidade
                </a>
                <a 
                  href="#alojamentos" 
                  class="text-xs sm:text-sm font-bold uppercase tracking-wider text-charcoal hover:text-natureGold transition-colors font-catamaran"
                >
                  Ver Alojamentos Recomendados →
                </a>
              </div>
            </div>

          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  // Lógica de alternância fluida entre as jornadas
  const tabButtons = document.querySelectorAll('.journey-tab-btn');
  const panels = document.querySelectorAll('.journey-panel');

  tabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const journey = btn.getAttribute('data-journey-tab');

      // Atualiza estilo dos botões
      tabButtons.forEach(b => {
        b.classList.remove('bg-charcoal', 'text-white', 'border-charcoal', 'shadow-md');
        b.classList.add('bg-white', 'text-charcoal', 'border-sand-border');
      });
      btn.classList.remove('bg-white', 'text-charcoal', 'border-sand-border');
      btn.classList.add('bg-charcoal', 'text-white', 'border-charcoal', 'shadow-md');

      // Alterna painéis
      panels.forEach(p => {
        p.classList.add('hidden', 'opacity-0');
        p.classList.remove('block', 'opacity-100');
      });

      const activePanel = document.getElementById(`journey-panel-${journey}`);
      if (activePanel) {
        activePanel.classList.remove('hidden');
        setTimeout(() => {
          activePanel.classList.add('block', 'opacity-100');
        }, 30);
      }
    });
  });
</script>
