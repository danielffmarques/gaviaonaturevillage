---
// src/components/home/FaqSection.astro
import { FAQS } from '../../utils/data';
---

<section id="faqs" class="py-16 md:py-24 bg-white border-b border-sand-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Cabeçalho -->
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="inline-block px-3.5 py-1 rounded-full border border-natureGold/40 text-natureGold-dark text-[11px] font-bold tracking-widest uppercase mb-3 bg-natureGold/5 font-montserrat">
        Esclarecimento de Dúvidas
      </span>
      <h2 class="font-catamaran font-extrabold text-2xl sm:text-3xl lg:text-4xl uppercase tracking-wide text-charcoal mb-3">
        Perguntas Frequentes
      </h2>
    </div>

    <!-- Layout Lado a Lado: FAQs (8) + Formulário Direto -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      
      <!-- Coluna Esquerda: Acordeão com as 8 Perguntas Frequentes -->
      <div class="lg:col-span-7 space-y-3">
        {FAQS.map((faq, idx) => (
          <details 
            class="faq-item group bg-sand-warm/50 border border-sand-border rounded-lg overflow-hidden transition-all duration-300 open:bg-white open:shadow-soft"
            open={idx === 0}
          >
            <summary class="flex justify-between items-center p-4 cursor-pointer font-catamaran font-bold text-sm sm:text-base text-charcoal hover:text-natureGold select-none transition-colors">
              <span class="flex items-center gap-2.5">
                <span class="text-xs text-natureGold font-montserrat font-bold">{idx + 1 < 10 ? `0${idx + 1}` : idx + 1}.</span>
                {faq.question}
              </span>
              <span class="w-6 h-6 rounded-full border border-natureGold/40 text-natureGold flex items-center justify-center text-xs shrink-0 transition-transform duration-300 group-open:rotate-180">
                ▼
              </span>
            </summary>
            <div class="px-4 pb-4 pt-1 text-xs sm:text-sm text-charcoal-muted leading-relaxed font-catamaran border-t border-sand-border/40">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>

      <!-- Coluna Direita: Caixa de Dúvidas Direta com a Receção -->
      <div class="lg:col-span-5 bg-sand-warm border border-sand-border rounded-xl p-6 sm:p-8 shadow-soft sticky top-28">
        <div class="mb-5">
          <span class="text-xs font-bold text-natureGold uppercase tracking-wider font-montserrat block mb-1">
            Fale com a Nossa Equipa
          </span>
          <h3 class="font-catamaran font-bold text-xl text-charcoal">
            Tem alguma dúvida específica?
          </h3>
        </div>

        <form id="faq-direct-form" class="space-y-4">
          <div>
            <label for="faq-name" class="block text-xs font-bold uppercase tracking-wider text-charcoal mb-1 font-montserrat">
              Nome Completo *
            </label>
            <input 
              type="text" 
              id="faq-name" 
              required 
              placeholder="O seu nome" 
              class="w-full bg-white border border-sand-border rounded px-3 py-2 text-sm text-charcoal focus:outline-none focus:border-natureGold focus:ring-1 focus:ring-natureGold transition-colors"
            />
          </div>

          <div>
            <label for="faq-email" class="block text-xs font-bold uppercase tracking-wider text-charcoal mb-1 font-montserrat">
              Endereço de E-mail *
            </label>
            <input 
              type="email" 
              id="faq-email" 
              required 
              placeholder="exemplo@email.com" 
              class="w-full bg-white border border-sand-border rounded px-3 py-2 text-sm text-charcoal focus:outline-none focus:border-natureGold focus:ring-1 focus:ring-natureGold transition-colors"
            />
          </div>

          <div>
            <label for="faq-phone" class="block text-xs font-bold uppercase tracking-wider text-charcoal mb-1 font-montserrat">
              Telefone / Telemóvel
            </label>
            <input 
              type="tel" 
              id="faq-phone" 
              placeholder="+351 900 000 000" 
              class="w-full bg-white border border-sand-border rounded px-3 py-2 text-sm text-charcoal focus:outline-none focus:border-natureGold focus:ring-1 focus:ring-natureGold transition-colors"
            />
          </div>

          <div>
            <label for="faq-msg" class="block text-xs font-bold uppercase tracking-wider text-charcoal mb-1 font-montserrat">
              Mensagem ou Pergunta *
            </label>
            <textarea 
              id="faq-msg" 
              rows="3" 
              required 
              placeholder="Como podemos ajudar a planear a sua estadia?"
              class="w-full bg-white border border-sand-border rounded px-3 py-2 text-sm text-charcoal focus:outline-none focus:border-natureGold focus:ring-1 focus:ring-natureGold transition-colors"
            ></textarea>
          </div>

          <button 
            type="submit" 
            class="w-full btn-primary text-xs uppercase tracking-wider py-3 flex items-center justify-center gap-2"
          >
            <span>Enviar Mensagem à Receção</span>
            <span>→</span>
          </button>
        </form>

        <div class="mt-4 pt-4 border-t border-sand-border/70 text-center">
          <p class="text-xs text-charcoal-muted font-montserrat">
            Atendimento Telefónico Direto:<br>
            <strong class="text-charcoal">+351 241 247 360</strong> | <strong class="text-charcoal">+351 924 289 410</strong>
          </p>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  const faqForm = document.getElementById('faq-direct-form');
  faqForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    alert('Mensagem enviada com sucesso! A equipa da receção do Gavião Nature Village entrará em contacto brevemente.');
    (faqForm as HTMLFormElement).reset();
  });
</script>
