---
// src/components/home/GastronomySection.astro
---

<section id="restaurante" class="py-16 md:py-24 bg-sand-bg border-b border-sand-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      
      <!-- Lado Esquerdo: Conteúdo Editorial -->
      <div class="lg:col-span-6">
        <span class="inline-block px-3.5 py-1 rounded-full border border-natureGold/40 text-natureGold-dark text-[11px] font-bold tracking-widest uppercase mb-3 bg-natureGold/5 font-montserrat">
          Gastronomia & Sky Lounge
        </span>
        <h2 class="font-catamaran font-extrabold text-2xl sm:text-3xl lg:text-4xl uppercase tracking-wide text-charcoal mb-4">
          Restaurante Cadafaz & Sky Lounge Bar
        </h2>
        <p class="font-playfair italic text-base sm:text-lg text-natureGold-dark mb-4">
          Vista panorâmica para o Castelo de Belver sob o céu estrelado do Alentejo.
        </p>
        <p class="font-catamaran text-charcoal-muted text-sm sm:text-base leading-relaxed mb-6">
          Apresentamos uma cozinha regional com um toque moderno que exalta o que de melhor se produz nas redondezas: os tradicionais enchidos, o azeite virgem extra e a seleção cuidada de vinhos alentejanos.
        </p>

        <!-- Informações Práticas em Cards Limpos -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
          <div class="bg-white p-4 rounded-lg border border-sand-border shadow-soft">
            <div class="text-xs font-bold uppercase tracking-wider text-charcoal mb-1 font-montserrat flex items-center gap-1.5">
              <svg class="w-4 h-4 text-natureGold shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><circle cx="12" cy="12" r="9"/><polyline points="12 6 12 12 16 14"/></svg>
              <span>Horários de Serviço</span>
            </div>
            <p class="text-xs text-charcoal-muted leading-relaxed font-catamaran">
              <strong>Almoço:</strong> 12h30 às 15h00<br>
              <strong>Jantar:</strong> 19h00 às 22h00
            </p>
          </div>
          <div class="bg-white p-4 rounded-lg border border-sand-border shadow-soft">
            <div class="text-xs font-bold uppercase tracking-wider text-charcoal mb-1 font-montserrat flex items-center gap-1.5">
              <svg class="w-4 h-4 text-natureGold shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M17 8C8 10 5.9 16.17 3.82 21.34l1.89.66.95-2.3c.48.17.98.3 1.34.3C19 20 22 3 22 3c-1 2-8 2.25-13 3.25S2 11.5 2 13.5s1.75 3.75 1.75 3.75C7 8 17 8 17 8z"/></svg>
              <span>Dietas Especiais</span>
            </div>
            <p class="text-xs text-charcoal-muted leading-relaxed font-catamaran">
              Disponibilizamos opções vegetarianas, veganas e sem glúten preparadas no momento.
            </p>
          </div>
        </div>

        <!-- Destaque do Sky Lounge Bar -->
        <div class="border-l-2 border-natureGold pl-4 mb-8">
          <h4 class="font-catamaran font-bold text-base text-charcoal mb-1">
            Sky Lounge Bar no Piso Superior
          </h4>
          <p class="text-xs sm:text-sm text-charcoal-muted leading-relaxed">
            Nas tardes quentes de verão, relaxe com uma bebida fresca enquanto aprecia o pôr do sol. No inverno, acolha-se com bebidas quentes e boa conversa diante da paisagem iluminada de Belver.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-4">
          <a 
            href="#reserva" 
            class="btn-primary text-xs sm:text-sm py-2.5 px-6"
          >
            Reservar Mesa / Estadia
          </a>
          <a 
            href="tel:+351241247360" 
            class="btn-secondary text-xs sm:text-sm py-2.5 px-5 flex items-center gap-2"
          >
            <span>Ligar para o Restaurante</span>
          </a>
        </div>
      </div>

      <!-- Lado Direito: Composição Fotográfica Elegante -->
      <div class="lg:col-span-6 grid grid-cols-2 gap-4">
        <div class="space-y-4">
          <div class="h-56 sm:h-72 overflow-hidden shadow-soft group">
            <img 
              src="/images/restaurante/media_20_Gavi_o.jpg" 
              alt="Ambiente Restaurante Cadafaz" 
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
            />
          </div>
          <div class="bg-white p-5 rounded-xl border border-sand-border shadow-soft text-center">
            <svg class="w-7 h-7 mx-auto mb-2 text-natureGold" fill="currentColor" viewBox="0 0 24 24"><path d="M6 3v6c0 2.97 2.16 5.43 5 5.91V19H8v2h8v-2h-3v-4.09c2.84-.48 5-2.94 5-5.91V3H6zm10 5H8V5h8v3z"/></svg>
            <span class="font-catamaran font-bold text-sm text-charcoal block">Carta de Vinhos do Tejo e Alentejo</span>
            <span class="text-[11px] text-charcoal-muted font-montserrat">Produtores locais selecionados</span>
          </div>
        </div>

        <div class="space-y-4 pt-6">
          <div class="bg-charcoal text-white p-5 rounded-xl shadow-soft text-center">
            <svg class="w-7 h-7 mx-auto mb-2 text-natureGold" fill="currentColor" viewBox="0 0 24 24"><path d="M2 19h20v3H2v-3zm0-8l2.5-3V3h3v3h2V3h3v3h2V3h3v3h2V3h3v5L22 11v6H2v-6zm3-1h14v-1.5L18 8H6l-1 .5V10zm2 4h2v-2H7v2zm8 0h2v-2h-2v2zm-4 0h2v-2h-2v2z"/></svg>
            <span class="font-catamaran font-bold text-sm text-white block">Vista Panorâmica</span>
            <span class="text-[11px] text-white/70 font-montserrat">Castelo de Belver à sua frente</span>
          </div>
          <div class="h-56 sm:h-72 overflow-hidden shadow-soft group">
            <img 
              src="/images/restaurante/media_21_Gavi_o.jpg" 
              alt="Prato e Gastronomia do Cadafaz" 
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
            />
          </div>
        </div>
      </div>

    </div>

  </div>
</section>
