---
// src/components/common/Header.astro
const pathname = Astro.url.pathname;

// As páginas oficiais do Header
const baseNavLinks = [
  { href: '/village', label: 'A Vila' },
  { href: '/alojamento', label: 'Alojamentos' },
  { href: '/experiencias', label: 'Experiências' },
];

const arredoresLinks = [
  { href: '/patrimonio-e-cultura', label: 'Património e Cultura' },
  { href: '/natureza-e-lazer', label: 'Natureza e Lazer' },
  { href: '/percursos-pedestres', label: 'Percursos Pedestres' },
];

const isArredoresActive = ['/patrimonio-e-cultura', '/natureza-e-lazer', '/percursos-pedestres', '/arredores'].some(
  p => pathname === p || pathname.startsWith(p + '/')
);

const audienceMap: Record<string, { href: string; label: string }> = {
  '/casais': { href: '/casais', label: 'Casais & Romance' },
  '/familias': { href: '/familias', label: 'Famílias & Natureza' },
  '/bem-estar': { href: '/bem-estar', label: 'Bem-Estar & Retiro' },
  '/aventura': { href: '/aventura', label: 'Aventura & Ecoturismo' }
};

// Se a página atualmente apresentada for de um público-alvo
const activeAudience = audienceMap[pathname];
---

<header 
  id="main-header" 
  class="sticky top-0 left-0 right-0 z-50 bg-[#141210] transition-shadow duration-200"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20 sm:h-24">
      
      <!-- 1. ESQUERDA: Logótipo Oficial (Volta Sempre à Homepage Principal) -->
      <div class="flex items-center">
        <a 
          href="/" 
          class="group flex items-center gap-3 focus:outline-none" 
          aria-label="Gavião Nature Village - Início"
        >
          <img 
            src="/images/branding/logo_gold.svg" 
            alt="Gavião Nature Village" 
            class="h-10 sm:h-12 lg:h-14 w-auto transition-transform duration-300 group-hover:scale-105 drop-shadow-[0_2px_8px_rgba(0,0,0,0.7)]"
            style="image-rendering: -webkit-optimize-contrast; shape-rendering: geometricPrecision;"
          />
        </a>
      </div>

      <!-- 2. CENTRO: Navegação Principal Desktop (Zero Layout Shift & Público-Alvo Persistente à Esquerda de 'A Vila') -->
      <nav id="desktop-main-nav" class="hidden lg:flex items-center gap-5 xl:gap-8">
        
        <!-- Link do Público-Alvo Escolhido (posicionado à esquerda de 'A Vila') -->
        <a 
          id="nav-audience-link"
          href={activeAudience ? activeAudience.href : '#'}
          class={`font-catamaran font-bold text-sm tracking-wider uppercase transition-colors duration-150 py-1 border-b-2 whitespace-nowrap ${
            activeAudience 
              ? 'text-natureGold border-natureGold' 
              : 'text-white/90 hover:text-natureGold border-transparent hover:border-natureGold/40'
          }`}
          style={activeAudience ? 'display: inline-block;' : 'display: none;'}
        >
          {activeAudience ? activeAudience.label : ''}
        </a>

        {baseNavLinks.map(link => {
          const isActive = pathname === link.href || (link.href !== '/' && pathname.startsWith(link.href));
          return (
            <a 
              href={link.href}
              class={`font-catamaran font-bold text-sm tracking-wider uppercase transition-colors duration-150 py-1 border-b-2 whitespace-nowrap ${
                isActive 
                  ? 'text-natureGold border-natureGold' 
                  : 'text-white/90 hover:text-natureGold border-transparent hover:border-natureGold/40'
              }`}
            >
              {link.label}
            </a>
          );
        })}

        <!-- Dropdown Arredores Desktop -->
        <div class="relative group py-2" id="nav-arredores-container">
          <div 
            class={`font-catamaran font-bold text-sm tracking-wider uppercase transition-colors duration-150 py-1 border-b-2 whitespace-nowrap inline-flex items-center gap-1.5 cursor-pointer ${
              isArredoresActive 
                ? 'text-natureGold border-natureGold' 
                : 'text-white/90 group-hover:text-natureGold border-transparent group-hover:border-natureGold/40'
            }`}
          >
            <span>Arredores</span>
            <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180 text-natureGold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </div>

          <!-- Dropdown Menu Desktop com ponte contínua para manter aberto ao descer o rato -->
          <div 
            id="nav-arredores-dropdown"
            class="absolute top-full left-0 pt-1.5 w-64 opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-200 ease-out z-50 pointer-events-none group-hover:pointer-events-auto"
          >
            <div class="bg-[#141210] border border-white/10 rounded-2xl p-2 shadow-2xl relative before:absolute before:-top-3 before:left-0 before:right-0 before:h-3 before:content-['']">
              <div class="px-3 py-1.5 border-b border-white/10 mb-1">
                <span class="text-[10px] font-montserrat font-bold uppercase tracking-widest text-natureGold block">
                  Alto Alentejo
                </span>
              </div>
              <div class="space-y-0.5">
                {arredoresLinks.map(sub => (
                  <a 
                    href={sub.href}
                    class={`block px-3 py-2 rounded-xl font-catamaran font-bold text-sm tracking-wide transition-all ${
                      pathname === sub.href 
                        ? 'bg-natureGold/20 text-natureGold' 
                        : 'text-white/85 hover:bg-white/10 hover:text-natureGold'
                    }`}
                  >
                    {sub.label}
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- FAQs -->
        <a 
          href="/faqs"
          class={`font-catamaran font-bold text-sm tracking-wider uppercase transition-colors duration-150 py-1 border-b-2 whitespace-nowrap ${
            pathname === '/faqs' 
              ? 'text-natureGold border-natureGold' 
              : 'text-white/90 hover:text-natureGold border-transparent hover:border-natureGold/40'
          }`}
        >
          FAQs
        </a>
      </nav>

      <!-- Script Síncrono Imediato: Executa durante o parsing do HTML antes da pintura (impede qualquer tremer/shift) -->
      <script is:inline>
        (function() {
          try {
            var rawPath = window.location.pathname;
            var currentPath = rawPath.replace(/\/$/, '') || '/';
            var audiences = {
              '/casais': 'Casais & Romance',
              '/familias': 'Famílias & Natureza',
              '/bem-estar': 'Bem-Estar & Retiro',
              '/aventura': 'Aventura & Ecoturismo'
            };

            // 1. Se estiver a navegar numa página de público-alvo, memoriza essa escolha
            if (audiences[currentPath]) {
              localStorage.setItem('gnv_chosen_audience_path', currentPath);
              localStorage.setItem('gnv_chosen_audience_label', audiences[currentPath]);
            }

            // 2. Recupera o público anteriormente escolhido
            var savedPath = localStorage.getItem('gnv_chosen_audience_path');
            var savedLabel = localStorage.getItem('gnv_chosen_audience_label');

            if (savedPath && savedLabel) {
              // 3. Atualiza imediatamente o link no Desktop Header
              var navLink = document.getElementById('nav-audience-link');
              if (navLink) {
                navLink.href = savedPath;
                navLink.textContent = savedLabel;
                navLink.style.display = 'inline-block';
                if (currentPath === savedPath) {
                  navLink.className = 'font-catamaran font-bold text-sm tracking-wider uppercase transition-colors duration-150 py-1 border-b-2 whitespace-nowrap text-natureGold border-natureGold';
                } else {
                  navLink.className = 'font-catamaran font-bold text-sm tracking-wider uppercase transition-colors duration-150 py-1 border-b-2 whitespace-nowrap text-white/90 hover:text-natureGold border-transparent hover:border-natureGold/40';
                }
              }

              // 4. Atualiza também no Drawer Mobile
              var drawerLink = document.getElementById('drawer-audience-link');
              if (drawerLink) {
                drawerLink.href = savedPath;
                drawerLink.textContent = savedLabel;
                drawerLink.style.display = 'block';
                if (currentPath === savedPath) {
                  drawerLink.className = 'block text-2xl font-catamaran font-bold py-2 transition-colors border-b border-white/5 text-natureGold';
                } else {
                  drawerLink.className = 'block text-2xl font-catamaran font-bold py-2 transition-colors border-b border-white/5 text-white hover:text-natureGold';
                }
              }
            }
          } catch (e) {}
        })();
      </script>

      <!-- 3. DIREITA: CTA Reservar + Botão Menu Mobile/Drawer -->
      <div class="flex items-center gap-4">
        <!-- CTA Reservar de Destaque -->
        <a 
          href="/reservar"
          class={`font-montserrat font-bold text-xs uppercase tracking-widest px-5 sm:px-6 py-2.5 sm:py-3 rounded transition-all duration-300 shadow-md ${
            pathname === '/reservar'
              ? 'bg-natureGold-light text-charcoal'
              : 'bg-natureGold hover:bg-natureGold-light text-charcoal-dark hover:shadow-[0_0_20px_rgba(184,142,74,0.4)]'
          }`}
        >
          Reservar
        </a>

        <!-- Botão Hambúrguer para Mobile -->
        <button 
          id="menu-open-btn" 
          type="button" 
          class="lg:hidden p-2 text-white hover:text-natureGold focus:outline-none transition-colors"
          aria-label="Abrir Menu"
        >
          <div class="w-6 h-4 flex flex-col justify-between">
            <span class="w-6 h-0.5 bg-white"></span>
            <span class="w-4 h-0.5 bg-white"></span>
            <span class="w-6 h-0.5 bg-white"></span>
          </div>
        </button>
      </div>

    </div>
  </div>

  <!-- =========================================================================
       DRAWER MOBILE
       ========================================================================= -->
  <div 
    id="editorial-drawer" 
    class="fixed inset-0 bg-[#141210]/98 backdrop-blur-xl z-50 transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col justify-between p-6 sm:p-10 overflow-y-auto"
  >
    <!-- Topo do Drawer -->
    <div class="w-full flex justify-between items-center border-b border-white/10 pb-5">
      <a href="/" class="focus:outline-none">
        <img 
          src="/images/branding/logo_gold.svg" 
          alt="Gavião Nature Village" 
          class="h-10 w-auto" 
        />
      </a>
      <button 
        id="menu-close-btn" 
        type="button"
        class="text-white/80 hover:text-natureGold px-3 py-1.5 rounded-full border border-white/20 hover:border-natureGold text-xs uppercase tracking-widest font-montserrat flex items-center gap-2 transition-colors"
        aria-label="Fechar Menu"
      >
        <span>Fechar</span>
        <span class="text-sm font-bold">✕</span>
      </button>
    </div>

    <!-- Navegação Oficial -->
    <div class="py-8 max-w-lg mx-auto w-full my-auto space-y-4">
      <span class="text-xs uppercase tracking-widest text-natureGold font-bold font-montserrat block mb-2">
        Navegação
      </span>

      <!-- Link do Público-Alvo Escolhido no Mobile (à esquerda / topo de 'A Vila') -->
      <a 
        id="drawer-audience-link"
        href={activeAudience ? activeAudience.href : '#'} 
        class={`block text-2xl font-catamaran font-bold py-2 transition-colors border-b border-white/5 ${
          activeAudience ? 'text-natureGold' : 'text-white hover:text-natureGold'
        }`}
        style={activeAudience ? 'display: block;' : 'display: none;'}
      >
        {activeAudience ? activeAudience.label : ''}
      </a>

      {baseNavLinks.map(link => (
        <a 
          href={link.href} 
          class={`block text-2xl font-catamaran font-bold py-2 transition-colors border-b border-white/5 ${
            pathname === link.href ? 'text-natureGold' : 'text-white hover:text-natureGold'
          }`}
        >
          {link.label}
        </a>
      ))}

      <!-- Bloco de Arredores no Mobile (Diretamente Visível Sem Necessidade de Clicar) -->
      <div class="border-b border-white/5 py-3">
        <span class="block text-xs font-montserrat font-bold uppercase tracking-widest text-natureGold mb-2">
          Arredores · Alto Alentejo
        </span>
        <div class="space-y-1 pl-1">
          {arredoresLinks.map(sub => {
            const isCurrent = pathname === sub.href;
            return (
              <a 
                href={sub.href}
                class={`block py-1.5 px-2 rounded-lg font-catamaran font-bold text-lg transition-colors ${
                  isCurrent ? 'text-natureGold' : 'text-white/80 hover:text-natureGold'
                }`}
              >
                {sub.label}
              </a>
            );
          })}
        </div>
      </div>

      <!-- FAQs -->
      <a 
        href="/faqs" 
        class={`block text-2xl font-catamaran font-bold py-2 transition-colors border-b border-white/5 ${
          pathname === '/faqs' ? 'text-natureGold' : 'text-white hover:text-natureGold'
        }`}
      >
        FAQs
      </a>

      <a 
        href="/reservar" 
        class="inline-block mt-4 text-sm font-montserrat font-bold uppercase tracking-widest px-6 py-3 rounded bg-natureGold text-charcoal-dark hover:bg-natureGold-light transition-all shadow-md text-center"
      >
        Reservar Estadia
      </a>
    </div>

    <!-- Rodapé do Drawer com Contactos Rápidos -->
    <div class="pt-6 border-t border-white/10 text-xs text-white/60 flex flex-col sm:flex-row justify-between items-center gap-3 font-montserrat">
      <div class="flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-natureGold shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
        <span>Cadafaz, Gavião · Alto Alentejo</span>
      </div>
      <div class="flex gap-4">
        <a href="tel:+351241247360" class="hover:text-natureGold flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-natureGold shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
          <span>+351 241 247 360</span>
        </a>
        <a href="mailto:rececao@gaviaonaturevillage.com" class="hover:text-natureGold flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-natureGold shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
          <span>rececao@gaviaonaturevillage.com</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  // 1. Script para abrir/fechar o drawer mobile
  const openBtn = document.getElementById('menu-open-btn');
  const closeBtn = document.getElementById('menu-close-btn');
  const drawer = document.getElementById('editorial-drawer');

  if (openBtn && drawer && closeBtn) {
    openBtn.addEventListener('click', () => {
      drawer.classList.remove('translate-x-full');
      document.body.classList.add('overflow-hidden');
    });

    closeBtn.addEventListener('click', () => {
      drawer.classList.add('translate-x-full');
      document.body.classList.remove('overflow-hidden');
    });
  }

  // 2. Scroll listener para reforçar sombra do cabeçalho com { passive: true } de alto desempenho
  const header = document.getElementById('main-header');
  window.addEventListener('scroll', () => {
    if (!header) return;
    if (window.scrollY > 10) {
      header.classList.add('shadow-xl');
    } else {
      header.classList.remove('shadow-xl');
    }
  }, { passive: true });
</script>
