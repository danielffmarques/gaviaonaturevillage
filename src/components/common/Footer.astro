---
// src/components/common/Footer.astro
---

<footer id="contactos" class="bg-[#0E171D] text-white pt-12 pb-8 border-t border-white/10 font-catamaran select-none">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Grelha Principal de 3 Colunas (Inspirada no Layout de Charme Solicitado) -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 items-start">
      
      <!-- =========================================================================
           COLUNA 1 (5 Colunas): LOGO COM DESENHO LADO A LADO, TEXTO E CONTACTOS
           ========================================================================= -->
      <div class="md:col-span-6 lg:col-span-5 space-y-4">
        
        <!-- Logótipo com Desenho e Nome Lado a Lado (Dourado, Não-link, Centrado em Altura) -->
        <div class="inline-flex items-center gap-3 sm:gap-3.5 select-none">
          <img 
            src="/images/branding/logo_icon_gold.svg" 
            alt="Ícone Gavião" 
            class="h-8 sm:h-9 w-auto shrink-0 drop-shadow-[0_2px_8px_rgba(0,0,0,0.5)]"
            style="image-rendering: -webkit-optimize-contrast; shape-rendering: geometricPrecision;"
          />
          <span class="font-playfair text-lg sm:text-xl font-bold tracking-wide text-natureGold uppercase leading-none">
            Gavião Nature Village
          </span>
        </div>

        <!-- Texto Descritivo Editorial -->
        <p class="text-white/70 text-xs sm:text-sm font-light leading-relaxed max-w-md font-montserrat">
          Ecoturismo de charme em Cadafaz, no Alto Alentejo. Espaço de tranquilidade, retiros, tendas glamping de luxo, cortiça natural e comunhão plena com a natureza e o Castelo de Belver.
        </p>

        <!-- Bloco de Contactos Estruturado -->
        <div class="pt-1 space-y-1.5 text-xs text-white/80 font-montserrat">
          <div class="flex items-center gap-2">
            <span class="text-white font-semibold min-w-[72px]">Telefone:</span>
            <a href="tel:+351241247360" class="hover:text-natureGold text-white/80 transition-colors">
              +351 241 247 360
            </a>
          </div>

          <div class="flex items-center gap-2">
            <span class="text-white font-semibold min-w-[72px]">Telemóvel:</span>
            <a href="tel:+351924289410" class="hover:text-natureGold text-white/80 transition-colors">
              +351 924 289 410
            </a>
          </div>

          <div class="flex items-center gap-2">
            <span class="text-white font-semibold min-w-[72px]">Email:</span>
            <a href="mailto:rececao@gaviaonaturevillage.com" class="hover:text-natureGold text-white/80 transition-colors truncate">
              rececao@gaviaonaturevillage.com
            </a>
          </div>

          <div class="flex items-center gap-2">
            <span class="text-white font-semibold min-w-[72px]">Receção:</span>
            <span class="text-white/75">08:00 às 23:00 (Presencial)</span>
          </div>
        </div>

        <!-- Redes Sociais -->
        <div class="pt-3 flex flex-col gap-2">
          <p class="text-[10px] font-montserrat text-white uppercase tracking-widest">Siga-nos</p>
          <div class="flex items-center gap-4">

            <!-- Instagram -->
            <a
              href="https://www.instagram.com/gaviaonaturevillage/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram"
              class="text-white/50 hover:text-natureGold transition-colors duration-200 hover:scale-110 transform"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>

            <!-- Facebook -->
            <a
              href="https://www.facebook.com/gaviaonaturevillage.pt"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook"
              class="text-white/50 hover:text-natureGold transition-colors duration-200 hover:scale-110 transform"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>

            <!-- YouTube -->
            <a
              href="https://www.youtube.com/@gaviaonaturevillage9383"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="YouTube"
              class="text-white/50 hover:text-natureGold transition-colors duration-200 hover:scale-110 transform"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </a>

            <!-- LinkedIn -->
            <a
              href="https://www.linkedin.com/company/gaviaonaturevillage/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn"
              class="text-white/50 hover:text-natureGold transition-colors duration-200 hover:scale-110 transform"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>

          </div>
        </div>

      </div>

      <!-- =========================================================================
           COLUNA 2 (3 Colunas): EXPLORAR (NAVEGAÇÃO DO WEBSITE)
           ========================================================================= -->
      <div class="md:col-span-3 lg:col-span-3 lg:pl-6 space-y-4">
        <h4 class="font-playfair text-lg sm:text-xl font-bold text-white tracking-wide">
          Explorar
        </h4>
        
        <ul class="space-y-2.5 text-xs sm:text-sm font-montserrat text-white/75">
          <li>
            <a href="/" class="hover:text-natureGold hover:translate-x-1 inline-block transition-all">
              Início
            </a>
          </li>
          <li>
            <a href="/village" class="hover:text-natureGold hover:translate-x-1 inline-block transition-all">
              A Vila
            </a>
          </li>
          <li>
            <a href="/alojamento" class="hover:text-natureGold hover:translate-x-1 inline-block transition-all">
              Alojamentos
            </a>
          </li>
          <li>
            <a href="/experiencias" class="hover:text-natureGold hover:translate-x-1 inline-block transition-all">
              Experiências
            </a>
          </li>
          <li class="space-y-1">
            <span class="text-white/40 text-[10px] uppercase tracking-wider font-bold block pt-1">Arredores (Alto Alentejo):</span>
            <div class="pl-2 space-y-1 text-xs text-white/70">
              <a href="/patrimonio-e-cultura" class="hover:text-natureGold hover:translate-x-1 block transition-all">
                • Património e Cultura
              </a>
              <a href="/natureza-e-lazer" class="hover:text-natureGold hover:translate-x-1 block transition-all">
                • Natureza e Lazer
              </a>
              <a href="/percursos-pedestres" class="hover:text-natureGold hover:translate-x-1 block transition-all">
                • Percursos Pedestres
              </a>
            </div>
          </li>
          <li>
            <a href="/faqs" class="hover:text-natureGold hover:translate-x-1 inline-block transition-all">
              FAQs
            </a>
          </li>

          <!-- CTA Pensado no Utilizador: Redireciona para a homepage de escolha dos públicos-alvo -->
          <li class="pt-2">
            <a 
              href="/" 
              class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-natureGold/15 hover:bg-natureGold/25 border border-natureGold/30 text-natureGold hover:text-natureGold-light font-montserrat text-xs font-semibold tracking-wide transition-all group shadow-sm hover:scale-[1.02]"
              title="Voltar à página inicial para escolher a sua experiência por público-alvo"
            >
              <span>Escolher Perfil de Estadia</span>
              <svg class="w-3.5 h-3.5 text-natureGold group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </a>
          </li>
        </ul>
      </div>

      <!-- =========================================================================
           COLUNA 3 (4 Colunas): LOCALIZAÇÃO COM MAPA COMPACTO
           ========================================================================= -->
      <div class="md:col-span-3 lg:col-span-4 space-y-3.5">
        <h4 class="font-playfair text-lg sm:text-xl font-bold text-white tracking-wide">
          Localização
        </h4>
        
        <p class="text-xs sm:text-sm font-montserrat text-white/70 font-light leading-snug">
          Lugar de São Domingos, Cadafaz, 6040-052 Gavião, Alto Alentejo, Portugal
        </p>

        <!-- Miniatura Estilizada do Mapa (Clean, Compacta com Botão Maps) -->
        <div class="relative w-full max-w-[280px] h-32 rounded-lg overflow-hidden border border-white/15 shadow-md group">
          <iframe 
            title="Localização do Gavião Nature Village"
            width="100%" 
            height="100%" 
            style="border:0;" 
            loading="lazy" 
            src="https://maps.google.com/maps?q=39.48150496,-7.95695673&hl=pt&z=14&output=embed"
            class="filter contrast-[1.05]"
          ></iframe>

          <!-- Botão Flutuante 'Maps ↗' Estilo Google (Como na imagem de referência) -->
          <a 
            href="https://maps.google.com/?q=39.48150496,-7.95695673" 
            target="_blank" 
            rel="noopener noreferrer"
            class="absolute top-2 left-2 bg-white/95 text-gray-800 text-[11px] font-bold font-montserrat px-2.5 py-1 rounded shadow flex items-center gap-1 hover:bg-white transition-transform hover:scale-105"
            aria-label="Ver no Google Maps"
          >
            <span>Maps</span>
            <svg class="w-3 h-3 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
            </svg>
          </a>
        </div>

        <!-- Link 'Abrir no Google Maps ↗' -->
        <div>
          <a 
            href="https://maps.google.com/?q=39.48150496,-7.95695673" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-xs text-natureGold hover:text-natureGold-light font-montserrat font-medium transition-colors"
          >
            <span>Abrir no Google Maps</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
        </div>

      </div>

    </div>

    <!-- =========================================================================
         LINHA INFERIOR: COPYRIGHT E LINKS LEGAIS
         ========================================================================= -->
    <div class="mt-10 pt-5 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between text-xs text-white/40 font-montserrat gap-3">
      <div>
        © {new Date().getFullYear()} Gavião Nature Village · Todos os direitos reservados
      </div>
      
      <div class="flex items-center gap-4">
        <a href="https://www.gaviaonaturevillage.com/aviso-legal.html" target="_blank" rel="noopener noreferrer" class="hover:text-natureGold transition-colors">
          Aviso Legal
        </a>
        <span class="text-white/20">·</span>
        <a href="https://www.gaviaonaturevillage.com/protecao-dados.html" target="_blank" rel="noopener noreferrer" class="hover:text-natureGold transition-colors">
          Proteção de Dados
        </a>
        <span class="text-white/20">·</span>
        <a href="https://www.gaviaonaturevillage.com/cookies.html" target="_blank" rel="noopener noreferrer" class="hover:text-natureGold transition-colors">
          Cookies
        </a>
      </div>
    </div>

  </div>
</footer>
