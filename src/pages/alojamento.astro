---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ACCOMMODATIONS } from '../utils/data';

const corkShelters = ACCOMMODATIONS.filter(a => a.category === 'cork-shelter');
const glampingTents = ACCOMMODATIONS.filter(a => a.category === 'glamping-tent');

const COMPARISON_DATA: Record<string, { amenities: string }> = {
  'cork-shelter-standard': { amenities: 'Isolamento em cortiça natural, Smart TV & closet' },
  'cork-shelter-superior': { amenities: 'Sala de estar luminosa, Smart TV & mini-frigorífico' },
  'cork-shelter-familiar': { amenities: '2 Quartos privados, 2 WCs completos & sala comum' },
  'tenda-amor-perfeito': { amenities: 'Cama King Size, decoração romântica & minibar' },
  'tenda-glamping-familiar': { amenities: 'Beliche em madeira p/ crianças, ampla janela & minibar' },
  'tenda-glamping-amigos': { amenities: '4 Camas de solteiro (sem beliches), 30 m² & Smart TV' }
};
---

<BaseLayout 
  title="Alojamentos de Luxo na Natureza | Cork Shelters & Glamping"
  description="Conheça os 10 Cork Shelters ecológicos em cortiça e as 13 tendas Glamping com casa de banho privativa e ar condicionado no Gavião Nature Village."
>

  <!-- =========================================================================
       HERO DA PÁGINA DE ALOJAMENTO
       ========================================================================= -->
  <section class="relative h-[38vh] min-h-[290px] md:h-[40vh] md:min-h-[330px] flex flex-col justify-center items-center bg-charcoal overflow-hidden text-white">
    <!-- Imagem de Fundo com Overlay Suave -->
    <div class="absolute inset-0 z-0">
      <img 
        src="/images/alojamentos/media_10_Gavi_o.jpg" 
        alt="Cork Shelters e Tendas Glamping no Alentejo" 
        class="w-full h-full object-cover opacity-50 scale-105"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/25 to-black/40"></div>
    </div>

    <!-- Centro do Hero: Apenas o Nome da Página Centrado -->
    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center my-auto">
      <h1 class="font-catamaran font-extrabold text-3xl sm:text-5xl md:text-6xl uppercase tracking-wider text-white drop-shadow-[0_4px_20px_rgba(0,0,0,0.6)]">
        Alojamentos
      </h1>
    </div>
  </section>

  <!-- =========================================================================
       NAVEGAÇÃO RÁPIDA ENTRE CATEGORIAS
       ========================================================================= -->
  <div class="bg-sand-warm border-b border-sand-border py-3.5">
    <div class="max-w-7xl mx-auto px-4 flex justify-center items-center gap-4 sm:gap-8 font-montserrat text-xs sm:text-sm font-semibold uppercase tracking-wider">
      <a href="#cork-shelters" class="text-charcoal hover:text-natureGold flex items-center gap-2 transition-colors py-1 border-b-2 border-transparent hover:border-natureGold">
        <span class="w-2.5 h-2.5 rounded-full bg-natureGold"></span>
        Cork Shelters (10)
      </a>
      <a href="#glamping-tents" class="text-charcoal hover:text-natureGold flex items-center gap-2 transition-colors py-1 border-b-2 border-transparent hover:border-natureGold">
        <span class="w-2.5 h-2.5 rounded-full bg-charcoal"></span>
        Tendas Glamping (13)
      </a>
      <a href="#tabela-comparativa" class="hidden md:flex text-charcoal hover:text-natureGold items-center gap-2 transition-colors py-1 border-b-2 border-transparent hover:border-natureGold">
        <svg class="w-4 h-4 text-natureGold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
        Comparador & Comodidades
      </a>
    </div>
  </div>

  <!-- =========================================================================
       1. CORK SHELTERS
       ========================================================================= -->
  <section id="cork-shelters" class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 border-b border-sand-border pb-6">
        <div>
          <h2 class="font-catamaran font-extrabold text-2xl sm:text-3xl md:text-4xl uppercase tracking-wide text-charcoal">
            Cork Shelters — Revestimento em Cortiça
          </h2>
        </div>
        <p class="mt-4 md:mt-0 font-catamaran text-charcoal-muted text-sm max-w-md">
          A cortiça alentejana garante conforto térmico e acústico de topo, preservando a harmonia com o montado e as vinhas da propriedade.
        </p>
      </div>

      <div class="space-y-16">
        {corkShelters.map((item, idx) => (
          <div class={`grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center ${idx % 2 === 1 ? 'lg:flex-row-reverse' : ''}`}>
            
            <!-- Imagem e Galeria Interativa -->
            <div class={`lg:col-span-7 accom-gallery-wrapper ${idx % 2 === 1 ? 'lg:order-2' : ''}`} data-accom-gallery={item.id}>
              <!-- Imagem Principal Superior (Clicável para Zoom) -->
              <div 
                class="main-image-container relative overflow-hidden shadow-soft group cursor-zoom-in border border-sand-border"
                title="Clique na imagem para ampliar"
                data-gallery={JSON.stringify(item.gallery)}
                data-accom-id={item.id}
              >
                <img 
                  id={`main-img-${item.id}`}
                  src={item.image} 
                  alt={item.name} 
                  class="accom-main-img w-full h-80 sm:h-96 md:h-[420px] object-cover transition-all duration-300 group-hover:scale-105"
                  loading="lazy"
                />
                <span class="absolute bottom-4 right-4 bg-white/95 text-charcoal font-montserrat text-xs font-semibold px-3 py-1 rounded-full shadow-sm pointer-events-none">
                  {item.capacityLabel}
                </span>

                <!-- Ícone de Zoom ao passar o rato -->
                <div class="absolute top-4 right-4 bg-charcoal/70 backdrop-blur-sm text-natureGold p-2 rounded-full opacity-0 group-hover:opacity-100 transition-opacity shadow-md pointer-events-none flex items-center justify-center">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
                  </svg>
                </div>
              </div>

              <!-- Miniaturas / Galeria Inferior (Carregar aqui muda a imagem de cima, sem abrir zoom) -->
              {item.gallery && item.gallery.length > 1 && (
                <div class="grid grid-cols-4 gap-2 sm:gap-3 mt-3">
                  {item.gallery.map((thumb, tIdx) => (
                    <button 
                      type="button"
                      class={`thumb-btn aspect-[16/10] w-full overflow-hidden border-2 transition-all cursor-pointer relative ${
                        tIdx === 0 ? 'border-natureGold ring-2 ring-natureGold/40 opacity-100' : 'border-sand-border opacity-70 hover:opacity-100'
                      }`}
                      data-target-main={`main-img-${item.id}`}
                      data-img-src={thumb}
                      data-index={tIdx}
                      aria-label={`Ver imagem ${tIdx + 1} de ${item.name}`}
                    >
                      <img src={thumb} alt={`${item.name} vista ${tIdx + 1}`} class="w-full h-full object-cover pointer-events-none" loading="lazy" />
                    </button>
                  ))}
                </div>
              )}
            </div>

            <!-- Ficha Técnica e Descrição -->
            <div class={`lg:col-span-5 space-y-6 ${idx % 2 === 1 ? 'lg:order-1' : ''}`}>
              <div>
                <h3 class="font-catamaran font-extrabold text-2xl sm:text-3xl uppercase tracking-wide text-charcoal">
                  {item.name}
                </h3>
                <p class="font-catamaran text-charcoal-muted text-sm mt-2 font-medium">
                  {item.subtitle}
                </p>
              </div>

              <p class="font-catamaran text-charcoal text-sm leading-relaxed">
                {item.description}
              </p>

              <!-- Especificações -->
              <div class="bg-sand-warm rounded-xl p-4 border border-sand-border space-y-2.5 font-montserrat text-xs text-charcoal">
                <div class="flex items-center gap-2.5">
                  <svg class="w-4 h-4 text-natureGold shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
                  <span><strong>Configuração:</strong> {item.features.beds}</span>
                </div>
                <div class="flex items-center gap-2.5">
                  <svg class="w-4 h-4 text-natureGold shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                  <span><strong>Casa de Banho:</strong> {item.features.wc}</span>
                </div>
                <div class="flex items-center gap-2.5">
                  <svg class="w-4 h-4 text-natureGold shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                  <span><strong>Enquadramento:</strong> {item.features.view}</span>
                </div>
              </div>

              <!-- Comodidades -->
              <div>
                <h4 class="text-xs font-bold font-montserrat uppercase tracking-wider text-charcoal mb-3">Comodidades Incluídas</h4>
                <div class="flex flex-wrap gap-2">
                  {item.amenities.map(amenity => (
                    <span class="inline-flex items-center gap-1.5 text-xs font-montserrat bg-white px-3 py-1 rounded-md border border-sand-border text-charcoal-muted">
                      <span class="w-1.5 h-1.5 rounded-full bg-natureGold"></span>
                      {amenity}
                    </span>
                  ))}
                </div>
              </div>

              <!-- CTA de Reserva -->
              <div class="pt-2 flex items-center gap-4">
                <a 
                  href={`/reservar?tipologia=${item.id}`}
                  class="flex-1 text-center font-montserrat text-xs font-bold uppercase tracking-widest py-3.5 px-6 rounded-xl bg-natureGold hover:bg-natureGold-light text-charcoal-dark shadow-md hover:shadow-[0_0_20px_rgba(184,142,74,0.4)] transition-all hover:scale-[1.01]"
                >
                  Reservar {item.name}
                </a>
              </div>

            </div>

          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- =========================================================================
       2. TENDAS GLAMPING
       ========================================================================= -->
  <section id="glamping-tents" class="py-16 md:py-24 bg-sand-warm border-t border-sand-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 border-b border-sand-border pb-6">
        <div>
          <h2 class="font-catamaran font-extrabold text-2xl sm:text-3xl md:text-4xl uppercase tracking-wide text-charcoal">
            Tendas Glamping — Sob o Céu Estrelado
          </h2>
        </div>
        <p class="mt-4 md:mt-0 font-catamaran text-charcoal-muted text-sm max-w-md">
          A fusão inesquecível entre a liberdade da vida no campo e a comodidade dos melhores quartos de hotel. Todas com WC privativo e ar condicionado.
        </p>
      </div>

      <div class="space-y-16">
        {glampingTents.map((item, idx) => (
          <div class={`grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center ${idx % 2 === 1 ? 'lg:flex-row-reverse' : ''}`}>
            
            <!-- Imagem e Galeria Interativa -->
            <div class={`lg:col-span-7 accom-gallery-wrapper ${idx % 2 === 1 ? 'lg:order-2' : ''}`} data-accom-gallery={item.id}>
              <!-- Imagem Principal Superior (Clicável para Zoom) -->
              <div 
                class="main-image-container relative overflow-hidden shadow-soft group cursor-zoom-in border border-sand-border"
                title="Clique na imagem para ampliar"
                data-gallery={JSON.stringify(item.gallery)}
                data-accom-id={item.id}
              >
                <img 
                  id={`main-img-${item.id}`}
                  src={item.image} 
                  alt={item.name} 
                  class="accom-main-img w-full h-80 sm:h-96 md:h-[420px] object-cover transition-all duration-300 group-hover:scale-105"
                  loading="lazy"
                />
                <span class="absolute bottom-4 right-4 bg-white/95 text-charcoal font-montserrat text-xs font-semibold px-3 py-1 rounded-full shadow-sm pointer-events-none">
                  {item.capacityLabel}
                </span>

                <!-- Ícone de Zoom ao passar o rato -->
                <div class="absolute top-4 right-4 bg-charcoal/70 backdrop-blur-sm text-natureGold p-2 rounded-full opacity-0 group-hover:opacity-100 transition-opacity shadow-md pointer-events-none flex items-center justify-center">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
                  </svg>
                </div>
              </div>

              <!-- Miniaturas / Galeria Inferior (Carregar aqui muda a imagem de cima, sem abrir zoom) -->
              {item.gallery && item.gallery.length > 1 && (
                <div class="grid grid-cols-4 gap-2 sm:gap-3 mt-3">
                  {item.gallery.map((thumb, tIdx) => (
                    <button 
                      type="button"
                      class={`thumb-btn aspect-[16/10] w-full overflow-hidden border-2 transition-all cursor-pointer relative ${
                        tIdx === 0 ? 'border-natureGold ring-2 ring-natureGold/40 opacity-100' : 'border-sand-border opacity-70 hover:opacity-100'
                      }`}
                      data-target-main={`main-img-${item.id}`}
                      data-img-src={thumb}
                      data-index={tIdx}
                      aria-label={`Ver imagem ${tIdx + 1} de ${item.name}`}
                    >
                      <img src={thumb} alt={`${item.name} vista ${tIdx + 1}`} class="w-full h-full object-cover pointer-events-none" loading="lazy" />
                    </button>
                  ))}
                </div>
              )}
            </div>

            <!-- Ficha Técnica e Descrição -->
            <div class={`lg:col-span-5 space-y-6 ${idx % 2 === 1 ? 'lg:order-1' : ''}`}>
              <div>
                <h3 class="font-catamaran font-extrabold text-2xl sm:text-3xl uppercase tracking-wide text-charcoal">
                  {item.name}
                </h3>
                <p class="font-catamaran text-charcoal-muted text-sm mt-2 font-medium">
                  {item.subtitle}
                </p>
              </div>

              <p class="font-catamaran text-charcoal text-sm leading-relaxed">
                {item.description}
              </p>

              <!-- Especificações -->
              <div class="bg-white rounded-xl p-4 border border-sand-border space-y-2.5 font-montserrat text-xs text-charcoal">
                <div class="flex items-center gap-2.5">
                  <svg class="w-4 h-4 text-natureGold shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
                  <span><strong>Configuração:</strong> {item.features.beds}</span>
                </div>
                <div class="flex items-center gap-2.5">
                  <svg class="w-4 h-4 text-natureGold shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                  <span><strong>Casa de Banho:</strong> {item.features.wc}</span>
                </div>
                <div class="flex items-center gap-2.5">
                  <svg class="w-4 h-4 text-natureGold shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                  <span><strong>Enquadramento:</strong> {item.features.view}</span>
                </div>
              </div>

              <!-- Comodidades -->
              <div>
                <h4 class="text-xs font-bold font-montserrat uppercase tracking-wider text-charcoal mb-3">Comodidades Incluídas</h4>
                <div class="flex flex-wrap gap-2">
                  {item.amenities.map(amenity => (
                    <span class="inline-flex items-center gap-1.5 text-xs font-montserrat bg-sand-warm px-3 py-1 rounded-md border border-sand-border text-charcoal-muted">
                      <span class="w-1.5 h-1.5 rounded-full bg-natureGold"></span>
                      {amenity}
                    </span>
                  ))}
                </div>
              </div>

              <!-- CTA de Reserva -->
              <div class="pt-2 flex items-center gap-4">
                <a 
                  href={`/reservar?tipologia=${item.id}`}
                  class="flex-1 text-center font-montserrat text-xs font-bold uppercase tracking-widest py-3.5 px-6 rounded-xl bg-natureGold hover:bg-natureGold-light text-charcoal-dark shadow-md hover:shadow-[0_0_20px_rgba(184,142,74,0.4)] transition-all hover:scale-[1.01]"
                >
                  Reservar {item.name}
                </a>
              </div>

            </div>

          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- =========================================================================
       3. TABELA COMPARATIVA RÁPIDA (SEM POLUIÇÃO VISUAL)
       ========================================================================= -->
  <section id="tabela-comparativa" class="py-16 md:py-24 bg-white border-t border-sand-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-xs font-bold font-montserrat uppercase tracking-widest text-natureGold-dark block mb-2">
          Escolha Ideal para a Sua Viagem
        </span>
        <h2 class="font-catamaran font-extrabold text-2xl sm:text-3xl uppercase tracking-wide text-charcoal">
          Quadro Comparativo de Tipologias
        </h2>
        <p class="font-catamaran text-charcoal-muted text-sm mt-2">
          Compare facilmente a capacidade, as características e a atmosfera de cada espaço.
        </p>
      </div>

      <div class="overflow-x-auto rounded-xl border border-sand-border shadow-soft">
        <table class="w-full text-left font-montserrat text-xs sm:text-sm">
          <thead class="bg-sand-warm text-charcoal uppercase tracking-wider font-bold border-b border-sand-border">
            <tr>
              <th class="py-4 px-6">Tipologia</th>
              <th class="py-4 px-4">Capacidade</th>
              <th class="py-4 px-4">Tipo de Camas</th>
              <th class="py-4 px-4">Comodidades Exclusivas</th>
              <th class="py-4 px-6 text-right"><span class="sr-only">Reservar</span></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-sand-border bg-white text-charcoal font-medium">
            {ACCOMMODATIONS.map(acc => {
              const info = COMPARISON_DATA[acc.id] || { amenities: acc.amenities.slice(0, 3).join(', ') };
              return (
                <tr class="hover:bg-sand-warm/50 transition-colors">
                  <td class="py-4 px-6 font-bold text-charcoal flex items-center gap-2">
                    <span class={`w-2 h-2 rounded-full ${acc.category === 'cork-shelter' ? 'bg-natureGold' : 'bg-charcoal'}`}></span>
                    {acc.name}
                  </td>
                  <td class="py-4 px-4 text-charcoal-muted">{acc.capacityLabel}</td>
                  <td class="py-4 px-4 text-charcoal-muted">{acc.features.beds}</td>
                  <td class="py-4 px-4 text-charcoal-muted font-normal">{info.amenities}</td>
                  <td class="py-4 px-6 text-right whitespace-nowrap">
                    <a 
                      href={`/reservar?tipologia=${acc.id}`}
                      class="inline-flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider text-charcoal-dark bg-natureGold hover:bg-natureGold-light px-3.5 py-1.5 rounded-lg shadow-sm hover:shadow-[0_0_15px_rgba(184,142,74,0.4)] transition-all"
                    >
                      <span>Reservar</span>
                      <span>&rarr;</span>
                    </a>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

    </div>
  </section>


  <!-- =========================================================================
       MODAL DE FOTO EXPANDIDA (ZOOM LIGHTBOX COM SETAS DE NAVEGAÇÃO)
       ========================================================================= -->
  <div 
    id="gallery-modal" 
    class="fixed inset-0 z-50 bg-charcoal/95 backdrop-blur-md hidden flex items-center justify-center p-4 select-none"
  >
    <div id="modal-content-container" class="relative max-w-5xl max-h-[92vh] bg-charcoal overflow-hidden shadow-2xl p-2 border border-white/10 flex items-center justify-center">
      
      <!-- Botão Fechar -->
      <button 
        type="button" 
        id="btn-close-gallery-modal"
        class="absolute top-4 right-4 z-20 bg-black/70 hover:bg-natureGold text-white hover:text-charcoal-dark rounded-full w-10 h-10 flex items-center justify-center transition-colors shadow-lg cursor-pointer"
        aria-label="Fechar ampliação"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <!-- Seta Esquerda (Anterior) -->
      <button 
        type="button" 
        id="btn-prev-gallery-modal"
        class="absolute left-3 sm:left-5 top-1/2 -translate-y-1/2 z-20 bg-black/75 hover:bg-natureGold text-white hover:text-charcoal-dark rounded-full w-11 h-11 sm:w-12 sm:h-12 flex items-center justify-center transition-all shadow-xl cursor-pointer hover:scale-105 active:scale-95 border border-white/10"
        aria-label="Imagem anterior"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <!-- Seta Direita (Seguinte) -->
      <button 
        type="button" 
        id="btn-next-gallery-modal"
        class="absolute right-3 sm:right-5 top-1/2 -translate-y-1/2 z-20 bg-black/75 hover:bg-natureGold text-white hover:text-charcoal-dark rounded-full w-11 h-11 sm:w-12 sm:h-12 flex items-center justify-center transition-all shadow-xl cursor-pointer hover:scale-105 active:scale-95 border border-white/10"
        aria-label="Próxima imagem"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      <!-- Imagem Ampliada -->
      <img id="modal-gallery-img" src="" alt="Imagem ampliada" class="max-h-[82vh] w-auto max-w-full object-contain mx-auto shadow-luxury transition-opacity duration-150" />

      <!-- Indicador Numérico de Fotos -->
      <div id="modal-gallery-counter" class="absolute bottom-4 left-1/2 -translate-x-1/2 z-20 bg-black/75 backdrop-blur-xs text-white/90 font-montserrat text-xs font-semibold px-3.5 py-1 rounded-full border border-white/10 shadow-md">
        1 / 4
      </div>
    </div>
  </div>

  <script>
    const modal = document.getElementById('gallery-modal');
    const modalImg = document.getElementById('modal-gallery-img') as HTMLImageElement | null;
    const modalContent = document.getElementById('modal-content-container');
    const closeBtn = document.getElementById('btn-close-gallery-modal');
    const prevBtn = document.getElementById('btn-prev-gallery-modal');
    const nextBtn = document.getElementById('btn-next-gallery-modal');
    const counterEl = document.getElementById('modal-gallery-counter');

    let currentGalleryList: string[] = [];
    let currentGalleryIndex = 0;
    let currentTargetMainId: string | null = null;
    let currentWrapper: HTMLElement | null = null;

    function updateModalImage(idx: number, animate = true) {
      if (!modalImg || currentGalleryList.length === 0) return;
      currentGalleryIndex = (idx + currentGalleryList.length) % currentGalleryList.length;
      const newSrc = currentGalleryList[currentGalleryIndex];

      if (animate) {
        modalImg.style.opacity = '0.3';
        setTimeout(() => {
          if (modalImg) {
            modalImg.src = newSrc;
            modalImg.style.opacity = '1';
          }
        }, 100);
      } else {
        modalImg.src = newSrc;
        modalImg.style.opacity = '1';
      }

      if (counterEl) {
        counterEl.textContent = `${currentGalleryIndex + 1} / ${currentGalleryList.length}`;
      }

      // Sincronizar imagem principal do cartão
      if (currentTargetMainId) {
        const cardImg = document.getElementById(currentTargetMainId) as HTMLImageElement | null;
        if (cardImg) {
          cardImg.src = newSrc;
        }
      }

      // Sincronizar contorno da miniatura ativa no cartão
      if (currentWrapper) {
        const thumbs = currentWrapper.querySelectorAll<HTMLButtonElement>('.thumb-btn');
        thumbs.forEach((thumb, tIdx) => {
          if (tIdx === currentGalleryIndex) {
            thumb.classList.remove('border-sand-border', 'opacity-70');
            thumb.classList.add('border-natureGold', 'ring-2', 'ring-natureGold/40', 'opacity-100');
          } else {
            thumb.classList.remove('border-natureGold', 'ring-2', 'ring-natureGold/40', 'opacity-100');
            thumb.classList.add('border-sand-border', 'opacity-70');
          }
        });
      }
    }

    function showPrev() {
      updateModalImage(currentGalleryIndex - 1);
    }

    function showNext() {
      updateModalImage(currentGalleryIndex + 1);
    }

    prevBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      showPrev();
    });

    nextBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      showNext();
    });

    // Fechar modal
    modal?.addEventListener('click', () => modal.classList.add('hidden'));
    modalContent?.addEventListener('click', (e) => e.stopPropagation());
    closeBtn?.addEventListener('click', () => modal?.classList.add('hidden'));

    // Teclado: Escape para fechar, Setas para navegar
    document.addEventListener('keydown', (e) => {
      if (!modal || modal.classList.contains('hidden')) return;
      if (e.key === 'Escape') {
        modal.classList.add('hidden');
      } else if (e.key === 'ArrowLeft') {
        showPrev();
      } else if (e.key === 'ArrowRight') {
        showNext();
      }
    });

    // 1. Clique nas miniaturas inferiores:
    // Troca a imagem de cima SEM abrir o modal de zoom
    const thumbButtons = document.querySelectorAll<HTMLButtonElement>('.thumb-btn');
    thumbButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();

        const targetId = btn.getAttribute('data-target-main');
        const newSrc = btn.getAttribute('data-img-src');
        if (!targetId || !newSrc) return;

        const mainImg = document.getElementById(targetId) as HTMLImageElement | null;
        if (mainImg) {
          mainImg.style.opacity = '0.4';
          setTimeout(() => {
            mainImg.src = newSrc;
            mainImg.style.opacity = '1';
          }, 120);
        }

        // Atualizar estado ativo da miniatura no grupo atual
        const parentGallery = btn.closest('.accom-gallery-wrapper');
        if (parentGallery) {
          parentGallery.querySelectorAll<HTMLButtonElement>('.thumb-btn').forEach(b => {
            b.classList.remove('border-natureGold', 'ring-2', 'ring-natureGold/40', 'opacity-100');
            b.classList.add('border-sand-border', 'opacity-70');
          });
          btn.classList.remove('border-sand-border', 'opacity-70');
          btn.classList.add('border-natureGold', 'ring-2', 'ring-natureGold/40', 'opacity-100');
        }
      });
    });

    // 2. Clique na imagem de cima:
    // Só ao carregar na imagem superior é que o zoom (modal) é acionado!
    const mainImageContainers = document.querySelectorAll<HTMLElement>('.main-image-container');
    mainImageContainers.forEach(container => {
      container.addEventListener('click', () => {
        const accomId = container.getAttribute('data-accom-id');
        const galleryRaw = container.getAttribute('data-gallery');
        const img = container.querySelector<HTMLImageElement>('.accom-main-img');
        if (!img || !modal || !modalImg) return;

        currentTargetMainId = accomId ? `main-img-${accomId}` : null;
        currentWrapper = container.closest<HTMLElement>('.accom-gallery-wrapper');

        try {
          currentGalleryList = galleryRaw ? JSON.parse(galleryRaw) : [img.src];
        } catch {
          currentGalleryList = [img.src];
        }

        // Encontrar índice atual baseado no src da imagem visível
        const foundIdx = currentGalleryList.findIndex(src => img.src.includes(src) || src.includes(img.src));
        currentGalleryIndex = foundIdx !== -1 ? foundIdx : 0;

        updateModalImage(currentGalleryIndex, false);
        modal.classList.remove('hidden');
      });
    });
  </script>

</BaseLayout>
