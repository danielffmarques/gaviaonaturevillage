  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // 0. Dados Padrão de Demonstração (123456789)
      const DEMO_DATA = {
        name: 'Utilizador Teste (123456789)',
        email: 'teste123456789@gaviaonaturevillage.com',
        phone: '123456789',
        nif: '123456789',
        country: 'PT',
        notes: 'Reserva de teste de demonstração oficial (123456789).',
        cardNumber: '1234 5678 9123 4567',
        cardHolder: 'UTILIZADOR TESTE 123456789',
        cardExpiry: '12/28',
        cardCvv: '123',
        mbwayPhone: '123456789'
      };

      // Notificação Toast Visual Flutuante
      const demoToast = document.getElementById('demo-toast');
      const demoToastMsg = document.getElementById('demo-toast-msg');
      let toastTimer: any = null;

      const showDemoToast = (msg: string) => {
        if (!demoToast || !demoToastMsg) return;
        demoToastMsg.textContent = msg;
        demoToast.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-3');
        demoToast.classList.add('opacity-100', 'translate-y-0');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => {
          demoToast.classList.remove('opacity-100', 'translate-y-0');
          demoToast.classList.add('opacity-0', 'pointer-events-none', 'translate-y-3');
        }, 3500);
      };

      // 1. Estado Central da Reserva
      const state = {
        step: 1,
        checkin: '',
        checkout: '',
        nights: 2,
        accommodationId: 'cork-shelter-standard',
        accommodationName: 'Cork Shelter Standard',
        accommodationPrice: 120,
        accommodationImage: '/images/alojamentos/media_10_Gavi_o.jpg',
        accommodationCapacity: 'Até 2 Pessoas',
        adults: 2,
        children: 0,
        extrasTotal: 0,
        grandTotal: 240,
        guest: {
          name: '',
          email: '',
          phone: '',
          nif: '',
          country: 'PT',
          notes: ''
        },
        payment: {
          method: 'credit_card',
          cardNumber: '',
          cardHolder: '',
          cardExpiry: '',
          cardCvv: '',
          mbwayPhone: ''
        },
        confirmationCode: 'GNV-123456789'
      };

      // 2. Elementos DOM
      const checkinInput = document.getElementById('step-checkin') as HTMLInputElement | null;
      const checkoutInput = document.getElementById('step-checkout') as HTMLInputElement | null;
      const adultsSelect = document.getElementById('step-adults') as HTMLSelectElement | null;
      const childrenSelect = document.getElementById('step-children') as HTMLSelectElement | null;
      const extraCheckboxes = document.querySelectorAll<HTMLInputElement>('#extra-breakfast, #extra-spa, #extra-bike, #extra-wine');
      const accomRadios = document.querySelectorAll<HTMLInputElement>('input[name="accommodation_radio"]');

      const guestNameInput = document.getElementById('guest-name') as HTMLInputElement | null;
      const guestEmailInput = document.getElementById('guest-email') as HTMLInputElement | null;
      const guestPhoneInput = document.getElementById('guest-phone') as HTMLInputElement | null;
      const guestNifInput = document.getElementById('guest-nif') as HTMLInputElement | null;
      const guestCountrySelect = document.getElementById('guest-country') as HTMLSelectElement | null;
      const guestNotesInput = document.getElementById('guest-notes') as HTMLTextAreaElement | null;

      const cardNumberInput = document.getElementById('card-number') as HTMLInputElement | null;
      const cardHolderInput = document.getElementById('card-holder') as HTMLInputElement | null;
      const cardExpiryInput = document.getElementById('card-expiry') as HTMLInputElement | null;
      const cardCvvInput = document.getElementById('card-cvv') as HTMLInputElement | null;
      const mbwayPhoneInput = document.getElementById('mbway-phone') as HTMLInputElement | null;

      const quickFillBtn = document.getElementById('btn-quick-fill');
      const instantTestBtn = document.getElementById('btn-instant-test');
      const newReservationBtn = document.getElementById('btn-new-reservation');

      // 3. Inicialização de Datas & Parâmetros URL
      const today = new Date();
      const tomorrow = new Date(today);
      tomorrow.setDate(today.getDate() + 1);
      const afterTomorrow = new Date(today);
      afterTomorrow.setDate(today.getDate() + 3);

      const fmtDate = (d: Date) => d.toISOString().split('T')[0];

      const urlParams = new URLSearchParams(window.location.search);
      const qCheckin = urlParams.get('checkin') || urlParams.get('check_in');
      const qCheckout = urlParams.get('checkout') || urlParams.get('check_out');
      const qAdults = urlParams.get('adults') || urlParams.get('guests');
      const qChildren = urlParams.get('children');
      const qTipologia = urlParams.get('tipologia') || urlParams.get('alojamento');
      const qPerfil = urlParams.get('perfil');

      if (checkinInput && checkoutInput) {
        checkinInput.value = qCheckin || fmtDate(tomorrow);
        checkoutInput.value = qCheckout || fmtDate(afterTomorrow);
        checkinInput.min = fmtDate(today);
        checkoutInput.min = fmtDate(tomorrow);

        state.checkin = checkinInput.value;
        state.checkout = checkoutInput.value;

        checkinInput.addEventListener('change', () => {
          const nextDay = new Date(checkinInput.value);
          nextDay.setDate(nextDay.getDate() + 1);
          checkoutInput.min = fmtDate(nextDay);
          if (new Date(checkoutInput.value) <= new Date(checkinInput.value)) {
            checkoutInput.value = fmtDate(nextDay);
          }
          state.checkin = checkinInput.value;
          state.checkout = checkoutInput.value;
          recalculateNightsAndPricing();
        });

        checkoutInput.addEventListener('change', () => {
          state.checkout = checkoutInput.value;
          recalculateNightsAndPricing();
        });
      }

      // Parâmetro de Adultos e Crianças
      if (adultsSelect && qAdults) {
        if (qAdults === 'fam') adultsSelect.value = '4';
        else if (qAdults === 'group') adultsSelect.value = '6';
        else if (['1', '2', '3', '4', '6', '8'].includes(qAdults)) adultsSelect.value = qAdults;
        state.adults = parseInt(adultsSelect.value) || 2;
      }
      if (childrenSelect && qChildren && ['0', '1', '2', '3'].includes(qChildren)) {
        childrenSelect.value = qChildren;
        state.children = parseInt(qChildren) || 0;
      }

      // Parâmetro de Perfil (casais, familias, bem-estar, aventura)
      if (qPerfil) {
        if (qPerfil === 'casais') {
          state.accommodationId = 'cork-shelter-standard';
        } else if (qPerfil === 'familias') {
          state.accommodationId = 'cork-shelter-familiar';
          if (adultsSelect) { adultsSelect.value = '2'; state.adults = 2; }
          if (childrenSelect) { childrenSelect.value = '2'; state.children = 2; }
        } else if (qPerfil === 'bem-estar') {
          state.accommodationId = 'cork-shelter-superior';
          const spaCb = document.getElementById('extra-spa') as HTMLInputElement | null;
          if (spaCb) spaCb.checked = true;
        } else if (qPerfil === 'aventura') {
          state.accommodationId = 'tenda-glamping-amigos';
          const bikeCb = document.getElementById('extra-bike') as HTMLInputElement | null;
          if (bikeCb) bikeCb.checked = true;
        }
      }

      // Parâmetro de Tipologia explícito
      if (qTipologia) {
        state.accommodationId = qTipologia;
      }

      // Seleção visual da Tipologia
      let matchedRadio = false;
      accomRadios.forEach(radio => {
        if (radio.value === state.accommodationId) {
          radio.checked = true;
          matchedRadio = true;
        }
      });
      if (!matchedRadio && accomRadios.length > 0) {
        accomRadios[0].checked = true;
      }

      const updateAccomCardsUI = () => {
        accomRadios.forEach(radio => {
          const card = radio.closest('.accom-radio-card');
          const dot = card?.querySelector('.radio-dot');
          if (radio.checked) {
            card?.classList.add('border-natureGold', 'bg-white', 'shadow-soft', 'ring-2', 'ring-natureGold/40');
            card?.classList.remove('border-sand-border', 'bg-sand-warm/40');
            dot?.classList.remove('hidden');

            state.accommodationId = radio.value;
            state.accommodationName = radio.getAttribute('data-name') || radio.value;
            state.accommodationPrice = parseFloat(radio.getAttribute('data-price') || '120');
            state.accommodationImage = radio.getAttribute('data-image') || '';
            state.accommodationCapacity = radio.getAttribute('data-capacity') || '';
          } else {
            card?.classList.remove('border-natureGold', 'bg-white', 'shadow-soft', 'ring-2', 'ring-natureGold/40');
            card?.classList.add('border-sand-border', 'bg-sand-warm/40');
            dot?.classList.add('hidden');
          }
        });
        recalculateNightsAndPricing();
      };

      accomRadios.forEach(radio => {
        radio.addEventListener('change', updateAccomCardsUI);
      });
      updateAccomCardsUI();

      // Listeners de Adultos, Crianças e Extras
      adultsSelect?.addEventListener('change', () => {
        state.adults = parseInt(adultsSelect.value) || 2;
        recalculateNightsAndPricing();
      });

      childrenSelect?.addEventListener('change', () => {
        state.children = parseInt(childrenSelect.value) || 0;
        recalculateNightsAndPricing();
      });

      extraCheckboxes.forEach(cb => {
        cb.addEventListener('change', recalculateNightsAndPricing);
      });

      // 4. Cálculo Dinâmico de Noites e Preço
      function recalculateNightsAndPricing() {
        if (!state.checkin || !state.checkout) return;
        const d1 = new Date(state.checkin);
        const d2 = new Date(state.checkout);
        const diffTime = Math.abs(d2.getTime() - d1.getTime());
        const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
        state.nights = diffDays > 0 ? diffDays : 1;

        let extras = 0;
        extraCheckboxes.forEach(cb => {
          if (cb.checked) {
            const price = parseFloat(cb.getAttribute('data-price') || '0');
            if (cb.id === 'extra-breakfast') {
              extras += price * state.adults * state.nights;
            } else {
              extras += price;
            }
          }
        });
        state.extrasTotal = extras;

        const stayTotal = state.nights * state.accommodationPrice;
        state.grandTotal = stayTotal + state.extrasTotal;

        // Atualizar painel lateral
        const summaryNightsBadge = document.getElementById('summary-nights-badge');
        const summaryAccomImg = document.getElementById('summary-accom-img') as HTMLImageElement | null;
        const summaryAccomTitle = document.getElementById('summary-accom-title');
        const summaryAccomCap = document.getElementById('summary-accom-capacity');
        const summaryCheckin = document.getElementById('summary-checkin');
        const summaryCheckout = document.getElementById('summary-checkout');
        const summaryGuests = document.getElementById('summary-guests');
        const summaryCalcLine = document.getElementById('summary-calc-line');
        const summaryStayTotal = document.getElementById('summary-stay-total');
        const summaryExtrasTotal = document.getElementById('summary-extras-total');
        const summaryGrandTotal = document.getElementById('summary-grand-total');

        if (summaryNightsBadge) summaryNightsBadge.textContent = `${state.nights} ${state.nights === 1 ? 'Noite' : 'Noites'}`;
        if (summaryAccomImg && state.accommodationImage) summaryAccomImg.src = state.accommodationImage;
        if (summaryAccomTitle) summaryAccomTitle.textContent = state.accommodationName;
        if (summaryAccomCap) summaryAccomCap.textContent = state.accommodationCapacity;
        if (summaryCheckin) summaryCheckin.textContent = state.checkin;
        if (summaryCheckout) summaryCheckout.textContent = state.checkout;
        if (summaryGuests) summaryGuests.textContent = `${state.adults} Adultos${state.children > 0 ? `, ${state.children} Crianças` : ''}`;
        if (summaryCalcLine) summaryCalcLine.textContent = `${state.nights} ${state.nights === 1 ? 'Noite' : 'Noites'} × ${state.accommodationPrice}€`;
        if (summaryStayTotal) summaryStayTotal.textContent = `${stayTotal.toFixed(2)} €`;
        if (summaryExtrasTotal) summaryExtrasTotal.textContent = `${state.extrasTotal.toFixed(2)} €`;
        if (summaryGrandTotal) summaryGrandTotal.textContent = `${state.grandTotal.toFixed(2)} €`;
      }

      recalculateNightsAndPricing();

      // 5. Navegação entre os Passos (Stepper)
      const panels = [
        document.getElementById('step-panel-1'),
        document.getElementById('step-panel-2'),
        document.getElementById('step-panel-3'),
        document.getElementById('step-panel-4')
      ];

      const indicators = document.querySelectorAll<HTMLElement>('.step-indicator');
      const progressBar = document.getElementById('stepper-progress-bar');

      const goToStep = (stepNumber: number) => {
        state.step = stepNumber;

        // Se saltar para os passos 2, 3 ou 4 e os dados de hóspede estiverem vazios, preencher padrão 123456789
        if (stepNumber >= 2 && (!state.guest.name || !guestNameInput?.value)) {
          applyDemoGuestData(false);
        }
        if (stepNumber >= 3 && (!state.payment.cardNumber || !cardNumberInput?.value)) {
          applyDemoPaymentData(false);
        }
        if (stepNumber === 4) {
          populateConfirmationScreen();
        }

        // Mostrar o painel correto
        panels.forEach((p, idx) => {
          if (idx + 1 === stepNumber) {
            p?.classList.remove('hidden');
          } else {
            p?.classList.add('hidden');
          }
        });

        // Atualizar Stepper Indicator
        indicators.forEach((ind) => {
          const s = parseInt(ind.getAttribute('data-step') || '1');
          const circle = ind.querySelector('.step-circle');
          const label = ind.querySelector('.step-label');

          if (s < stepNumber) {
            // Concluído
            circle?.classList.remove('bg-white', 'border-2', 'border-sand-border', 'text-charcoal-muted', 'ring-4');
            circle?.classList.add('bg-natureGold', 'text-charcoal-dark');
            if (circle) circle.innerHTML = '✓';
            label?.classList.remove('text-charcoal-muted');
            label?.classList.add('text-charcoal', 'font-bold');
          } else if (s === stepNumber) {
            // Ativo
            circle?.classList.remove('bg-white', 'border-2', 'border-sand-border', 'text-charcoal-muted');
            circle?.classList.add('bg-natureGold', 'text-charcoal-dark', 'ring-4', 'ring-natureGold/20');
            if (circle) circle.innerHTML = s === 4 ? '✓' : `${s}`;
            label?.classList.remove('text-charcoal-muted');
            label?.classList.add('text-charcoal', 'font-bold');
          } else {
            // Pendente mas agora clicável
            circle?.classList.remove('bg-natureGold', 'text-charcoal-dark', 'ring-4', 'ring-natureGold/20');
            circle?.classList.add('bg-white', 'border-2', 'border-sand-border', 'text-charcoal-muted');
            if (circle) circle.innerHTML = s === 4 ? '✓' : `${s}`;
            label?.classList.remove('text-charcoal', 'font-bold');
            label?.classList.add('text-charcoal-muted');
          }
        });

        // Barra de progresso percentual
        if (progressBar) {
          const widths = ['12.5%', '37.5%', '62.5%', '100%'];
          progressBar.style.width = widths[stepNumber - 1];
        }

        // Scroll suave para o topo do formulário
        document.getElementById('booking-stepper')?.scrollIntoView({ behavior: 'smooth' });
      };

      // Permitir clicar em QUALQUER passo do stepper a qualquer momento
      indicators.forEach(ind => {
        ind.addEventListener('click', () => {
          const target = parseInt(ind.getAttribute('data-step') || '1');
          goToStep(target);
        });
      });

      // 6. Preenchimento e Aplicação dos Dados de Demonstração (123456789)
      const applyDemoGuestData = (highlight = true) => {
        if (guestNameInput) guestNameInput.value = DEMO_DATA.name;
        if (guestEmailInput) guestEmailInput.value = DEMO_DATA.email;
        if (guestPhoneInput) guestPhoneInput.value = DEMO_DATA.phone;
        if (guestNifInput) guestNifInput.value = DEMO_DATA.nif;
        if (guestCountrySelect) guestCountrySelect.value = DEMO_DATA.country;
        if (guestNotesInput && !guestNotesInput.value) guestNotesInput.value = DEMO_DATA.notes;

        state.guest.name = DEMO_DATA.name;
        state.guest.email = DEMO_DATA.email;
        state.guest.phone = DEMO_DATA.phone;
        state.guest.nif = DEMO_DATA.nif;
        state.guest.country = DEMO_DATA.country;
        state.guest.notes = DEMO_DATA.notes;

        if (highlight) {
          [guestNameInput, guestEmailInput, guestPhoneInput, guestNifInput].forEach(el => {
            el?.classList.add('ring-2', 'ring-natureGold/60', 'border-natureGold');
            setTimeout(() => el?.classList.remove('ring-2', 'ring-natureGold/60'), 2000);
          });
        }
      };

      const applyDemoPaymentData = (highlight = true) => {
        if (cardNumberInput) cardNumberInput.value = DEMO_DATA.cardNumber;
        if (cardHolderInput) cardHolderInput.value = DEMO_DATA.cardHolder;
        if (cardExpiryInput) cardExpiryInput.value = DEMO_DATA.cardExpiry;
        if (cardCvvInput) cardCvvInput.value = DEMO_DATA.cardCvv;
        if (mbwayPhoneInput) mbwayPhoneInput.value = DEMO_DATA.mbwayPhone;

        state.payment.cardNumber = DEMO_DATA.cardNumber;
        state.payment.cardHolder = DEMO_DATA.cardHolder;
        state.payment.cardExpiry = DEMO_DATA.cardExpiry;
        state.payment.cardCvv = DEMO_DATA.cardCvv;
        state.payment.mbwayPhone = DEMO_DATA.mbwayPhone;

        if (highlight) {
          [cardNumberInput, cardHolderInput, cardExpiryInput, cardCvvInput, mbwayPhoneInput].forEach(el => {
            el?.classList.add('ring-2', 'ring-natureGold/60', 'border-natureGold');
            setTimeout(() => el?.classList.remove('ring-2', 'ring-natureGold/60'), 2000);
          });
        }
      };

      const fillAllDemoData = (highlight = true) => {
        applyDemoGuestData(highlight);
        applyDemoPaymentData(highlight);
        state.confirmationCode = 'GNV-123456789';
      };

      // Detetar o número '123456789' em QUALQUER campo quando o utilizador escreve
      const allFormInputs = [
        guestNameInput,
        guestEmailInput,
        guestPhoneInput,
        guestNifInput,
        cardNumberInput,
        cardHolderInput,
        cardExpiryInput,
        cardCvvInput,
        mbwayPhoneInput
      ];

      allFormInputs.forEach(input => {
        if (!input) return;
        const checkDemoValue = () => {
          const val = input.value.trim();
          if (val === '123456789' || val.includes('123456789')) {
            fillAllDemoData(true);
            showDemoToast('✓ Modo 123456789 detetado! Todos os campos preenchidos com sucesso.');
          }
        };
        input.addEventListener('input', checkDemoValue);
        input.addEventListener('change', checkDemoValue);
      });

      // 7. Botão 1: "Preencher Campos (123456789)"
      quickFillBtn?.addEventListener('click', () => {
        fillAllDemoData(true);
        showDemoToast('✓ Dados 123456789 preenchidos em todos os passos!');
        
        // Se estiver no Passo 1, avançar suavemente para o Passo 2 para ver os campos
        if (state.step === 1) {
          setTimeout(() => goToStep(2), 250);
        }
      });

      // 8. Botão 2: "Teste Instantâneo (123456789) →"
      instantTestBtn?.addEventListener('click', () => {
        fillAllDemoData(false);
        showDemoToast('⚡ Simulação Instantânea Concluída (123456789)!');
        goToStep(4);
      });

      // 9. Preenchimento dos dados do Passo 4 (Confirmação Oficial)
      function populateConfirmationScreen() {
        if (!state.guest.name) state.guest.name = DEMO_DATA.name;
        if (!state.guest.email) state.guest.email = DEMO_DATA.email;
        state.confirmationCode = 'GNV-123456789';

        const codeEl = document.getElementById('confirmation-code');
        const confAccom = document.getElementById('conf-accom-name');
        const confDates = document.getElementById('conf-dates');
        const confGuest = document.getElementById('conf-guest-name');
        const confTotal = document.getElementById('conf-total-price');

        if (codeEl) codeEl.textContent = state.confirmationCode;
        if (confAccom) confAccom.textContent = state.accommodationName;
        if (confDates) confDates.textContent = `${state.checkin} até ${state.checkout} (${state.nights} noites)`;
        if (confGuest) confGuest.textContent = `${state.guest.name} · ${state.guest.email}`;
        if (confTotal) confTotal.textContent = `${state.grandTotal.toFixed(2)} €`;
      }

      // 10. Botões de Navegação dos Passos
      // Passo 1 -> Passo 2
      document.getElementById('btn-goto-step-2')?.addEventListener('click', () => {
        goToStep(2);
      });

      // Passo 2 -> Passo 1
      document.getElementById('btn-backto-step-1')?.addEventListener('click', () => {
        goToStep(1);
      });

      // Passo 2 -> Passo 3
      document.getElementById('btn-goto-step-3')?.addEventListener('click', () => {
        // Se campos estiverem vazios ou tiverem 123456789, auto-completar sem bloqueio
        const n = guestNameInput?.value.trim();
        const e = guestEmailInput?.value.trim();
        const p = guestPhoneInput?.value.trim();
        const nf = guestNifInput?.value.trim();

        if (!n || n === '123456789') guestNameInput!.value = DEMO_DATA.name;
        if (!e || e === '123456789') guestEmailInput!.value = DEMO_DATA.email;
        if (!p || p === '123456789') guestPhoneInput!.value = DEMO_DATA.phone;
        if (!nf || nf === '123456789') guestNifInput!.value = DEMO_DATA.nif;

        state.guest.name = guestNameInput?.value || DEMO_DATA.name;
        state.guest.email = guestEmailInput?.value || DEMO_DATA.email;
        state.guest.phone = guestPhoneInput?.value || DEMO_DATA.phone;
        state.guest.nif = guestNifInput?.value || DEMO_DATA.nif;
        state.guest.country = guestCountrySelect?.value || 'PT';
        state.guest.notes = guestNotesInput?.value || '';

        goToStep(3);
      });

      // Passo 3 -> Passo 2
      document.getElementById('btn-backto-step-2')?.addEventListener('click', () => {
        goToStep(2);
      });

      // Seleção do Método de Pagamento
      const paymentRadios = document.querySelectorAll<HTMLInputElement>('input[name="payment_method"]');
      const paymentBoxes = {
        credit_card: document.getElementById('payment-fields-credit_card'),
        mbway: document.getElementById('payment-fields-mbway'),
        multibanco: document.getElementById('payment-fields-multibanco')
      };

      paymentRadios.forEach(radio => {
        radio.addEventListener('change', () => {
          document.querySelectorAll('.payment-method-card').forEach(c => {
            c.classList.remove('border-natureGold', 'bg-natureGold/10');
            c.classList.add('border-sand-border', 'bg-sand-warm/20');
          });
          const parent = radio.closest('.payment-method-card');
          parent?.classList.add('border-natureGold', 'bg-natureGold/10');
          parent?.classList.remove('border-sand-border', 'bg-sand-warm/20');

          Object.keys(paymentBoxes).forEach(key => {
            const box = paymentBoxes[key as keyof typeof paymentBoxes];
            if (key === radio.value) {
              box?.classList.remove('hidden');
            } else {
              box?.classList.add('hidden');
            }
          });
          state.payment.method = radio.value;
        });
      });

      // Passo 3 -> Passo 4 (Confirmar e Pagar)
      document.getElementById('btn-confirm-payment')?.addEventListener('click', () => {
        const confirmBtn = document.getElementById('btn-confirm-payment') as HTMLButtonElement | null;
        if (confirmBtn) {
          confirmBtn.disabled = true;
          confirmBtn.innerHTML = '⏳ A processar confirmação segura...';
        }

        // Se campos estiverem vazios no pagamento, preencher com padrão 123456789
        if (cardNumberInput && (!cardNumberInput.value || cardNumberInput.value === '123456789')) cardNumberInput.value = DEMO_DATA.cardNumber;
        if (cardHolderInput && (!cardHolderInput.value || cardHolderInput.value === '123456789')) cardHolderInput.value = DEMO_DATA.cardHolder;
        if (cardExpiryInput && (!cardExpiryInput.value || cardExpiryInput.value === '123456789')) cardExpiryInput.value = DEMO_DATA.cardExpiry;
        if (cardCvvInput && (!cardCvvInput.value || cardCvvInput.value === '123456789')) cardCvvInput.value = DEMO_DATA.cardCvv;
        if (mbwayPhoneInput && (!mbwayPhoneInput.value || mbwayPhoneInput.value === '123456789')) mbwayPhoneInput.value = DEMO_DATA.mbwayPhone;

        setTimeout(() => {
          if (confirmBtn) {
            confirmBtn.disabled = false;
            confirmBtn.innerHTML = '<svg class="w-4 h-4 text-charcoal-dark shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg><span>Confirmar e Pagar Reserva →</span>';
          }
          goToStep(4);
          showDemoToast('✓ Reserva confirmada com sucesso! Código GNV-123456789.');
        }, 500);
      });

      // 11. Botão "Nova Simulação" no Passo 4
      newReservationBtn?.addEventListener('click', () => {
        goToStep(1);
        showDemoToast('Novo processo de reserva iniciado.');
      });
    });
  </script>
</BaseLayout>
