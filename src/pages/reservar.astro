---
// src/pages/reservar.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { ACCOMMODATIONS } from '../utils/data';

---

<BaseLayout
  title="Reservar Estadia Oficial | Gavião Nature Village"
  description="Processo de reserva oficial do Gavião Nature Village em passos simples: datas, tipologia, dados do hóspede, pagamento seguro e confirmação imediata."
>
  <!-- Hero Compacto -->
  <section class="relative h-[28vh] min-h-[220px] md:h-[32vh] flex flex-col justify-center items-center bg-charcoal overflow-hidden text-white">
    <div class="absolute inset-0 z-0">
      <img 
        src="/images/hero/hero_village.webp" 
        alt="Gavião Nature Village Reserva" 
        class="w-full h-full object-cover opacity-45 scale-105"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/35 to-black/50"></div>
    </div>

    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center my-auto">
      <h1 class="font-catamaran font-extrabold text-3xl sm:text-4xl md:text-5xl uppercase tracking-wider text-white drop-shadow-[0_4px_20px_rgba(0,0,0,0.6)]">
        Reservar Estadia
      </h1>
      <p class="font-catamaran text-white/80 text-sm sm:text-base mt-2 max-w-xl mx-auto font-light">
        Reserve o seu refúgio na natureza em passos simples com confirmação imediata.
      </p>
    </div>
  </section>

  <!-- Processo de Reserva Multi-Passos -->
  <section class="py-10 md:py-16 bg-sand-warm min-h-[80vh]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Indicador Visual de Passos (Stepper) -->
      <div class="mb-10 max-w-3xl mx-auto" id="booking-stepper">
        <div class="grid grid-cols-4 relative">
          <!-- Linha de conexão de fundo -->
          <div class="absolute top-1/2 left-0 right-0 h-1 bg-sand-border -translate-y-1/2 z-0"></div>
          <div id="stepper-progress-bar" class="absolute top-1/2 left-0 h-1 bg-natureGold -translate-y-1/2 z-0 transition-all duration-500 w-[12.5%]"></div>

          <!-- Passo 1: Dados da Reserva -->
          <div class="step-indicator relative z-10 flex flex-col items-center text-center cursor-pointer" data-step="1">
            <div class="step-circle w-10 h-10 sm:w-12 sm:h-12 rounded-full flex items-center justify-center font-catamaran font-bold text-sm sm:text-base transition-all duration-300 shadow-sm bg-natureGold text-charcoal-dark ring-4 ring-natureGold/20">
              1
            </div>
            <span class="step-label font-montserrat font-bold text-[10px] sm:text-xs uppercase tracking-wider mt-2 text-charcoal">
              Reserva
            </span>
          </div>

          <!-- Passo 2: Dados do Hóspede -->
          <div class="step-indicator relative z-10 flex flex-col items-center text-center cursor-pointer" data-step="2">
            <div class="step-circle w-10 h-10 sm:w-12 sm:h-12 rounded-full flex items-center justify-center font-catamaran font-bold text-sm sm:text-base transition-all duration-300 shadow-sm bg-white text-charcoal-muted border-2 border-sand-border">
              2
            </div>
            <span class="step-label font-montserrat font-medium text-[10px] sm:text-xs uppercase tracking-wider mt-2 text-charcoal-muted">
              Hóspede
            </span>
          </div>

          <!-- Passo 3: Pagamento -->
          <div class="step-indicator relative z-10 flex flex-col items-center text-center cursor-pointer" data-step="3">
            <div class="step-circle w-10 h-10 sm:w-12 sm:h-12 rounded-full flex items-center justify-center font-catamaran font-bold text-sm sm:text-base transition-all duration-300 shadow-sm bg-white text-charcoal-muted border-2 border-sand-border">
              3
            </div>
            <span class="step-label font-montserrat font-medium text-[10px] sm:text-xs uppercase tracking-wider mt-2 text-charcoal-muted">
              Pagamento
            </span>
          </div>

          <!-- Passo 4: Confirmação -->
          <div class="step-indicator relative z-10 flex flex-col items-center text-center" data-step="4">
            <div class="step-circle w-10 h-10 sm:w-12 sm:h-12 rounded-full flex items-center justify-center font-catamaran font-bold text-sm sm:text-base transition-all duration-300 shadow-sm bg-white text-charcoal-muted border-2 border-sand-border">
              ✓
            </div>
            <span class="step-label font-montserrat font-medium text-[10px] sm:text-xs uppercase tracking-wider mt-2 text-charcoal-muted">
              Confirmação
            </span>
          </div>
        </div>
      </div>

      <!-- Barra de Atalho de Teste / Demonstração (123456789) -->
      <div class="mb-8 p-4 sm:p-5 rounded-2xl bg-white border-2 border-natureGold/60 shadow-luxury flex flex-col md:flex-row items-center justify-between gap-4 relative overflow-hidden">
        <div class="flex items-center gap-3.5">
          <div class="w-11 h-11 rounded-full bg-natureGold/20 border border-natureGold/50 flex items-center justify-center text-natureGold-dark text-xl shrink-0 shadow-sm">
            <svg class="w-5 h-5 text-natureGold-dark" fill="currentColor" viewBox="0 0 24 24"><path d="M7 2v11h3v9l7-12h-4l4-8H7z"/></svg>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="font-catamaran font-black text-sm sm:text-base text-charcoal uppercase tracking-wide block">
                Modo de Demonstração Disponível
              </span>
              <span class="bg-natureGold/20 text-charcoal-dark font-mono text-[10px] font-bold px-2 py-0.5 rounded-full border border-natureGold/40">
                123456789
              </span>
            </div>
            <p class="text-xs text-charcoal-muted font-catamaran mt-0.5">
              Pode preencher qualquer campo com o número <strong class="text-charcoal font-mono bg-sand-warm px-1.5 py-0.5 rounded border border-sand-border">123456789</strong> ou usar o botão para teste instantâneo.
            </p>
          </div>
        </div>
        <div class="flex flex-wrap sm:flex-nowrap items-center gap-2.5 w-full md:w-auto shrink-0 justify-end">
          <button 
            type="button" 
            id="btn-quick-fill"
            class="flex-1 sm:flex-none font-montserrat font-bold text-xs uppercase tracking-wider px-4 py-3 rounded-xl border border-sand-border hover:border-natureGold bg-sand-warm/60 hover:bg-sand-warm text-charcoal transition-all shadow-sm flex items-center justify-center gap-2 cursor-pointer text-center"
            title="Preenche todos os campos com 123456789 e avança passo a passo"
          >
            <svg class="w-3.5 h-3.5 text-natureGold-dark shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
            <span>Preencher Campos (123456789)</span>
          </button>
          <button 
            type="button" 
            id="btn-instant-test"
            class="flex-1 sm:flex-none font-montserrat font-bold text-xs uppercase tracking-wider px-5 py-3 rounded-xl bg-natureGold text-charcoal-dark hover:bg-natureGold-light transition-all shadow-md hover:shadow-luxury hover:scale-[1.02] flex items-center justify-center gap-2 cursor-pointer text-center"
            title="Conclui a simulação e mostra a confirmação oficial no Passo 4 instantaneamente"
          >
            <svg class="w-4 h-4 text-charcoal-dark shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M7 2v11h3v9l7-12h-4l4-8H7z"/></svg>
            <span>Teste Instantâneo (123456789) →</span>
          </button>
        </div>
      </div>

      <!-- Toast Flutuante de Feedback Demo -->
      <div 
        id="demo-toast" 
        class="fixed bottom-6 right-6 z-50 bg-charcoal text-white px-5 py-3.5 rounded-2xl shadow-2xl border border-natureGold/40 font-montserrat text-xs flex items-center gap-3 transition-all duration-300 opacity-0 pointer-events-none translate-y-3"
      >
        <div class="w-6 h-6 rounded-full bg-natureGold text-charcoal-dark flex items-center justify-center font-bold text-xs shrink-0">
          ✓
        </div>
        <span id="demo-toast-msg" class="font-medium">Modo Demonstração Ativado!</span>
      </div>

      <!-- Layout Principal: Formulário dos Passos + Resumo Lateral -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Coluna Esquerda: Conteúdo dos Passos (8 colunas) -->
        <div class="lg:col-span-8 bg-white border border-sand-border rounded-3xl p-6 sm:p-10 shadow-luxury">

          <!-- ===================================================================
               PASSO 1: DADOS DA RESERVA
               =================================================================== -->
          <div id="step-panel-1" class="step-panel space-y-8">
            <div class="border-b border-sand-border pb-4">
              <h2 class="font-catamaran font-extrabold text-2xl text-charcoal uppercase tracking-tight">
                1. Dados da Reserva
              </h2>
              <p class="text-charcoal-muted text-xs font-montserrat mt-1">
                Escolha o período da sua estadia, a tipologia de alojamento e o número de hóspedes.
              </p>
            </div>

            <!-- Seleção de Datas com Calendário Personalizado (Idêntico ao BookingBar / Website) -->
            <div class="relative">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="space-y-1.5">
                  <label for="step-checkin-btn" class="block text-xs uppercase tracking-widest text-charcoal font-montserrat font-bold">
                    Data de Entrada (Check-in)
                  </label>
                  <button 
                    type="button" 
                    id="step-checkin-btn"
                    class="w-full bg-sand-warm/50 hover:bg-white border border-sand-border focus:border-natureGold rounded-xl px-4 py-3 text-charcoal text-sm font-medium transition-all cursor-pointer flex items-center justify-between group shadow-xs text-left"
                  >
                    <div>
                      <span class="block text-[10px] uppercase font-montserrat font-bold text-natureGold-dark tracking-wider">Entrada</span>
                      <span id="step-checkin-display" class="font-montserrat font-semibold text-charcoal text-sm">--/--/----</span>
                    </div>
                    <svg class="w-5 h-5 text-natureGold group-hover:scale-110 transition-transform shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                  </button>
                  <input type="hidden" id="step-checkin" name="checkin" required />
                </div>

                <div class="space-y-1.5">
                  <label for="step-checkout-btn" class="block text-xs uppercase tracking-widest text-charcoal font-montserrat font-bold">
                    Data de Saída (Check-out)
                  </label>
                  <button 
                    type="button" 
                    id="step-checkout-btn"
                    class="w-full bg-sand-warm/50 hover:bg-white border border-sand-border focus:border-natureGold rounded-xl px-4 py-3 text-charcoal text-sm font-medium transition-all cursor-pointer flex items-center justify-between group shadow-xs text-left"
                  >
                    <div>
                      <span class="block text-[10px] uppercase font-montserrat font-bold text-natureGold-dark tracking-wider">Saída</span>
                      <span id="step-checkout-display" class="font-montserrat font-semibold text-charcoal text-sm">--/--/----</span>
                    </div>
                    <svg class="w-5 h-5 text-natureGold group-hover:scale-110 transition-transform shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                  </button>
                  <input type="hidden" id="step-checkout" name="checkout" required />
                </div>
              </div>

              <!-- Calendário Popover Idêntico ao BookingBar (Fundo Branco Sólido, Design GNV) -->
              <div 
                id="reservar-calendar-popover"
                class="hidden absolute z-50 left-0 top-full mt-2 w-[310px] sm:w-[340px] max-w-[calc(100vw-32px)] bg-white border border-[#DDD5C7] rounded-2xl shadow-[0_20px_50px_rgba(43,39,37,0.22)] p-4 text-charcoal animate-fadeIn"
              >
                <!-- Barra de Cabeçalho do Mês -->
                <div class="flex items-center justify-between pb-2.5 border-b border-[#E5DFD5] mb-2.5">
                  <button 
                    type="button" 
                    id="res-cal-prev"
                    class="w-7 h-7 flex items-center justify-center rounded-lg bg-[#F5F2EB] hover:bg-natureGold hover:text-charcoal transition-colors focus:outline-none cursor-pointer"
                    aria-label="Mês anterior"
                  >
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                  </button>

                  <span id="res-month-title" class="font-catamaran font-bold text-sm sm:text-base text-charcoal uppercase tracking-wider">
                    Outubro 2026
                  </span>

                  <button 
                    type="button" 
                    id="res-cal-next"
                    class="w-7 h-7 flex items-center justify-center rounded-lg bg-[#F5F2EB] hover:bg-natureGold hover:text-charcoal transition-colors focus:outline-none cursor-pointer"
                    aria-label="Mês seguinte"
                  >
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                  </button>
                </div>

                <!-- Instrução Dinâmica & Noites -->
                <div class="flex items-center justify-between mb-2.5 bg-[#F5F2EB] py-1 px-2.5 rounded-lg border border-[#E5DFD5] text-[10px] sm:text-[11px] font-montserrat">
                  <span id="res-cal-instruction" class="text-natureGold-dark font-bold">
                    1. Selecione a data de Check-in
                  </span>
                  <span id="res-cal-nights-badge" class="hidden bg-[#EAE2D5] text-charcoal font-bold px-2 py-0.5 rounded-full text-[10px]">
                    -- noites
                  </span>
                </div>

                <!-- Dias da Semana -->
                <div class="grid grid-cols-7 gap-1 text-center text-[9px] sm:text-[10px] font-montserrat font-bold text-charcoal-muted mb-1.5 uppercase">
                  <span>Seg</span><span>Ter</span><span>Qua</span><span>Qui</span><span>Sex</span><span>Sáb</span><span>Dom</span>
                </div>

                <!-- Grelha de Dias (1 Mês Único) -->
                <div id="res-days-grid" class="grid grid-cols-7 gap-1 text-center text-xs font-montserrat min-h-[190px]"></div>

                <!-- Rodapé com Ações Rápidas -->
                <div class="mt-2.5 pt-2.5 border-t border-sand-border flex items-center justify-between text-[11px] font-montserrat">
                  <button 
                    type="button" 
                    id="res-cal-today-btn"
                    class="text-charcoal-muted hover:text-natureGold-dark transition-colors text-[10px] cursor-pointer"
                  >
                    Hoje
                  </button>
                  <div class="flex items-center gap-2">
                    <button 
                      type="button" 
                      id="res-cal-reset-btn"
                      class="text-charcoal-muted hover:text-charcoal text-[10px] cursor-pointer"
                    >
                      Repor
                    </button>
                    <button 
                      type="button" 
                      id="res-cal-done-btn"
                      class="text-charcoal font-bold bg-natureGold hover:bg-natureGold-light px-3 py-1 rounded-md text-[10px] transition-all shadow-sm cursor-pointer"
                    >
                      Concluir
                    </button>
                  </div>
                </div>
              </div>
            </div>

            <!-- 1. Hóspedes (Adultos + Crianças) -->
            <div class="space-y-2">
              <label class="block text-xs uppercase tracking-widest text-charcoal font-montserrat font-bold">
                Hóspedes
              </label>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="space-y-1.5">
                  <label for="step-adults" class="block text-[11px] uppercase tracking-wider text-charcoal-muted font-montserrat font-semibold">
                    Adultos
                  </label>
                  <select 
                    id="step-adults" 
                    class="w-full bg-sand-warm/50 border border-sand-border rounded-xl px-4 py-3.5 text-charcoal text-sm focus:outline-none focus:border-natureGold transition-colors cursor-pointer"
                  >
                    <option value="1">1 Adulto</option>
                    <option value="2" selected>2 Adultos</option>
                    <option value="3">3 Adultos</option>
                    <option value="4">4 Adultos</option>
                    <option value="5">5 Adultos</option>
                    <option value="6">6 Adultos</option>
                    <option value="7">7 Adultos</option>
                    <option value="8">8 Adultos</option>
                  </select>
                </div>

                <div class="space-y-1.5">
                  <label for="step-children" class="block text-[11px] uppercase tracking-wider text-charcoal-muted font-montserrat font-semibold">
                    Crianças (0 aos 12 anos)
                  </label>
                  <select 
                    id="step-children" 
                    class="w-full bg-sand-warm/50 border border-sand-border rounded-xl px-4 py-3.5 text-charcoal text-sm focus:outline-none focus:border-natureGold transition-colors cursor-pointer"
                  >
                    <option value="0" selected>0 Crianças</option>
                    <option value="1">1 Criança</option>
                    <option value="2">2 Crianças</option>
                    <option value="3">3 Crianças</option>
                  </select>
                </div>
              </div>
            </div>

            <!-- 2. Alojamentos Disponíveis (Filtrados por Datas e Lotação de Hóspedes) -->
            <div class="space-y-3 pt-4 border-t border-sand-border" id="section-accommodations">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <div>
                  <label class="block text-xs uppercase tracking-widest text-charcoal font-montserrat font-bold">
                    Alojamentos Disponíveis
                  </label>
                  <p id="accom-filter-feedback" class="text-[11px] text-charcoal-muted font-montserrat mt-0.5">
                    A apresentar opções disponíveis para as suas datas e número de hóspedes:
                  </p>
                </div>
                <span id="accom-count-badge" class="text-[10px] font-montserrat font-bold text-natureGold-dark bg-natureGold/15 px-3 py-1 rounded-full uppercase tracking-wider self-start sm:self-auto">
                  6 Disponíveis
                </span>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="accom-grid-selection">
                {ACCOMMODATIONS.map(acc => {
                  return (
                    <label 
                      data-accom-radio={acc.id}
                      data-capacity-max={acc.capacityMax}
                      class="accom-radio-card p-3.5 rounded-2xl border border-sand-border hover:border-natureGold bg-sand-warm/40 hover:bg-white cursor-pointer transition-all duration-200 flex items-center gap-3.5"
                    >
                      <input 
                        type="radio" 
                        name="accommodation_radio" 
                        value={acc.id} 
                        data-name={acc.name}
                        data-image={acc.image}
                        data-capacity={acc.capacityLabel}
                        data-capacity-max={acc.capacityMax}
                        class="accent-natureGold sr-only"
                      />
                      <img 
                        src={acc.image} 
                        alt={acc.name} 
                        class="w-16 h-16 object-cover rounded-xl shrink-0 border border-sand-border"
                      />
                      <div class="min-w-0 flex-1">
                        <div class="font-catamaran font-bold text-sm text-charcoal truncate">
                          {acc.name}
                        </div>
                        <div class="text-[11px] text-charcoal-muted font-montserrat">
                          {acc.capacityLabel}
                        </div>
                        <div class="text-[11px] font-montserrat text-emerald-700 font-semibold mt-0.5 flex items-center gap-1.5">
                          <span class="w-2 h-2 rounded-full bg-emerald-500 shrink-0 inline-block"></span>
                          <span>Disponível para as suas datas</span>
                        </div>
                      </div>
                      <div class="radio-check w-5 h-5 rounded-full border-2 border-sand-border flex items-center justify-center shrink-0">
                        <div class="w-2.5 h-2.5 rounded-full bg-natureGold hidden radio-dot"></div>
                      </div>
                    </label>
                  );
                })}
              </div>

              <!-- Mensagem de alerta caso nenhum alojamento seja compatível com a lotação -->
              <div id="no-accom-alert" class="hidden p-5 rounded-2xl bg-amber-50 border border-amber-200 text-center space-y-1.5">
                <div class="font-catamaran font-bold text-sm text-amber-900">
                  Não existem alojamentos disponíveis para este número de hóspedes.
                </div>
                <p class="text-xs text-amber-800 font-montserrat">
                  A nossa lotação máxima por abrigo é de 8 hóspedes. Por favor reduza o número de hóspedes ou contacte-nos para reservar múltiplos abrigos.
                </p>
              </div>
            </div>

            <!-- 3. Escolha da Pensão (Regime Compacto, sem emojis) -->
            <div class="space-y-3 pt-4 border-t border-sand-border" id="section-regimes-estadia">
              <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2">
                <div>
                  <label class="block text-xs uppercase tracking-widest text-charcoal font-montserrat font-bold">
                    Regime de Pensão
                  </label>
                  <p class="text-[11px] text-charcoal-muted font-montserrat mt-0.5">
                    Escolha a opção de refeições pretendida:
                  </p>
                </div>
                <span class="text-[10px] font-montserrat font-bold text-natureGold-dark bg-natureGold/15 px-2.5 py-1 rounded-full uppercase tracking-wider self-start sm:self-auto">
                  Restaurante Cadafaz
                </span>
              </div>

              <!-- 3 Opções Compactas de Pensão (sem emojis, tamanho discreto e elegante) -->
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3" id="meal-plans-compact-selection">
                <!-- 1. APA -->
                <label class="meal-plan-card p-3.5 rounded-xl border border-natureGold bg-natureGold/10 cursor-pointer transition-all flex flex-col justify-between gap-2 shadow-xs" data-meal-key="apa">
                  <div class="flex items-center justify-between">
                    <span class="text-[10px] bg-charcoal text-white font-montserrat font-bold px-2 py-0.5 rounded">APA</span>
                    <div class="meal-radio-circle w-4 h-4 rounded-full border-2 border-sand-border flex items-center justify-center shrink-0">
                      <div class="meal-radio-dot w-2 h-2 rounded-full bg-natureGold"></div>
                    </div>
                  </div>
                  <div>
                    <div class="font-catamaran font-bold text-sm text-charcoal">Pequeno-Almoço</div>
                    <p class="text-[11px] text-charcoal-muted font-montserrat mt-0.5 leading-snug">Buffet continental regional</p>
                  </div>
                </label>

                <!-- 2. MP -->
                <label class="meal-plan-card p-3.5 rounded-xl border border-sand-border hover:border-natureGold bg-white cursor-pointer transition-all flex flex-col justify-between gap-2 shadow-xs" data-meal-key="mp">
                  <div class="flex items-center justify-between">
                    <span class="text-[10px] bg-natureGold text-charcoal-dark font-montserrat font-extrabold px-2 py-0.5 rounded">MP</span>
                    <div class="meal-radio-circle w-4 h-4 rounded-full border-2 border-sand-border flex items-center justify-center shrink-0">
                      <div class="meal-radio-dot w-2 h-2 rounded-full bg-natureGold hidden"></div>
                    </div>
                  </div>
                  <div>
                    <div class="font-catamaran font-bold text-sm text-charcoal">Meia Pensão</div>
