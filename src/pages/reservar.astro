---
// src/pages/reservar.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { ACCOMMODATIONS } from '../utils/data';

// Preços base de referência por noite para simulação completa
const ACCOM_PRICING: Record<string, number> = {
  'cork-shelter-standard': 120,
  'cork-shelter-superior': 155,
  'cork-shelter-familiar': 220,
  'tenda-amor-perfeito': 145,
  'tenda-glamping-familiar': 160,
  'tenda-glamping-amigos': 150,
};
---

<BaseLayout
  title="Reservar Estadia Oficial | Gavião Nature Village"
  description="Processo de reserva oficial do Gavião Nature Village em passos simples: datas, tipologia, dados do hóspede, pagamento seguro e confirmação imediata."
>
  <!-- Hero Compacto -->
  <section class="relative h-[28vh] min-h-[220px] md:h-[32vh] flex flex-col justify-center items-center bg-charcoal overflow-hidden text-white">
    <div class="absolute inset-0 z-0">
      <img 
        src="/images/hero/hero_village.webp" 
        alt="Gavião Nature Village Reserva" 
        class="w-full h-full object-cover opacity-45 scale-105"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/35 to-black/50"></div>
    </div>

    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center my-auto">
      <h1 class="font-catamaran font-extrabold text-3xl sm:text-4xl md:text-5xl uppercase tracking-wider text-white drop-shadow-[0_4px_20px_rgba(0,0,0,0.6)]">
        Reservar Estadia
      </h1>
      <p class="font-catamaran text-white/80 text-sm sm:text-base mt-2 max-w-xl mx-auto font-light">
        Reserve o seu refúgio na natureza em passos simples com confirmação imediata.
      </p>
    </div>
  </section>

  <!-- Processo de Reserva Multi-Passos -->
  <section class="py-10 md:py-16 bg-sand-warm min-h-[80vh]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Indicador Visual de Passos (Stepper) -->
      <div class="mb-10 max-w-3xl mx-auto" id="booking-stepper">
        <div class="grid grid-cols-4 relative">
          <!-- Linha de conexão de fundo -->
          <div class="absolute top-1/2 left-0 right-0 h-1 bg-sand-border -translate-y-1/2 z-0"></div>
          <div id="stepper-progress-bar" class="absolute top-1/2 left-0 h-1 bg-natureGold -translate-y-1/2 z-0 transition-all duration-500 w-[12.5%]"></div>

          <!-- Passo 1: Dados da Reserva -->
          <div class="step-indicator relative z-10 flex flex-col items-center text-center cursor-pointer" data-step="1">
            <div class="step-circle w-10 h-10 sm:w-12 sm:h-12 rounded-full flex items-center justify-center font-catamaran font-bold text-sm sm:text-base transition-all duration-300 shadow-sm bg-natureGold text-charcoal-dark ring-4 ring-natureGold/20">
              1
            </div>
            <span class="step-label font-montserrat font-bold text-[10px] sm:text-xs uppercase tracking-wider mt-2 text-charcoal">
              Reserva
            </span>
          </div>

          <!-- Passo 2: Dados do Hóspede -->
          <div class="step-indicator relative z-10 flex flex-col items-center text-center cursor-pointer" data-step="2">
            <div class="step-circle w-10 h-10 sm:w-12 sm:h-12 rounded-full flex items-center justify-center font-catamaran font-bold text-sm sm:text-base transition-all duration-300 shadow-sm bg-white text-charcoal-muted border-2 border-sand-border">
              2
            </div>
            <span class="step-label font-montserrat font-medium text-[10px] sm:text-xs uppercase tracking-wider mt-2 text-charcoal-muted">
              Hóspede
            </span>
          </div>

          <!-- Passo 3: Pagamento -->
          <div class="step-indicator relative z-10 flex flex-col items-center text-center cursor-pointer" data-step="3">
            <div class="step-circle w-10 h-10 sm:w-12 sm:h-12 rounded-full flex items-center justify-center font-catamaran font-bold text-sm sm:text-base transition-all duration-300 shadow-sm bg-white text-charcoal-muted border-2 border-sand-border">
              3
            </div>
            <span class="step-label font-montserrat font-medium text-[10px] sm:text-xs uppercase tracking-wider mt-2 text-charcoal-muted">
              Pagamento
            </span>
          </div>

          <!-- Passo 4: Confirmação -->
          <div class="step-indicator relative z-10 flex flex-col items-center text-center" data-step="4">
            <div class="step-circle w-10 h-10 sm:w-12 sm:h-12 rounded-full flex items-center justify-center font-catamaran font-bold text-sm sm:text-base transition-all duration-300 shadow-sm bg-white text-charcoal-muted border-2 border-sand-border">
              ✓
            </div>
            <span class="step-label font-montserrat font-medium text-[10px] sm:text-xs uppercase tracking-wider mt-2 text-charcoal-muted">
              Confirmação
            </span>
          </div>
        </div>
      </div>

      <!-- Barra de Atalho de Teste / Demonstração (123456789) -->
      <div class="mb-8 p-4 sm:p-5 rounded-2xl bg-white border-2 border-natureGold/60 shadow-luxury flex flex-col md:flex-row items-center justify-between gap-4 relative overflow-hidden">
        <div class="flex items-center gap-3.5">
          <div class="w-11 h-11 rounded-full bg-natureGold/20 border border-natureGold/50 flex items-center justify-center text-natureGold-dark text-xl shrink-0 shadow-sm">
            <svg class="w-5 h-5 text-natureGold-dark" fill="currentColor" viewBox="0 0 24 24"><path d="M7 2v11h3v9l7-12h-4l4-8H7z"/></svg>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="font-catamaran font-black text-sm sm:text-base text-charcoal uppercase tracking-wide block">
                Modo de Demonstração Disponível
              </span>
              <span class="bg-natureGold/20 text-charcoal-dark font-mono text-[10px] font-bold px-2 py-0.5 rounded-full border border-natureGold/40">
                123456789
              </span>
            </div>
            <p class="text-xs text-charcoal-muted font-catamaran mt-0.5">
              Pode preencher qualquer campo com o número <strong class="text-charcoal font-mono bg-sand-warm px-1.5 py-0.5 rounded border border-sand-border">123456789</strong> ou usar o botão para teste instantâneo.
            </p>
          </div>
        </div>
        <div class="flex flex-wrap sm:flex-nowrap items-center gap-2.5 w-full md:w-auto shrink-0 justify-end">
          <button 
            type="button" 
            id="btn-quick-fill"
            class="flex-1 sm:flex-none font-montserrat font-bold text-xs uppercase tracking-wider px-4 py-3 rounded-xl border border-sand-border hover:border-natureGold bg-sand-warm/60 hover:bg-sand-warm text-charcoal transition-all shadow-sm flex items-center justify-center gap-2 cursor-pointer text-center"
            title="Preenche todos os campos com 123456789 e avança passo a passo"
          >
            <svg class="w-3.5 h-3.5 text-natureGold-dark shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
            <span>Preencher Campos (123456789)</span>
          </button>
          <button 
            type="button" 
            id="btn-instant-test"
            class="flex-1 sm:flex-none font-montserrat font-bold text-xs uppercase tracking-wider px-5 py-3 rounded-xl bg-natureGold text-charcoal-dark hover:bg-natureGold-light transition-all shadow-md hover:shadow-luxury hover:scale-[1.02] flex items-center justify-center gap-2 cursor-pointer text-center"
            title="Conclui a simulação e mostra a confirmação oficial no Passo 4 instantaneamente"
          >
            <svg class="w-4 h-4 text-charcoal-dark shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M7 2v11h3v9l7-12h-4l4-8H7z"/></svg>
            <span>Teste Instantâneo (123456789) →</span>
          </button>
        </div>
      </div>

      <!-- Toast Flutuante de Feedback Demo -->
      <div 
        id="demo-toast" 
        class="fixed bottom-6 right-6 z-50 bg-charcoal text-white px-5 py-3.5 rounded-2xl shadow-2xl border border-natureGold/40 font-montserrat text-xs flex items-center gap-3 transition-all duration-300 opacity-0 pointer-events-none translate-y-3"
      >
        <div class="w-6 h-6 rounded-full bg-natureGold text-charcoal-dark flex items-center justify-center font-bold text-xs shrink-0">
          ✓
        </div>
        <span id="demo-toast-msg" class="font-medium">Modo Demonstração Ativado!</span>
      </div>

      <!-- Layout Principal: Formulário dos Passos + Resumo Lateral -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Coluna Esquerda: Conteúdo dos Passos (8 colunas) -->
        <div class="lg:col-span-8 bg-white border border-sand-border rounded-3xl p-6 sm:p-10 shadow-luxury">

          <!-- ===================================================================
               PASSO 1: DADOS DA RESERVA
               =================================================================== -->
          <div id="step-panel-1" class="step-panel space-y-8">
            <div class="border-b border-sand-border pb-4">
              <h2 class="font-catamaran font-extrabold text-2xl text-charcoal uppercase tracking-tight">
                1. Dados da Reserva
              </h2>
              <p class="text-charcoal-muted text-xs font-montserrat mt-1">
                Escolha o período da sua estadia, a tipologia de alojamento e o número de hóspedes.
              </p>
            </div>

            <!-- Seleção de Datas -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1.5">
                <label for="step-checkin" class="block text-xs uppercase tracking-widest text-charcoal font-montserrat font-bold">
                  Data de Chegada (Check-in)
                </label>
                <input 
                  type="date" 
                  id="step-checkin" 
                  name="checkin"
                  class="w-full bg-sand-warm/50 border border-sand-border rounded-xl px-4 py-3.5 text-charcoal text-sm font-medium focus:outline-none focus:border-natureGold transition-colors cursor-pointer"
                  required
                />
              </div>

              <div class="space-y-1.5">
                <label for="step-checkout" class="block text-xs uppercase tracking-widest text-charcoal font-montserrat font-bold">
                  Data de Saída (Check-out)
                </label>
                <input 
                  type="date" 
                  id="step-checkout" 
                  name="checkout"
                  class="w-full bg-sand-warm/50 border border-sand-border rounded-xl px-4 py-3.5 text-charcoal text-sm font-medium focus:outline-none focus:border-natureGold transition-colors cursor-pointer"
                  required
                />
              </div>
            </div>

            <!-- Tipologia de Alojamento com Previsão Visual -->
            <div class="space-y-2">
              <label for="step-accommodation" class="block text-xs uppercase tracking-widest text-charcoal font-montserrat font-bold">
                Tipologia de Alojamento
              </label>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="accom-grid-selection">
                {ACCOMMODATIONS.map(acc => {
                  const price = ACCOM_PRICING[acc.id] || 130;
                  return (
                    <label 
                      data-accom-radio={acc.id}
                      class="accom-radio-card p-3.5 rounded-2xl border border-sand-border hover:border-natureGold bg-sand-warm/40 hover:bg-white cursor-pointer transition-all duration-200 flex items-center gap-3.5"
                    >
                      <input 
                        type="radio" 
                        name="accommodation_radio" 
                        value={acc.id} 
                        data-name={acc.name}
                        data-price={price}
                        data-image={acc.image}
                        data-capacity={acc.capacityLabel}
                        class="accent-natureGold sr-only"
                      />
                      <img 
                        src={acc.image} 
                        alt={acc.name} 
                        class="w-16 h-16 object-cover shrink-0 border border-sand-border"
                      />
                      <div class="min-w-0 flex-1">
                        <div class="font-catamaran font-bold text-sm text-charcoal truncate">
                          {acc.name}
                        </div>
                        <div class="text-[11px] text-charcoal-muted font-montserrat">
                          {acc.capacityLabel}
                        </div>
                        <div class="text-xs font-montserrat font-bold text-natureGold-dark mt-0.5">
                          {price}€ <span class="text-[10px] text-charcoal-muted font-normal">/ noite</span>
                        </div>
                      </div>
                      <div class="radio-check w-5 h-5 rounded-full border-2 border-sand-border flex items-center justify-center shrink-0">
                        <div class="w-2.5 h-2.5 rounded-full bg-natureGold hidden radio-dot"></div>
                      </div>
                    </label>
                  );
                })}
              </div>
            </div>

            <!-- Hóspedes -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1.5">
                <label for="step-adults" class="block text-xs uppercase tracking-widest text-charcoal font-montserrat font-bold">
                  Adultos
                </label>
                <select 
                  id="step-adults" 
                  class="w-full bg-sand-warm/50 border border-sand-border rounded-xl px-4 py-3.5 text-charcoal text-sm focus:outline-none focus:border-natureGold transition-colors cursor-pointer"
                >
                  <option value="1">1 Adulto</option>
                  <option value="2" selected>2 Adultos</option>
                  <option value="3">3 Adultos</option>
                  <option value="4">4 Adultos</option>
                  <option value="6">6 Adultos</option>
                  <option value="8">8 Adultos</option>
                </select>
              </div>

              <div class="space-y-1.5">
                <label for="step-children" class="block text-xs uppercase tracking-widest text-charcoal font-montserrat font-bold">
                  Crianças (0 aos 12 anos)
                </label>
                <select 
                  id="step-children" 
                  class="w-full bg-sand-warm/50 border border-sand-border rounded-xl px-4 py-3.5 text-charcoal text-sm focus:outline-none focus:border-natureGold transition-colors cursor-pointer"
                >
                  <option value="0" selected>0 Crianças</option>
                  <option value="1">1 Criança</option>
                  <option value="2">2 Crianças</option>
                  <option value="3">3 Crianças</option>
                </select>
              </div>
            </div>

            <!-- Serviços Extras Opcionais -->
            <div class="space-y-3 pt-2 border-t border-sand-border">
              <label class="block text-xs uppercase tracking-widest text-charcoal font-montserrat font-bold">
                Experiências & Serviços Opcionais
              </label>
              
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <label class="flex items-center gap-3 p-3 rounded-xl border border-sand-border hover:border-natureGold bg-sand-warm/20 cursor-pointer">
                  <input type="checkbox" id="extra-breakfast" data-price="15" class="w-4 h-4 accent-natureGold rounded" />
                  <div class="text-xs font-montserrat">
                    <strong class="text-charcoal block">Pequeno-Almoço Regional</strong>
                    <span class="text-charcoal-muted">+15€ / pessoa / dia</span>
                  </div>
                </label>

                <label class="flex items-center gap-3 p-3 rounded-xl border border-sand-border hover:border-natureGold bg-sand-warm/20 cursor-pointer">
                  <input type="checkbox" id="extra-spa" data-price="80" class="w-4 h-4 accent-natureGold rounded" />
                  <div class="text-xs font-montserrat">
                    <strong class="text-charcoal block">Massagem Relaxante Duo</strong>
                    <span class="text-charcoal-muted">+80€ (sessão casal)</span>
                  </div>
                </label>

                <label class="flex items-center gap-3 p-3 rounded-xl border border-sand-border hover:border-natureGold bg-sand-warm/20 cursor-pointer">
                  <input type="checkbox" id="extra-bike" data-price="25" class="w-4 h-4 accent-natureGold rounded" />
                  <div class="text-xs font-montserrat">
                    <strong class="text-charcoal block">Aluguer de E-Bikes</strong>
                    <span class="text-charcoal-muted">+25€ / dia</span>
                  </div>
                </label>

                <label class="flex items-center gap-3 p-3 rounded-xl border border-sand-border hover:border-natureGold bg-sand-warm/20 cursor-pointer">
                  <input type="checkbox" id="extra-wine" data-price="30" class="w-4 h-4 accent-natureGold rounded" />
                  <div class="text-xs font-montserrat">
                    <strong class="text-charcoal block">Welcome Kit Alentejano</strong>
                    <span class="text-charcoal-muted">+30€ (vinho & queijo no quarto)</span>
                  </div>
                </label>
              </div>
            </div>

            <!-- Botão de Avanço do Passo 1 -->
            <div class="pt-6 border-t border-sand-border flex justify-end">
              <button 
                type="button" 
                id="btn-goto-step-2"
                class="w-full sm:w-auto font-montserrat font-bold text-xs uppercase tracking-widest px-8 py-4 rounded-xl bg-natureGold hover:bg-natureGold-light text-charcoal-dark shadow-md transition-all hover:scale-[1.02]"
              >
                Avançar para Dados do Hóspede →
              </button>
            </div>
          </div>

          <!-- ===================================================================
               PASSO 2: DADOS DO HÓSPEDE
               =================================================================== -->
          <div id="step-panel-2" class="step-panel space-y-6 hidden">
            <div class="border-b border-sand-border pb-4">
              <h2 class="font-catamaran font-extrabold text-2xl text-charcoal uppercase tracking-tight">
                2. Dados do Hóspede Principal
              </h2>
              <p class="text-charcoal-muted text-xs font-montserrat mt-1">
                Introduza os seus dados para emissão da confirmação de reserva.
              </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <!-- Nome Completo -->
              <div class="space-y-1.5 sm:col-span-2">
                <label for="guest-name" class="block text-xs uppercase tracking-widest text-charcoal font-montserrat font-bold">
                  Nome Completo *
                </label>
                <input 
                  type="text" 
                  id="guest-name" 
                  placeholder="ex: Maria Santos ou 123456789" 
                  class="w-full bg-sand-warm/50 border border-sand-border rounded-xl px-4 py-3.5 text-charcoal text-sm focus:outline-none focus:border-natureGold transition-colors"
                  required
                />
              </div>

              <!-- Email -->
              <div class="space-y-1.5">
                <label for="guest-email" class="block text-xs uppercase tracking-widest text-charcoal font-montserrat font-bold">
                  Correio Eletrónico (Email) *
                </label>
                <input 
                  type="text" 
                  id="guest-email" 
                  placeholder="ex: maria@exemplo.pt ou 123456789" 
                  class="w-full bg-sand-warm/50 border border-sand-border rounded-xl px-4 py-3.5 text-charcoal text-sm focus:outline-none focus:border-natureGold transition-colors"
                  required
                />
              </div>

              <!-- Telefone -->
              <div class="space-y-1.5">
                <label for="guest-phone" class="block text-xs uppercase tracking-widest text-charcoal font-montserrat font-bold">
                  Telemóvel / Telefone *
                </label>
                <input 
                  type="text" 
                  id="guest-phone" 
                  placeholder="ex: +351 912 345 678 ou 123456789" 
                  class="w-full bg-sand-warm/50 border border-sand-border rounded-xl px-4 py-3.5 text-charcoal text-sm focus:outline-none focus:border-natureGold transition-colors"
                  required
                />
              </div>

              <!-- NIF / Documento -->
              <div class="space-y-1.5">
                <label for="guest-nif" class="block text-xs uppercase tracking-widest text-charcoal font-montserrat font-bold">
                  NIF / N.º de Identificação *
                </label>
                <input 
                  type="text" 
                  id="guest-nif" 
                  placeholder="ex: 123456789" 
                  class="w-full bg-sand-warm/50 border border-sand-border rounded-xl px-4 py-3.5 text-charcoal text-sm focus:outline-none focus:border-natureGold transition-colors"
                  required
                />
              </div>

              <!-- País -->
              <div class="space-y-1.5">
                <label for="guest-country" class="block text-xs uppercase tracking-widest text-charcoal font-montserrat font-bold">
                  País de Residência
                </label>
                <select 
                  id="guest-country" 
                  class="w-full bg-sand-warm/50 border border-sand-border rounded-xl px-4 py-3.5 text-charcoal text-sm focus:outline-none focus:border-natureGold transition-colors cursor-pointer"
                >
                  <option value="PT" selected>Portugal</option>
                  <option value="ES">Espanha</option>
                  <option value="FR">França</option>
                  <option value="UK">Reino Unido</option>
                  <option value="DE">Alemanha</option>
                  <option value="BR">Brasil</option>
                  <option value="OTHER">Outro País</option>
                </select>
              </div>

              <!-- Observações -->
              <div class="space-y-1.5 sm:col-span-2">
                <label for="guest-notes" class="block text-xs uppercase tracking-widest text-charcoal font-montserrat font-bold">
                  Pedidos Especiais ou Observações (Opcional)
                </label>
                <textarea 
                  id="guest-notes" 
                  rows="3" 
                  placeholder="ex: Hora prevista de chegada, restrições alimentares ou berço para bebé..."
                  class="w-full bg-sand-warm/50 border border-sand-border rounded-xl px-4 py-3 text-charcoal text-sm focus:outline-none focus:border-natureGold transition-colors resize-none"
                ></textarea>
              </div>
            </div>

            <!-- Botões de Ação do Passo 2 -->
            <div class="pt-6 border-t border-sand-border flex flex-col sm:flex-row items-center justify-between gap-4">
              <button 
                type="button" 
                id="btn-backto-step-1"
                class="w-full sm:w-auto font-montserrat font-bold text-xs uppercase tracking-widest px-6 py-3.5 rounded-xl border border-sand-border hover:bg-sand-warm text-charcoal transition-all"
              >
                ← Voltar à Reserva
              </button>

              <button 
                type="button" 
                id="btn-goto-step-3"
                class="w-full sm:w-auto font-montserrat font-bold text-xs uppercase tracking-widest px-8 py-4 rounded-xl bg-natureGold hover:bg-natureGold-light text-charcoal-dark shadow-md transition-all hover:scale-[1.02]"
              >
                Avançar para Pagamento →
              </button>
            </div>
          </div>

          <!-- ===================================================================
               PASSO 3: PAGAMENTO
               =================================================================== -->
          <div id="step-panel-3" class="step-panel space-y-6 hidden">
            <div class="border-b border-sand-border pb-4">
              <h2 class="font-catamaran font-extrabold text-2xl text-charcoal uppercase tracking-tight">
                3. Modo de Pagamento
              </h2>
              <p class="text-charcoal-muted text-xs font-montserrat mt-1">
                Ambiente encriptado seguro com confirmação instantânea da estadia.
              </p>
            </div>

            <!-- Seleção do Método de Pagamento -->
            <div class="space-y-3">
              <label class="block text-xs uppercase tracking-widest text-charcoal font-montserrat font-bold">
                Selecione o Método de Pagamento
              </label>

              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <!-- Cartão de Crédito -->
                <label class="payment-method-card p-4 rounded-2xl border border-natureGold bg-natureGold/10 cursor-pointer flex flex-col items-center text-center gap-2 transition-all">
                  <input type="radio" name="payment_method" value="credit_card" checked class="sr-only" />
                  <svg class="w-7 h-7 text-natureGold" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/><path d="M6 14h2"/><path d="M10 14h4"/></svg>
                  <strong class="font-catamaran font-bold text-sm text-charcoal block">Cartão de Crédito</strong>
                  <span class="text-[10px] text-charcoal-muted font-montserrat">Visa, Mastercard</span>
                </label>

                <!-- MB WAY -->
