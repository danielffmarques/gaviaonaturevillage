          'cork-shelter-standard': 120,
          'cork-shelter-superior': 155,
          'cork-shelter-familiar': 220,
          'tenda-amor-perfeito': 145,
          'tenda-glamping-familiar': 160,
          'tenda-glamping-amigos': 150,
        } as Record<string, number>,

        // Suplementos diários por pessoa para os Regimes de Alimentação:
        mealPlans: {
          apa: {
            id: 'apa',
            code: 'APA',
            name: 'Pequeno-Almoço',
            fullName: 'Alojamento com Pequeno-Almoço (APA)',
            adultDailySupplement: 0,   // Base já inclui APA
            childDailySupplement: 0,
          },
          mp: {
            id: 'mp',
            code: 'MP',
            name: 'Meia Pensão',
            fullName: 'Meia Pensão (MP)',
            adultDailySupplement: 35,  // 35€ / adulto / noite
            childDailySupplement: 18,  // 18€ / criança / noite
          },
          pc: {
            id: 'pc',
            code: 'PC',
            name: 'Pensão Completa',
            fullName: 'Pensão Completa (PC)',
            adultDailySupplement: 65,  // 65€ / adulto / noite
            childDailySupplement: 32,  // 32€ / criança / noite
          }
        } as Record<string, { id: string; code: string; name: string; fullName: string; adultDailySupplement: number; childDailySupplement: number }>,

        // Desconto da Tarifa Não Reembolsável (em percentagem)
        nonRefundableDiscountPercent: 10,

        // Desconto Global de Campanha do Backoffice (0 = desligado; ex: 15 para 15% direto em tudo)
        globalCampaignDiscountPercent: 0,
        globalCampaignLabel: 'Campanha Especial Backoffice',

        // Códigos Promocionais / Vouchers criados pelo Backoffice:
        promoCodes: {
          'GAVIAO10': { percent: 10, label: 'Desconto de Boas-Vindas GNV (10%)' },
          'VERAO15': { percent: 15, label: 'Campanha de Verão Alto Alentejo (15%)' },
          'NATUREZA20': { percent: 20, label: 'Voucher Promocional Exclusivo (20%)' },
          'TESTE123': { percent: 12, label: 'Voucher de Demonstração (12%)' },
        } as Record<string, { percent: number; label: string }>
      };

      // 1. Estado Central da Reserva
      const state = {
        step: 1,
        checkin: '',
        checkout: '',
        nights: 2,
        accommodationId: 'cork-shelter-standard',
        accommodationName: 'Cork Shelter Standard',
        accommodationPrice: 120,
        accommodationImage: '/images/alojamentos/media_10_Gavi_o.jpg',
        accommodationCapacity: 'Até 2 Pessoas',
        adults: 2,
        children: 0,
        mealPlan: 'apa', // 'apa' | 'mp' | 'pc'
        cancellationPolicy: 'refundable', // 'refundable' | 'non_refundable'
        promoCode: '',
        promoDiscountPercent: 0,
        promoDiscountLabel: '',
        stayBaseTotal: 240,
        mealSupplementsTotal: 0,
        policyDiscountTotal: 0,
        promoDiscountTotal: 0,
        grandTotal: 240,
        guest: {
          name: '',
          email: '',
          phone: '',
          nif: '',
          country: 'PT',
          notes: ''
        },
        payment: {
          method: 'credit_card',
          cardNumber: '',
          cardHolder: '',
          cardExpiry: '',
          cardCvv: '',
          mbwayPhone: ''
        },
        confirmationCode: 'GNV-123456789'
      };

      // 2. Elementos DOM
      const checkinInput = document.getElementById('step-checkin') as HTMLInputElement | null;
      const checkoutInput = document.getElementById('step-checkout') as HTMLInputElement | null;
      const checkinBtn = document.getElementById('step-checkin-btn') as HTMLButtonElement | null;
      const checkoutBtn = document.getElementById('step-checkout-btn') as HTMLButtonElement | null;
      const checkinDisplay = document.getElementById('step-checkin-display') as HTMLSpanElement | null;
      const checkoutDisplay = document.getElementById('step-checkout-display') as HTMLSpanElement | null;

      const calPopover = document.getElementById('reservar-calendar-popover') as HTMLDivElement | null;
      const calInstruction = document.getElementById('res-cal-instruction') as HTMLSpanElement | null;
      const calNightsBadge = document.getElementById('res-cal-nights-badge') as HTMLSpanElement | null;
      const monthTitle = document.getElementById('res-month-title') as HTMLSpanElement | null;
      const daysGrid = document.getElementById('res-days-grid') as HTMLDivElement | null;

      const prevBtn = document.getElementById('res-cal-prev') as HTMLButtonElement | null;
      const nextBtn = document.getElementById('res-cal-next') as HTMLButtonElement | null;
      const todayBtn = document.getElementById('res-cal-today-btn') as HTMLButtonElement | null;
      const resetBtn = document.getElementById('res-cal-reset-btn') as HTMLButtonElement | null;
      const doneBtn = document.getElementById('res-cal-done-btn') as HTMLButtonElement | null;

      const adultsSelect = document.getElementById('step-adults') as HTMLSelectElement | null;
      const childrenSelect = document.getElementById('step-children') as HTMLSelectElement | null;
      const accomRadios = document.querySelectorAll<HTMLInputElement>('input[name="accommodation_radio"]');
      const mealPlanCards = document.querySelectorAll<HTMLLabelElement>('.meal-plan-card');
      const ratePolicyCards = document.querySelectorAll<HTMLLabelElement>('.rate-policy-card');
      const promoCodeInput = document.getElementById('promo-code-input') as HTMLInputElement | null;
      const btnApplyPromo = document.getElementById('btn-apply-promo') as HTMLButtonElement | null;
      const promoFeedback = document.getElementById('promo-feedback') as HTMLDivElement | null;
      const promoHint1 = document.getElementById('promo-code-hint');
      const promoHint2 = document.getElementById('promo-code-hint2');

      const guestNameInput = document.getElementById('guest-name') as HTMLInputElement | null;
      const guestEmailInput = document.getElementById('guest-email') as HTMLInputElement | null;
      const guestPhoneInput = document.getElementById('guest-phone') as HTMLInputElement | null;
      const guestNifInput = document.getElementById('guest-nif') as HTMLInputElement | null;
      const guestCountrySelect = document.getElementById('guest-country') as HTMLSelectElement | null;
      const guestNotesInput = document.getElementById('guest-notes') as HTMLTextAreaElement | null;

      const cardNumberInput = document.getElementById('card-number') as HTMLInputElement | null;
      const cardHolderInput = document.getElementById('card-holder') as HTMLInputElement | null;
      const cardExpiryInput = document.getElementById('card-expiry') as HTMLInputElement | null;
      const cardCvvInput = document.getElementById('card-cvv') as HTMLInputElement | null;
      const mbwayPhoneInput = document.getElementById('mbway-phone') as HTMLInputElement | null;

      const quickFillBtn = document.getElementById('btn-quick-fill');
      const instantTestBtn = document.getElementById('btn-instant-test');
      const newReservationBtn = document.getElementById('btn-new-reservation');

      // 3. Inicialização de Datas & Calendário Personalizado (Idêntico ao BookingBar)
      const monthNames = [
        'Janeiro', 'Fevereiro', 'Março', 'Abril', 'Maio', 'Junho',
        'Julho', 'Agosto', 'Setembro', 'Outubro', 'Novembro', 'Dezembro'
      ];

      const toYMD = (d: Date) => {
        const year = d.getFullYear();
        const month = String(d.getMonth() + 1).padStart(2, '0');
        const day = String(d.getDate()).padStart(2, '0');
        return `${year}-${month}-${day}`;
      };

      const toDisplay = (d: Date) => {
        const day = String(d.getDate()).padStart(2, '0');
        const month = String(d.getMonth() + 1).padStart(2, '0');
        const year = d.getFullYear();
        return `${day}/${month}/${year}`;
      };

      const normalize = (d: Date) => new Date(d.getFullYear(), d.getMonth(), d.getDate());

      const parseDateSafe = (val: string | null | undefined, fallback: Date): Date => {
        if (!val) return fallback;
        const parts = val.split('-');
        if (parts.length === 3) {
          const y = parseInt(parts[0]);
          const m = parseInt(parts[1]) - 1;
          const d = parseInt(parts[2]);
          if (!isNaN(y) && !isNaN(m) && !isNaN(d)) {
            return new Date(y, m, d);
          }
        }
        const parsed = new Date(val);
        return isNaN(parsed.getTime()) ? fallback : parsed;
      };

      const today = normalize(new Date());
      const defaultCheckin = new Date(today);
      defaultCheckin.setDate(today.getDate() + 1);
      const defaultCheckout = new Date(today);
      defaultCheckout.setDate(today.getDate() + 3);

      const urlParams = new URLSearchParams(window.location.search);
      const qCheckin = urlParams.get('checkin') || urlParams.get('check_in');
      const qCheckout = urlParams.get('checkout') || urlParams.get('check_out');
      const qAdults = urlParams.get('adults') || urlParams.get('guests');
      const qChildren = urlParams.get('children');
      const qTipologia = urlParams.get('tipologia') || urlParams.get('alojamento');
      const qPerfil = urlParams.get('perfil');

      let checkinDate: Date = parseDateSafe(qCheckin, defaultCheckin);
      let checkoutDate: Date = parseDateSafe(qCheckout, defaultCheckout);

      if (normalize(checkoutDate).getTime() <= normalize(checkinDate).getTime()) {
        checkoutDate = new Date(checkinDate);
        checkoutDate.setDate(checkinDate.getDate() + 2);
      }

      let viewYear = checkinDate.getFullYear();
      let viewMonth = checkinDate.getMonth();
      let mode: 'checkin' | 'checkout' = 'checkin';

      const updateInputsAndDisplays = () => {
        const ymdCheckin = toYMD(checkinDate);
        const ymdCheckout = toYMD(checkoutDate);

        if (checkinInput) checkinInput.value = ymdCheckin;
        if (checkoutInput) checkoutInput.value = ymdCheckout;

        state.checkin = ymdCheckin;
        state.checkout = ymdCheckout;

        if (checkinDisplay) checkinDisplay.textContent = toDisplay(checkinDate);
        if (checkoutDisplay) checkoutDisplay.textContent = toDisplay(checkoutDate);

        const diffTime = checkoutDate.getTime() - checkinDate.getTime();
        const nights = Math.max(1, Math.round(diffTime / (1000 * 60 * 60 * 24)));
        if (calNightsBadge) {
          calNightsBadge.textContent = nights === 1 ? '1 noite' : `${nights} noites`;
          calNightsBadge.classList.remove('hidden');
        }

        if (typeof filterAccommodations === 'function') {
          filterAccommodations();
        } else {
          recalculateNightsAndPricing();
        }
      };

      const updateTriggerHighlights = () => {
        if (!checkinBtn || !checkoutBtn) return;
        if (mode === 'checkin') {
          checkinBtn.classList.add('border-natureGold', 'ring-2', 'ring-natureGold/40', 'bg-white');
          checkoutBtn.classList.remove('border-natureGold', 'ring-2', 'ring-natureGold/40', 'bg-white');
        } else {
          checkoutBtn.classList.add('border-natureGold', 'ring-2', 'ring-natureGold/40', 'bg-white');
          checkinBtn.classList.remove('border-natureGold', 'ring-2', 'ring-natureGold/40', 'bg-white');
        }
      };

      const clearTriggerHighlights = () => {
        if (!checkinBtn || !checkoutBtn) return;
        checkinBtn.classList.remove('border-natureGold', 'ring-2', 'ring-natureGold/40', 'bg-white');
        checkoutBtn.classList.remove('border-natureGold', 'ring-2', 'ring-natureGold/40', 'bg-white');
      };

      const refreshDayStyles = () => {
        if (!calPopover) return;
        const checkinTime = normalize(checkinDate).getTime();
        const checkoutTime = normalize(checkoutDate).getTime();
        const todayTime = today.getTime();

        const allBtns = calPopover.querySelectorAll<HTMLButtonElement>('.res-day-btn');
        allBtns.forEach(btn => {
          const time = Number(btn.getAttribute('data-time'));

          if (time < todayTime) {
            btn.className = 'res-day-btn w-full h-7 sm:h-8 text-xs font-semibold flex items-center justify-center text-charcoal/25 cursor-not-allowed';
            btn.disabled = true;
            return;
          }

          btn.disabled = false;

          if (time === checkinTime || time === checkoutTime) {
            btn.className = 'res-day-btn w-full h-7 sm:h-8 text-xs flex items-center justify-center transition-all bg-natureGold text-charcoal font-bold rounded-lg shadow-sm scale-105 ring-2 ring-natureGold cursor-pointer';
          } else if (time > checkinTime && time < checkoutTime) {
            btn.className = 'res-day-btn w-full h-7 sm:h-8 text-xs flex items-center justify-center transition-all bg-[#F3EDE2] text-charcoal font-semibold rounded-none cursor-pointer';
          } else {
            btn.className = 'res-day-btn w-full h-7 sm:h-8 text-xs font-semibold flex items-center justify-center text-charcoal hover:bg-[#F5F2EB] hover:text-natureGold-dark rounded-lg cursor-pointer transition-colors';
          }
        });
      };

      const renderCalendar = () => {
        if (!monthTitle || !daysGrid || !calPopover) return;
        monthTitle.textContent = `${monthNames[viewMonth]} ${viewYear}`;
        daysGrid.innerHTML = '';

        const firstDay = new Date(viewYear, viewMonth, 1);
        const startingDay = (firstDay.getDay() + 6) % 7; // Seg = 0
        const daysCount = new Date(viewYear, viewMonth + 1, 0).getDate();

        for (let i = 0; i < startingDay; i++) {
          const empty = document.createElement('div');
          empty.className = 'w-full h-7 sm:h-8';
          daysGrid.appendChild(empty);
        }

        for (let day = 1; day <= daysCount; day++) {
          const d = new Date(viewYear, viewMonth, day);
          const normTime = normalize(d).getTime();

          const btn = document.createElement('button');
          btn.type = 'button';
          btn.textContent = String(day);
          btn.setAttribute('data-time', String(normTime));
          btn.setAttribute('data-date', toYMD(d));
          btn.className = 'res-day-btn w-full h-7 sm:h-8 text-xs font-semibold flex items-center justify-center rounded-lg transition-colors';

          btn.addEventListener('mouseenter', () => {
            if (mode === 'checkout') {
              const checkinTime = normalize(checkinDate).getTime();
              const hoverTime = normTime;
              const allBtns = calPopover.querySelectorAll<HTMLButtonElement>('.res-day-btn');
              allBtns.forEach(b => {
                const t = Number(b.getAttribute('data-time'));
                if (t > checkinTime && t <= hoverTime) {
                  b.classList.add('bg-[#F3EDE2]', 'text-charcoal');
                } else if (!(t > checkinTime && t < normalize(checkoutDate).getTime())) {
                  b.classList.remove('bg-[#F3EDE2]', 'text-charcoal');
                }
              });
            }
          });

          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const clickedDate = new Date(viewYear, viewMonth, day);
            const clickedTime = normTime;

            if (mode === 'checkin') {
              checkinDate = clickedDate;
              if (normalize(checkoutDate).getTime() <= clickedTime) {
                checkoutDate = new Date(clickedDate);
                checkoutDate.setDate(checkoutDate.getDate() + 1);
              }
              mode = 'checkout';
              if (calInstruction) calInstruction.textContent = '2. Selecione a data de Check-out';
              updateInputsAndDisplays();
              updateTriggerHighlights();
              refreshDayStyles();
            } else {
              const curCheckinTime = normalize(checkinDate).getTime();
              if (clickedTime <= curCheckinTime) {
                checkinDate = clickedDate;
                updateInputsAndDisplays();
                updateTriggerHighlights();
                refreshDayStyles();
              } else {
                checkoutDate = clickedDate;
                updateInputsAndDisplays();
                clearTriggerHighlights();
                refreshDayStyles();
                if (calInstruction) calInstruction.textContent = 'Estadia confirmada!';
                setTimeout(() => {
                  closeCalendar();
                }, 250);
              }
            }
          });

          daysGrid.appendChild(btn);
        }

        refreshDayStyles();
      };

      const openCalendar = (forMode: 'checkin' | 'checkout') => {
        if (!calPopover) return;
        mode = forMode;
        if (forMode === 'checkin') {
          viewYear = checkinDate.getFullYear();
          viewMonth = checkinDate.getMonth();
          if (calInstruction) calInstruction.textContent = '1. Selecione a data de Check-in';
          calPopover.style.left = '0';
          calPopover.style.right = 'auto';
        } else {
          viewYear = checkoutDate.getFullYear();
          viewMonth = checkoutDate.getMonth();
          if (calInstruction) calInstruction.textContent = '2. Selecione a data de Check-out';
          if (window.innerWidth >= 640) {
            calPopover.style.left = 'auto';
            calPopover.style.right = '0';
          } else {
            calPopover.style.left = '0';
            calPopover.style.right = 'auto';
          }
        }
        updateTriggerHighlights();
        calPopover.classList.remove('hidden');
        renderCalendar();
      };

      const closeCalendar = () => {
        if (!calPopover) return;
        calPopover.classList.add('hidden');
        clearTriggerHighlights();
      };

      checkinBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        if (calPopover && !calPopover.classList.contains('hidden') && mode === 'checkin') {
          closeCalendar();
        } else {
          openCalendar('checkin');
        }
      });

      checkoutBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        if (calPopover && !calPopover.classList.contains('hidden') && mode === 'checkout') {
          closeCalendar();
        } else {
          openCalendar('checkout');
        }
      });

      prevBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        viewMonth--;
        if (viewMonth < 0) {
          viewMonth = 11;
          viewYear--;
        }
        renderCalendar();
      });

      nextBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        viewMonth++;
        if (viewMonth > 11) {
          viewMonth = 0;
          viewYear++;
        }
        renderCalendar();
      });

      todayBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        viewYear = today.getFullYear();
        viewMonth = today.getMonth();
        renderCalendar();
      });

      resetBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        checkinDate = new Date(defaultCheckin);
        checkoutDate = new Date(defaultCheckout);
        mode = 'checkin';
        if (calInstruction) calInstruction.textContent = '1. Selecione a data de Check-in';
        updateInputsAndDisplays();
        updateTriggerHighlights();
        renderCalendar();
      });

      doneBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        closeCalendar();
      });

      document.addEventListener('click', (e) => {
        if (calPopover && !calPopover.classList.contains('hidden')) {
          const target = e.target as Node;
          if (!calPopover.contains(target) && !checkinBtn?.contains(target) && !checkoutBtn?.contains(target)) {
            closeCalendar();
          }
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && calPopover && !calPopover.classList.contains('hidden')) {
          closeCalendar();
        }
      });

      // Parâmetro de Adultos e Crianças
      if (adultsSelect && qAdults) {
        if (qAdults === 'fam') adultsSelect.value = '4';
        else if (qAdults === 'group') adultsSelect.value = '6';
        else if (['1', '2', '3', '4', '6', '8'].includes(qAdults)) adultsSelect.value = qAdults;
        state.adults = parseInt(adultsSelect.value) || 2;
      }
      if (childrenSelect && qChildren && ['0', '1', '2', '3'].includes(qChildren)) {
        childrenSelect.value = qChildren;
        state.children = parseInt(qChildren) || 0;
      }

      // Parâmetro de Regime (APA, MP, PC)
      const qRegime = urlParams.get('regime')?.toLowerCase();
      if (qRegime && ['apa', 'mp', 'pc'].includes(qRegime)) {
        state.mealPlan = qRegime;
      }

      // Parâmetro de Perfil (casais, familias, bem-estar, aventura)
      if (qPerfil) {
        if (qPerfil === 'casais') {
          state.accommodationId = 'cork-shelter-standard';
        } else if (qPerfil === 'familias') {
          state.accommodationId = 'cork-shelter-familiar';
          if (adultsSelect) { adultsSelect.value = '2'; state.adults = 2; }
          if (childrenSelect) { childrenSelect.value = '2'; state.children = 2; }
        } else if (qPerfil === 'bem-estar') {
          state.accommodationId = 'cork-shelter-superior';
          state.mealPlan = 'mp';
        } else if (qPerfil === 'aventura') {
          state.accommodationId = 'tenda-glamping-amigos';
        }
      }

      // Parâmetro de Tipologia explícito
      if (qTipologia) {
        state.accommodationId = qTipologia;
      }

      // Filtragem dinâmica de Alojamentos por Capacidade e Datas
      const filterAccommodations = () => {
        const totalGuests = state.adults + state.children;
        let visibleCount = 0;
        let currentSelectedIsVisible = false;

        accomRadios.forEach(radio => {
          const card = radio.closest<HTMLLabelElement>('.accom-radio-card');
          const capMax = parseInt(card?.getAttribute('data-capacity-max') || radio.getAttribute('data-capacity-max') || '2');

          // Apenas alojamentos com capacidade suficiente para o grupo aparecem
          const isCapable = capMax >= totalGuests;

          if (isCapable) {
            card?.classList.remove('hidden');
            visibleCount++;
            if (radio.value === state.accommodationId) currentSelectedIsVisible = true;
          } else {
            card?.classList.add('hidden');
          }
        });

        // Atualizar contador e feedback
        const countBadge = document.getElementById('accom-count-badge');
        const feedback = document.getElementById('accom-filter-feedback');
        const noAccomAlert = document.getElementById('no-accom-alert');
        const nextBtn1 = document.getElementById('btn-goto-step-2') as HTMLButtonElement | null;

        if (countBadge) {
          countBadge.textContent = `${visibleCount} ${visibleCount === 1 ? 'Disponível' : 'Disponíveis'}`;
        }

        if (feedback) {
          feedback.textContent = `A apresentar ${visibleCount} ${visibleCount === 1 ? 'alojamento compatível' : 'alojamentos compatíveis'} para ${totalGuests} hóspedes (${state.adults} adultos${state.children > 0 ? `, ${state.children} crianças` : ''}) nas suas datas selecionadas.`;
        }

        if (visibleCount === 0) {
          noAccomAlert?.classList.remove('hidden');
          if (nextBtn1) nextBtn1.disabled = true;
        } else {
          noAccomAlert?.classList.add('hidden');
          if (nextBtn1) nextBtn1.disabled = false;

          // Se o alojamento anteriormente selecionado deixou de ser visível, selecionar o primeiro compatível
          if (!currentSelectedIsVisible) {
            const firstRadio = document.querySelector<HTMLInputElement>('.accom-radio-card:not(.hidden) input[name="accommodation_radio"]');
            if (firstRadio) {
              firstRadio.checked = true;
              state.accommodationId = firstRadio.value;
            }
          }
        }

        updateAccomCardsUI();
      };

      const updateAccomCardsUI = () => {
        accomRadios.forEach(radio => {
          const card = radio.closest('.accom-radio-card');
          const dot = card?.querySelector('.radio-dot');
          if (radio.checked) {
            card?.classList.add('border-natureGold', 'bg-white', 'shadow-soft', 'ring-2', 'ring-natureGold/40');
            card?.classList.remove('border-sand-border', 'bg-sand-warm/40');
            dot?.classList.remove('hidden');

            state.accommodationId = radio.value;
            state.accommodationName = radio.getAttribute('data-name') || radio.value;
            state.accommodationPrice = BACKOFFICE_CONFIG.basePrices[radio.value] || 120;
            state.accommodationImage = radio.getAttribute('data-image') || '';
            state.accommodationCapacity = radio.getAttribute('data-capacity') || '';
          } else {
            card?.classList.remove('border-natureGold', 'bg-white', 'shadow-soft', 'ring-2', 'ring-natureGold/40');
            card?.classList.add('border-sand-border', 'bg-sand-warm/40');
            dot?.classList.add('hidden');
          }
        });
        recalculateNightsAndPricing();
      };

      accomRadios.forEach(radio => {
        radio.addEventListener('change', updateAccomCardsUI);
      });

      // Seleção visual inicial
      let matchedRadio = false;
      accomRadios.forEach(radio => {
        if (radio.value === state.accommodationId) {
          radio.checked = true;
          matchedRadio = true;
        }
      });
      if (!matchedRadio && accomRadios.length > 0) {
        accomRadios[0].checked = true;
      }
      filterAccommodations();

      // Listeners de Adultos e Crianças
      adultsSelect?.addEventListener('change', () => {
        state.adults = parseInt(adultsSelect.value) || 2;
        filterAccommodations();
        recalculateNightsAndPricing();
      });

      childrenSelect?.addEventListener('change', () => {
        state.children = parseInt(childrenSelect.value) || 0;
        filterAccommodations();
        recalculateNightsAndPricing();
      });

      // 4. Interface da Escolha da Pensão e Tarifas
      const updateMealPlanUI = () => {
        mealPlanCards.forEach(card => {
          const key = card.getAttribute('data-meal-key');
          const dot = card.querySelector<HTMLElement>('.meal-radio-dot');
          const isSelected = key === state.mealPlan;
          if (isSelected) {
            card.classList.add('border-natureGold', 'bg-natureGold/10', 'ring-2', 'ring-natureGold/30');
            card.classList.remove('border-sand-border', 'bg-white');
            dot?.classList.remove('hidden');
          } else {
            card.classList.remove('border-natureGold', 'bg-natureGold/10', 'ring-2', 'ring-natureGold/30');
            card.classList.add('border-sand-border', 'bg-white');
            dot?.classList.add('hidden');
          }
        });

        const activeMealTitle = document.getElementById('active-meal-title');
        if (activeMealTitle) {
          const mInfo = BACKOFFICE_CONFIG.mealPlans[state.mealPlan] || BACKOFFICE_CONFIG.mealPlans['apa'];
          activeMealTitle.textContent = mInfo.fullName;
        }
      };

      mealPlanCards.forEach(card => {
        card.addEventListener('click', () => {
          const key = card.getAttribute('data-meal-key');
          if (key) {
            state.mealPlan = key;
            updateMealPlanUI();
            recalculateNightsAndPricing();
          }
        });
      });

      const updateRatePolicyUI = () => {
        ratePolicyCards.forEach(card => {
          const policy = card.getAttribute('data-policy');
          const dot = card.querySelector<HTMLElement>('.rate-policy-dot');
          const isSelected = policy === state.cancellationPolicy;
          if (isSelected) {
            card.classList.add('border-natureGold', 'bg-natureGold/5', 'ring-2', 'ring-natureGold/40', 'shadow-soft');
            card.classList.remove('border-sand-border', 'bg-white');
            dot?.classList.remove('hidden');
          } else {
            card.classList.remove('border-natureGold', 'bg-natureGold/5', 'ring-2', 'ring-natureGold/40', 'shadow-soft');
            card.classList.add('border-sand-border', 'bg-white');
            dot?.classList.add('hidden');
          }
        });
      };

      ratePolicyCards.forEach(card => {
        card.addEventListener('click', () => {
          const policy = card.getAttribute('data-policy');
          if (policy) {
            state.cancellationPolicy = policy;
            updateRatePolicyUI();
            recalculateNightsAndPricing();
          }
        });
      });

      // Cálculo Específico de Tarifa por Regime e Política
      function calculateSpecificRate(mealKey: string, policyKey: string) {
        const baseDaily = BACKOFFICE_CONFIG.basePrices[state.accommodationId] || 120;
        const roomStay = baseDaily * state.nights;

        const mealInfo = BACKOFFICE_CONFIG.mealPlans[mealKey] || BACKOFFICE_CONFIG.mealPlans['apa'];
        const adultMeal = mealInfo.adultDailySupplement * state.adults * state.nights;
        const childMeal = mealInfo.childDailySupplement * state.children * state.nights;
        const mealTotal = adultMeal + childMeal;

        const subtotal = roomStay + mealTotal;

        // Desconto da política não reembolsável
        let policyDiscount = 0;
        if (policyKey === 'non_refundable') {
          policyDiscount = subtotal * (BACKOFFICE_CONFIG.nonRefundableDiscountPercent / 100);
        }

        // Desconto promocional de campanha / backoffice
        const effectivePromoPercent = Math.max(state.promoDiscountPercent, BACKOFFICE_CONFIG.globalCampaignDiscountPercent);
        let promoDiscount = 0;
        if (effectivePromoPercent > 0) {
          promoDiscount = (subtotal - policyDiscount) * (effectivePromoPercent / 100);
        }

        const total = Math.max(0, subtotal - policyDiscount - promoDiscount);
        return {
          roomStay,
          mealTotal,
          policyDiscount,
          promoDiscount,
          total
        };
      }

      // Aplicação de Voucher / Desconto de Backoffice
      const applyPromoCode = (codeStr: string) => {
        const cleanCode = codeStr.trim().toUpperCase();
        if (!cleanCode) {
          if (promoFeedback) {
            promoFeedback.textContent = 'Por favor introduza um código.';
            promoFeedback.className = 'text-[11px] font-montserrat font-bold text-red-600 block';
          }
          return;
        }

        const promo = BACKOFFICE_CONFIG.promoCodes[cleanCode];
        if (promo) {
          state.promoCode = cleanCode;
          state.promoDiscountPercent = promo.percent;
          state.promoDiscountLabel = promo.label;
          if (promoFeedback) {
            promoFeedback.textContent = `✓ Voucher "${cleanCode}" aplicado! Desconto de ${promo.percent}% ativo.`;
            promoFeedback.className = 'text-[11px] font-montserrat font-bold text-green-700 block';
          }
          showDemoToast(`✓ Desconto de Backoffice (${promo.percent}%) ativado com sucesso!`);
          recalculateNightsAndPricing();
        } else {
          if (promoFeedback) {
            promoFeedback.textContent = `Código "${cleanCode}" inválido ou expirado no backoffice.`;
            promoFeedback.className = 'text-[11px] font-montserrat font-bold text-red-600 block';
          }
        }
      };

      btnApplyPromo?.addEventListener('click', () => {
        if (promoCodeInput) applyPromoCode(promoCodeInput.value);
      });

      promoCodeInput?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          if (promoCodeInput) applyPromoCode(promoCodeInput.value);
        }
      });

      promoHint1?.addEventListener('click', () => {
        if (promoCodeInput) {
          promoCodeInput.value = 'GAVIAO10';
          applyPromoCode('GAVIAO10');
        }
      });

      promoHint2?.addEventListener('click', () => {
        if (promoCodeInput) {
          promoCodeInput.value = 'VERAO15';
          applyPromoCode('VERAO15');
        }
      });

      const qPromo = urlParams.get('promo') || urlParams.get('codigo') || urlParams.get('voucher');
      if (qPromo) {
        if (promoCodeInput) promoCodeInput.value = qPromo;
        applyPromoCode(qPromo);
      }

      // 5. Cálculo Dinâmico de Noites e Preço
      function recalculateNightsAndPricing() {
        if (!state.checkin || !state.checkout) return;
        const d1 = new Date(state.checkin);
        const d2 = new Date(state.checkout);
        const diffTime = Math.abs(d2.getTime() - d1.getTime());
        const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
        state.nights = diffDays > 0 ? diffDays : 1;

        const currentCalc = calculateSpecificRate(state.mealPlan, state.cancellationPolicy);
        state.stayBaseTotal = currentCalc.roomStay;
        state.mealSupplementsTotal = currentCalc.mealTotal;
        state.policyDiscountTotal = currentCalc.policyDiscount;
        state.promoDiscountTotal = currentCalc.promoDiscount;
        state.grandTotal = currentCalc.total;

        // Atualizar as tarifas exibidas para o regime de pensão ativo
        const refRateCalc = calculateSpecificRate(state.mealPlan, 'refundable');
        const nonRefRateCalc = calculateSpecificRate(state.mealPlan, 'non_refundable');

        const refPriceEl = document.getElementById('rate-price-display-refundable');
        const nonRefPriceEl = document.getElementById('rate-price-display-non-refundable');
        const nonRefDiscountEl = document.getElementById('rate-discount-display-non-refundable');

        if (refPriceEl) refPriceEl.textContent = `${refRateCalc.total.toFixed(2)} €`;
        if (nonRefPriceEl) nonRefPriceEl.textContent = `${nonRefRateCalc.total.toFixed(2)} €`;
        if (nonRefDiscountEl) nonRefDiscountEl.textContent = `Poupe ${nonRefRateCalc.policyDiscount.toFixed(2)} € (-${BACKOFFICE_CONFIG.nonRefundableDiscountPercent}%)`;

        updateMealPlanUI();
        updateRatePolicyUI();

        // Atualizar painel lateral
        const summaryNightsBadge = document.getElementById('summary-nights-badge');
        const summaryAccomImg = document.getElementById('summary-accom-img') as HTMLImageElement | null;
        const summaryAccomTitle = document.getElementById('summary-accom-title');
        const summaryAccomCap = document.getElementById('summary-accom-capacity');
        const summaryCheckin = document.getElementById('summary-checkin');
        const summaryCheckout = document.getElementById('summary-checkout');
        const summaryGuests = document.getElementById('summary-guests');
        const summaryCalcLine = document.getElementById('summary-calc-line');
        const summaryStayTotal = document.getElementById('summary-stay-total');
        const summaryMealLabel = document.getElementById('summary-meal-label');
        const summaryMealTotal = document.getElementById('summary-meal-total');
        const summaryPolicyBadge = document.getElementById('summary-policy-badge');
        const summaryDiscountRow = document.getElementById('summary-discount-row');
        const summaryDiscountLabel = document.getElementById('summary-discount-label');
        const summaryDiscountVal = document.getElementById('summary-discount-val');
        const summaryGrandTotal = document.getElementById('summary-grand-total');

        if (summaryNightsBadge) summaryNightsBadge.textContent = `${state.nights} ${state.nights === 1 ? 'Noite' : 'Noites'}`;
        if (summaryAccomImg && state.accommodationImage) summaryAccomImg.src = state.accommodationImage;
        if (summaryAccomTitle) summaryAccomTitle.textContent = state.accommodationName;
        if (summaryAccomCap) summaryAccomCap.textContent = state.accommodationCapacity;
        if (summaryCheckin) summaryCheckin.textContent = toDisplay(checkinDate);
        if (summaryCheckout) summaryCheckout.textContent = toDisplay(checkoutDate);
        if (summaryGuests) summaryGuests.textContent = `${state.adults} Adultos${state.children > 0 ? `, ${state.children} Crianças` : ''}`;

        const baseDaily = BACKOFFICE_CONFIG.basePrices[state.accommodationId] || 120;
        if (summaryCalcLine) summaryCalcLine.textContent = `Alojamento (${state.nights} ${state.nights === 1 ? 'Noite' : 'Noites'} × ${baseDaily}€):`;
        if (summaryStayTotal) summaryStayTotal.textContent = `${state.stayBaseTotal.toFixed(2)} €`;

        const mealInfo = BACKOFFICE_CONFIG.mealPlans[state.mealPlan];
        if (summaryMealLabel) summaryMealLabel.textContent = `Regime: ${mealInfo.name}`;
        if (summaryMealTotal) {
          summaryMealTotal.textContent = state.mealSupplementsTotal > 0 ? `+${state.mealSupplementsTotal.toFixed(2)} €` : 'Incluído';
        }

        if (summaryPolicyBadge) {
          if (state.cancellationPolicy === 'refundable') {
            summaryPolicyBadge.textContent = 'Reembolsável (até 48h)';
            summaryPolicyBadge.className = 'text-natureGold-dark font-semibold text-[11px]';
          } else {
            summaryPolicyBadge.textContent = `Não Reembolsável (-${BACKOFFICE_CONFIG.nonRefundableDiscountPercent}%)`;
            summaryPolicyBadge.className = 'text-green-700 font-bold text-[11px]';
          }
        }

        const totalDiscounts = state.policyDiscountTotal + state.promoDiscountTotal;
        if (summaryDiscountRow && summaryDiscountVal && summaryDiscountLabel) {
          if (totalDiscounts > 0) {
            summaryDiscountRow.classList.remove('hidden');
            const parts: string[] = [];
            if (state.policyDiscountTotal > 0) parts.push(`Tarifa (-10%)`);
            if (state.promoDiscountTotal > 0) parts.push(`Voucher (${state.promoCode || 'Promo'})`);
            summaryDiscountLabel.textContent = `Desconto (${parts.join(' + ')}):`;
            summaryDiscountVal.textContent = `-${totalDiscounts.toFixed(2)} €`;
          } else {
            summaryDiscountRow.classList.add('hidden');
          }
        }

        if (summaryGrandTotal) summaryGrandTotal.textContent = `${state.grandTotal.toFixed(2)} €`;

        // Atualizar frase de aviso em vermelho da idade das crianças
        updateChildrenNotice();
      }

      // Função dedicada para atualizar o aviso da idade das crianças em vermelho
      const updateChildrenNotice = () => {
        const childrenAlert = document.getElementById('children-notes-alert');
        const notesTextarea = document.getElementById('guest-notes') as HTMLTextAreaElement | null;
        const numChildren = parseInt(childrenSelect?.value || '0') || state.children || 0;
        if (childrenAlert) {
          if (numChildren > 0) {
            childrenAlert.classList.remove('hidden');
            if (notesTextarea && (!notesTextarea.value || notesTextarea.placeholder.startsWith('ex: Hora prevista'))) {
              notesTextarea.placeholder = 'Por Favor, indique aqui a idade das crianças (ex: 4 e 8 anos), hora prevista de chegada ou outras observações...';
            }
          } else {
            childrenAlert.classList.add('hidden');
            if (notesTextarea && (!notesTextarea.value || notesTextarea.placeholder.includes('idade das crianças'))) {
              notesTextarea.placeholder = 'ex: Hora prevista de chegada, restrições alimentares ou berço para bebé...';
            }
          }
        }
      };

      recalculateNightsAndPricing();

      // 5. Navegação entre os Passos (Stepper)
      const panels = [
        document.getElementById('step-panel-1'),
        document.getElementById('step-panel-2'),
        document.getElementById('step-panel-3'),
        document.getElementById('step-panel-4')
      ];

      const indicators = document.querySelectorAll<HTMLElement>('.step-indicator');
      const progressBar = document.getElementById('stepper-progress-bar');

      const goToStep = (stepNumber: number) => {
        state.step = stepNumber;

        // Se saltar para os passos 2, 3 ou 4 e os dados de hóspede estiverem vazios, preencher padrão 123456789
        if (stepNumber >= 2 && (!state.guest.name || !guestNameInput?.value)) {
          applyDemoGuestData(false);
        }
        if (stepNumber >= 3 && (!state.payment.cardNumber || !cardNumberInput?.value)) {
          applyDemoPaymentData(false);
        }
        if (stepNumber === 2) {
          updateChildrenNotice();
        }
        if (stepNumber === 4) {
          populateConfirmationScreen();
        }

        // Mostrar o painel correto
        panels.forEach((p, idx) => {
          if (idx + 1 === stepNumber) {
            p?.classList.remove('hidden');
          } else {
            p?.classList.add('hidden');
          }
        });

        // Atualizar Stepper Indicator
        indicators.forEach((ind) => {
          const s = parseInt(ind.getAttribute('data-step') || '1');
          const circle = ind.querySelector('.step-circle');
          const label = ind.querySelector('.step-label');

          if (s < stepNumber) {
            // Concluído
            circle?.classList.remove('bg-white', 'border-2', 'border-sand-border', 'text-charcoal-muted', 'ring-4');
            circle?.classList.add('bg-natureGold', 'text-charcoal-dark');
            if (circle) circle.innerHTML = '✓';
            label?.classList.remove('text-charcoal-muted');
            label?.classList.add('text-charcoal', 'font-bold');
          } else if (s === stepNumber) {
            // Ativo
            circle?.classList.remove('bg-white', 'border-2', 'border-sand-border', 'text-charcoal-muted');
            circle?.classList.add('bg-natureGold', 'text-charcoal-dark', 'ring-4', 'ring-natureGold/20');
            if (circle) circle.innerHTML = s === 4 ? '✓' : `${s}`;
            label?.classList.remove('text-charcoal-muted');
            label?.classList.add('text-charcoal', 'font-bold');
          } else {
            // Pendente mas agora clicável
            circle?.classList.remove('bg-natureGold', 'text-charcoal-dark', 'ring-4', 'ring-natureGold/20');
            circle?.classList.add('bg-white', 'border-2', 'border-sand-border', 'text-charcoal-muted');
            if (circle) circle.innerHTML = s === 4 ? '✓' : `${s}`;
            label?.classList.remove('text-charcoal', 'font-bold');
            label?.classList.add('text-charcoal-muted');
          }
        });

        // Barra de progresso percentual
        if (progressBar) {
          const widths = ['12.5%', '37.5%', '62.5%', '100%'];
          progressBar.style.width = widths[stepNumber - 1];
        }

        // Scroll suave para o topo do formulário
        document.getElementById('booking-stepper')?.scrollIntoView({ behavior: 'smooth' });
      };

      // Permitir clicar em QUALQUER passo do stepper a qualquer momento
      indicators.forEach(ind => {
        ind.addEventListener('click', () => {
          const target = parseInt(ind.getAttribute('data-step') || '1');
          goToStep(target);
        });
      });

      // 6. Preenchimento e Aplicação dos Dados de Demonstração (123456789)
      const applyDemoGuestData = (highlight = true) => {
        if (guestNameInput) guestNameInput.value = DEMO_DATA.name;
        if (guestEmailInput) guestEmailInput.value = DEMO_DATA.email;
        if (guestPhoneInput) guestPhoneInput.value = DEMO_DATA.phone;
        if (guestNifInput) guestNifInput.value = DEMO_DATA.nif;
        const demoNotesVal = state.children > 0 
          ? `Idade das Crianças: 4 e 7 anos. ${DEMO_DATA.notes}` 
          : DEMO_DATA.notes;

        if (guestNotesInput && !guestNotesInput.value) guestNotesInput.value = demoNotesVal;

        state.guest.name = DEMO_DATA.name;
        state.guest.email = DEMO_DATA.email;
        state.guest.phone = DEMO_DATA.phone;
        state.guest.nif = DEMO_DATA.nif;
        state.guest.country = DEMO_DATA.country;
        state.guest.notes = demoNotesVal;

        if (highlight) {
          [guestNameInput, guestEmailInput, guestPhoneInput, guestNifInput].forEach(el => {
            el?.classList.add('ring-2', 'ring-natureGold/60', 'border-natureGold');
            setTimeout(() => el?.classList.remove('ring-2', 'ring-natureGold/60'), 2000);
          });
        }
      };

      const applyDemoPaymentData = (highlight = true) => {
        if (cardNumberInput) cardNumberInput.value = DEMO_DATA.cardNumber;
        if (cardHolderInput) cardHolderInput.value = DEMO_DATA.cardHolder;
        if (cardExpiryInput) cardExpiryInput.value = DEMO_DATA.cardExpiry;
        if (cardCvvInput) cardCvvInput.value = DEMO_DATA.cardCvv;
        if (mbwayPhoneInput) mbwayPhoneInput.value = DEMO_DATA.mbwayPhone;

        state.payment.cardNumber = DEMO_DATA.cardNumber;
        state.payment.cardHolder = DEMO_DATA.cardHolder;
        state.payment.cardExpiry = DEMO_DATA.cardExpiry;
        state.payment.cardCvv = DEMO_DATA.cardCvv;
        state.payment.mbwayPhone = DEMO_DATA.mbwayPhone;

        if (highlight) {
          [cardNumberInput, cardHolderInput, cardExpiryInput, cardCvvInput, mbwayPhoneInput].forEach(el => {
            el?.classList.add('ring-2', 'ring-natureGold/60', 'border-natureGold');
            setTimeout(() => el?.classList.remove('ring-2', 'ring-natureGold/60'), 2000);
          });
        }
      };

      const fillAllDemoData = (highlight = true) => {
        applyDemoGuestData(highlight);
        applyDemoPaymentData(highlight);
        state.confirmationCode = 'GNV-123456789';
      };

      // Detetar o número '123456789' em QUALQUER campo quando o utilizador escreve
      const allFormInputs = [
        guestNameInput,
        guestEmailInput,
        guestPhoneInput,
        guestNifInput,
        cardNumberInput,
        cardHolderInput,
        cardExpiryInput,
        cardCvvInput,
        mbwayPhoneInput
      ];

      allFormInputs.forEach(input => {
        if (!input) return;
        const checkDemoValue = () => {
          const val = input.value.trim();
          if (val === '123456789' || val.includes('123456789')) {
            fillAllDemoData(true);
            showDemoToast('✓ Modo 123456789 detetado! Todos os campos preenchidos com sucesso.');
          }
        };
        input.addEventListener('input', checkDemoValue);
        input.addEventListener('change', checkDemoValue);
      });

      // 7. Botão 1: "Preencher Campos (123456789)"
      quickFillBtn?.addEventListener('click', () => {
        fillAllDemoData(true);
        showDemoToast('✓ Dados 123456789 preenchidos em todos os passos!');
        
        // Se estiver no Passo 1, avançar suavemente para o Passo 2 para ver os campos
        if (state.step === 1) {
          setTimeout(() => goToStep(2), 250);
        }
      });

      // 8. Botão 2: "Teste Instantâneo (123456789) →"
      instantTestBtn?.addEventListener('click', () => {
        fillAllDemoData(false);
        showDemoToast('⚡ Simulação Instantânea Concluída (123456789)!');
        goToStep(4);
      });

      // 9. Preenchimento dos dados do Passo 4 (Confirmação Oficial)
      function populateConfirmationScreen() {
        if (!state.guest.name) state.guest.name = DEMO_DATA.name;
        if (!state.guest.email) state.guest.email = DEMO_DATA.email;
        state.confirmationCode = 'GNV-123456789';

        const codeEl = document.getElementById('confirmation-code');
        const confAccom = document.getElementById('conf-accom-name');
        const confDates = document.getElementById('conf-dates');
        const confRegimePolicy = document.getElementById('conf-regime-policy');
        const confGuest = document.getElementById('conf-guest-name');
        const confTotal = document.getElementById('conf-total-price');

        const mealInfo = BACKOFFICE_CONFIG.mealPlans[state.mealPlan] || BACKOFFICE_CONFIG.mealPlans['apa'];
        const policyLabel = state.cancellationPolicy === 'refundable' ? 'Reembolsável (até 48h)' : 'Não Reembolsável (-10%)';

        if (codeEl) codeEl.textContent = state.confirmationCode;
        if (confAccom) confAccom.textContent = state.accommodationName;
        if (confDates) confDates.textContent = `${toDisplay(checkinDate)} até ${toDisplay(checkoutDate)} (${state.nights} noites)`;
        if (confRegimePolicy) confRegimePolicy.textContent = `${mealInfo.name} · ${policyLabel}`;
        if (confGuest) confGuest.textContent = `${state.guest.name} · ${state.guest.email}`;
        if (confTotal) confTotal.textContent = `${state.grandTotal.toFixed(2)} €`;
      }

      // 10. Botões de Navegação dos Passos
      // Passo 1 -> Passo 2
      document.getElementById('btn-goto-step-2')?.addEventListener('click', () => {
        goToStep(2);
      });

      // Passo 2 -> Passo 1
      document.getElementById('btn-backto-step-1')?.addEventListener('click', () => {
        goToStep(1);
      });

      // Passo 2 -> Passo 3
      document.getElementById('btn-goto-step-3')?.addEventListener('click', () => {
        // Se campos estiverem vazios ou tiverem 123456789, auto-completar sem bloqueio
        const n = guestNameInput?.value.trim();
        const e = guestEmailInput?.value.trim();
        const p = guestPhoneInput?.value.trim();
        const nf = guestNifInput?.value.trim();

        if (!n || n === '123456789') guestNameInput!.value = DEMO_DATA.name;
        if (!e || e === '123456789') guestEmailInput!.value = DEMO_DATA.email;
        if (!p || p === '123456789') guestPhoneInput!.value = DEMO_DATA.phone;
        if (!nf || nf === '123456789') guestNifInput!.value = DEMO_DATA.nif;

        state.guest.name = guestNameInput?.value || DEMO_DATA.name;
        state.guest.email = guestEmailInput?.value || DEMO_DATA.email;
        state.guest.phone = guestPhoneInput?.value || DEMO_DATA.phone;
        state.guest.nif = guestNifInput?.value || DEMO_DATA.nif;
        state.guest.country = guestCountrySelect?.value || 'PT';
        state.guest.notes = guestNotesInput?.value || '';

        goToStep(3);
      });

      // Passo 3 -> Passo 2
      document.getElementById('btn-backto-step-2')?.addEventListener('click', () => {
        goToStep(2);
      });

      // Seleção do Método de Pagamento
      const paymentRadios = document.querySelectorAll<HTMLInputElement>('input[name="payment_method"]');
      const paymentBoxes = {
        credit_card: document.getElementById('payment-fields-credit_card'),
        mbway: document.getElementById('payment-fields-mbway'),
        multibanco: document.getElementById('payment-fields-multibanco')
      };

      paymentRadios.forEach(radio => {
        radio.addEventListener('change', () => {
          document.querySelectorAll('.payment-method-card').forEach(c => {
            c.classList.remove('border-natureGold', 'bg-natureGold/10');
            c.classList.add('border-sand-border', 'bg-sand-warm/20');
          });
          const parent = radio.closest('.payment-method-card');
          parent?.classList.add('border-natureGold', 'bg-natureGold/10');
          parent?.classList.remove('border-sand-border', 'bg-sand-warm/20');

          Object.keys(paymentBoxes).forEach(key => {
            const box = paymentBoxes[key as keyof typeof paymentBoxes];
            if (key === radio.value) {
              box?.classList.remove('hidden');
            } else {
              box?.classList.add('hidden');
            }
          });
          state.payment.method = radio.value;
        });
      });

      // Passo 3 -> Passo 4 (Confirmar e Pagar)
      document.getElementById('btn-confirm-payment')?.addEventListener('click', () => {
        const confirmBtn = document.getElementById('btn-confirm-payment') as HTMLButtonElement | null;
        if (confirmBtn) {
          confirmBtn.disabled = true;
          confirmBtn.innerHTML = '⏳ A processar confirmação segura...';
        }

        // Se campos estiverem vazios no pagamento, preencher com padrão 123456789
        if (cardNumberInput && (!cardNumberInput.value || cardNumberInput.value === '123456789')) cardNumberInput.value = DEMO_DATA.cardNumber;
        if (cardHolderInput && (!cardHolderInput.value || cardHolderInput.value === '123456789')) cardHolderInput.value = DEMO_DATA.cardHolder;
        if (cardExpiryInput && (!cardExpiryInput.value || cardExpiryInput.value === '123456789')) cardExpiryInput.value = DEMO_DATA.cardExpiry;
        if (cardCvvInput && (!cardCvvInput.value || cardCvvInput.value === '123456789')) cardCvvInput.value = DEMO_DATA.cardCvv;
        if (mbwayPhoneInput && (!mbwayPhoneInput.value || mbwayPhoneInput.value === '123456789')) mbwayPhoneInput.value = DEMO_DATA.mbwayPhone;

        setTimeout(() => {
          if (confirmBtn) {
            confirmBtn.disabled = false;
            confirmBtn.innerHTML = '<svg class="w-4 h-4 text-charcoal-dark shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg><span>Confirmar e Pagar Reserva →</span>';
          }
          goToStep(4);
          showDemoToast('✓ Reserva confirmada com sucesso! Código GNV-123456789.');
        }, 500);
      });

      // 11. Botão "Nova Simulação" no Passo 4
      newReservationBtn?.addEventListener('click', () => {
        goToStep(1);
        showDemoToast('Novo processo de reserva iniciado.');
      });
    });
  </script>
</BaseLayout>
