---
// src/pages/patrimonio-e-cultura.astro
import BaseLayout from '../layouts/BaseLayout.astro';

const items = [
  {
    id: 'castelo-de-belver',
    title: 'Castelo de Belver',
    subtitle: 'Fortaleza dos Cavaleiros Hospitalários sobre o Rio Tejo',
    badge: 'Monumento Nacional · Séc. XII',
    distance: '5 min de carro da herdade (Belver)',
    image: '/images/arredores/castelo_belver.jpg',
    description: 'Este monumento nacional data do século XIII e é considerado um dos mais completos e imponentes da arquitetura militar medieval portuguesa. Mandado edificar pelo rei D. Sancho I e confiado à Ordem dos Cavaleiros de São João de Jerusalém (Hospitalários), guarda uma impressionante Torre de Menagem e oferece uma panorâmica de 360 graus que domina todo o curso do Tejo e a paisagem alentejana.',
    highlights: [
      'Torre de Menagem gótica com vista 360° sobre o Tejo',
      'Muralhas medievais preservadas e capela de São Brás',
      'A apenas 5 minutos de carro do Gavião Nature Village'
    ],
    infoLink: 'https://www.cm-gaviao.pt/locais/castelo-de-belver-belver/'
  },
  {
    id: 'museu-do-sabao',
    title: 'Museu do Sabão',
    subtitle: 'Um dos únicos 4 museus do mundo dedicados à arte saboeira',
    badge: 'Património Industrial Exclusivo',
    distance: '6 min de carro da herdade (Belver)',
    image: '/images/arredores/museu_sabao.jpg',
    description: 'O Museu do Sabão de Belver é um dos raríssimos quatro museus do mundo dedicados integralmente a esta temática. Instalado na antiga escola primária de Belver, conta a fascinante história da Real Fábrica do Sabão que operou no concelho entre os séculos XVI e XIX, revelando os processos tradicionais de fabrico azeiteiro, memórias operárias e fórmulas seculares.',
    highlights: [
      'Espólio histórico e máquinas antigas da Real Fábrica',
      'Exposição interativa e oficinas didáticas de sabão artesanal',
      'Homenagem à história operária e ao azeite da região'
    ],
    infoLink: 'https://www.cm-gaviao.pt/locais/museu-do-sabao/'
  },
  {
    id: 'nucleo-de-mantas-e-tapecarias-de-belver',
    title: 'Núcleo de Mantas e Tapeçarias',
    subtitle: 'A memória viva dos teares manuais e das tradicionais Rodilhas',
    badge: 'Artesanato & Etnografia Têxtil',
    distance: '6 min de carro da herdade (Belver)',
    image: '/images/arredores/mantas_belver.jpg',
    description: 'Tem como função primordial preservar a memória da unidade produtiva de tecidos artesanais e salvaguardar um saber ancestral que só pode ser encontrado nesta região. Um espaço de valor etnográfico inestimável, onde se revive o manuseamento dos teares manuais de madeira e a confeção das tradicionais mantas de lã e das famosas rodilhas alentejanas.',
    highlights: [
      'Teares manuais de madeira em perfeito funcionamento',
      'Coleção das históricas Rodilhas de lã de Belver',
      'Padrões geométricos e herança têxtil alentejana'
    ],
    infoLink: 'https://www.cm-gaviao.pt/locais/nucleo-museologico-das-mantas-e-tapecarias-de-belver/'
  },
  {
    id: 'casa-das-artes',
    title: 'Casa das Artes de Gavião',
    subtitle: 'Antiga villa senhorial do séc. XX recuperada para as artes e memórias locais',
    badge: 'Cultura Contemporânea & Galeria',
    distance: '8 min da herdade (Vila de Gavião)',
    image: '/images/arredores/casa_artes.jpg',
    description: 'Esta distinta villa do início do século XX foi restaurada para albergar o posto de turismo concelhio, um museu e uma galeria dedicados aos artistas locais e à histórica banda de música de Gavião. Distribuída por cinco salas de traça original preservada, acolhe exposições temporárias de pintura, escultura e iniciativas culturais.',
    highlights: [
      'Arquitetura senhorial de início do séc. XX reabilitada',
      'Cinco salas temáticas de exposição e artes plásticas',
      'Espaço de acolhimento turístico no centro histórico'
    ],
    infoLink: 'https://www.cm-gaviao.pt/visitar/conhecer/casa-das-artes-de-gaviao/'
  }
];
---

<BaseLayout 
  title="Património e Cultura | Gavião Nature Village — Alto Alentejo"
  description="Conheça o património histórico e cultural junto ao Gavião Nature Village: Castelo de Belver, Museu do Sabão, Núcleo de Mantas e Casa das Artes."
>

  <!-- =========================================================================
       HERO DA PÁGINA (PADRÃO UNIFICADO DO WEBSITE)
       ========================================================================= -->
  <section class="relative h-[38vh] min-h-[290px] md:h-[40vh] md:min-h-[330px] flex flex-col justify-center items-center bg-charcoal overflow-hidden text-white">
    <div class="absolute inset-0 z-0">
      <img 
        src="/images/arredores/hero_patrimonio.jpg" 
        alt="Património e Cultura em Gavião e Belver" 
        class="w-full h-full object-cover opacity-50 scale-105"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/25 to-black/40"></div>
    </div>

    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center my-auto">
      <h1 class="font-catamaran font-extrabold text-3xl sm:text-5xl md:text-6xl uppercase tracking-wider text-white drop-shadow-[0_4px_20px_rgba(0,0,0,0.6)]">
        Património e Cultura
      </h1>
    </div>
  </section>


  <!-- =========================================================================
       INTRODUÇÃO EDITORIAL
       ========================================================================= -->
  <section class="py-8 md:py-12 bg-white border-b border-sand-border/70">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
        
        <!-- Coluna Esquerda: Título Editorial -->
        <div class="lg:col-span-5 space-y-4">
          <span class="text-natureGold-dark font-montserrat font-bold text-xs uppercase tracking-widest block">
            Alto Alentejo Histórico
          </span>
          <h2 class="font-catamaran font-extrabold text-2xl sm:text-3xl md:text-4xl text-charcoal leading-tight">
            A história viva de Belver, os cavaleiros medievais e as artes ancestrais.
          </h2>
        </div>

        <!-- Coluna Direita: Narrativa de Contexto -->
        <div class="lg:col-span-7 lg:pl-8 lg:border-l border-sand-border">
          <p class="font-catamaran text-charcoal text-base sm:text-lg leading-relaxed font-light">
            O território de Gavião e Belver respira lendas, batalhas e tradições comunitárias. Das muralhas graníticas do Castelo erguido pela Ordem dos Hospitalários às mãos sábias que moldavam o sabão vegetal ou teciam as coloridas rodilhas de lã, cada recanto convida a uma viagem no tempo. Explore estes pontos de interesse durante a sua estadia na herdade, combinando o descanso no campo com o contacto direto com a identidade alentejana.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- =========================================================================
       SHOWCASE DOS LOCAIS HISTÓRICOS & CULTURAIS
       ========================================================================= -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20 md:space-y-24">
      
      {items.map((item, idx) => (
        <article id={item.id} class={`grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-center ${idx % 2 === 1 ? 'lg:flex-row-reverse' : ''}`}>
          
          <!-- Imagem Fotográfica -->
          <div class={`lg:col-span-6 ${idx % 2 === 1 ? 'lg:order-2' : ''}`}>
            <div class="relative overflow-hidden shadow-luxury group">
              <img 
                src={item.image} 
                alt={item.title} 
                class="w-full h-80 sm:h-[420px] object-cover transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
              />
              <!-- Tag de Distância / Localização -->
              <div class="absolute bottom-4 left-4">
                <span class="bg-black/75 backdrop-blur-md text-white font-montserrat text-xs font-medium px-3.5 py-1.5 rounded-full flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 text-natureGold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path></svg>
                  {item.distance}
                </span>
              </div>
            </div>
          </div>

          <!-- Conteúdo Editorial -->
          <div class={`lg:col-span-6 space-y-5 ${idx % 2 === 1 ? 'lg:order-1' : ''}`}>
            <div>
              <span class="text-xs font-montserrat font-bold text-natureGold-dark uppercase tracking-widest block mb-1">
                {item.badge}
              </span>
              <h3 class="font-catamaran font-extrabold text-2xl sm:text-3xl lg:text-4xl uppercase tracking-wide text-charcoal">
                {item.title}
              </h3>
              <p class="font-catamaran text-charcoal-muted text-sm sm:text-base font-semibold mt-1">
                {item.subtitle}
              </p>
            </div>

            <p class="font-catamaran text-charcoal-muted text-sm sm:text-base leading-relaxed">
              {item.description}
            </p>

            <!-- Destaques -->
            <div class="bg-sand-warm rounded-2xl p-5 sm:p-6 border border-sand-border space-y-2.5">
              <h4 class="font-montserrat font-bold text-xs uppercase tracking-wider text-charcoal flex items-center gap-2">
                <svg class="w-4 h-4 text-natureGold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                Pontos de Interesse:
              </h4>
              <ul class="space-y-1.5 text-xs font-montserrat text-charcoal-muted">
                {item.highlights.map(h => (
                  <li class="flex items-start gap-2">
                    <span class="text-natureGold font-bold">•</span>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Botões / Links -->
            <div class="pt-2 flex flex-wrap items-center gap-3 sm:gap-4">
              {item.infoLink && (
                <a 
                  href={item.infoLink} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 btn-gold font-montserrat font-bold text-xs uppercase tracking-wider px-6 py-3 rounded-xl shadow-soft hover:shadow-gold transition-all whitespace-nowrap cursor-pointer"
                >
                  <span>Mais Informações (C.M. Gavião)</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                </a>
              )}
              <a 
                href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(item.title + ' Gaviao Portugal')}`}
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 bg-white hover:bg-sand-warm text-charcoal border border-sand-border hover:border-natureGold font-montserrat font-semibold text-xs px-5 py-3 rounded-xl transition-all shadow-sm whitespace-nowrap cursor-pointer"
              >
                <span>Ver no Mapa</span>
                <svg class="w-3.5 h-3.5 text-natureGold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path></svg>
              </a>
            </div>

          </div>

        </article>
      ))}

    </div>
  </section>

  <!-- =========================================================================
       RODAPÉ EDITORIAL / CONTINUAR A EXPLORAR OS ARREDORES
       ========================================================================= -->
  <section class="py-16 md:py-20 bg-sand-warm border-t border-sand-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      <span class="text-xs uppercase tracking-widest text-natureGold-dark font-bold font-montserrat block">
        Continue a Descobrir o Alto Alentejo
      </span>
      <h3 class="font-catamaran font-extrabold text-2xl sm:text-4xl text-charcoal">
        Explore a Natureza Fluvial e os Percursos Pedestres
      </h3>
      <p class="font-catamaran text-charcoal-muted text-sm sm:text-base max-w-2xl mx-auto">
        Das águas calmas da Praia Fluvial do Alamal aos trilhos ao longo do Rio Tejo, há todo um território à sua espera.
      </p>
      <div class="pt-4 flex flex-wrap items-center justify-center gap-4">
        <a 
          href="/natureza-e-lazer" 
          class="btn-gold font-montserrat font-bold text-xs uppercase tracking-wider px-8 py-3.5 rounded-xl shadow-soft hover:shadow-gold transition-all"
        >
          Ver Natureza e Lazer →
        </a>
        <a 
          href="/percursos-pedestres" 
          class="bg-white hover:bg-sand-warm text-charcoal border border-sand-border font-montserrat font-bold text-xs uppercase tracking-wider px-8 py-3.5 rounded-xl shadow-sm transition-all"
        >
          Ver Percursos Pedestres →
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
