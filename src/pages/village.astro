---
// src/pages/village.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingBar from '../components/booking/BookingBar.astro';

// Espaços importantes da Vila para a Visão Superior Interativa
const VILLAGE_SPACES = [
  {
    id: 'piscina',
    name: 'Piscina Exterior Panorâmica',
    tagline: 'Refúgio de Água & Sol',
    coords: { x: 91, y: 51 },
    image: '/images/village/media_18_Gavi.jpg',
    description: 'Piscina exterior de água salgada com vista desafogada sobre os montados alentejanos, espreguiçadeiras e serviço de bar de apoio durante a época estival.',
    highlights: ['Água salgada tratada ecologicamente', 'Solário panorâmico com vista montado', 'Apoio de bar no verão']
  },
  {
    id: 'restaurante',
    name: 'Cadafaz Restaurante & Sky Lounge',
    tagline: 'Gastronomia Regional de Autor',
    coords: { x: 80, y: 32 },
    image: '/images/restaurante/media_20_Gavi_o.jpg',
    description: 'Cozinha alentejana autêntica com produtos biológicos da nossa horta e produtores locais. Terraço panorâmico Sky Lounge com vistas inesquecíveis para o Castelo de Belver e o pôr do sol.',
    highlights: ['Produtos colhidos no dia na horta', 'Vinhos selecionados de Cadafaz', 'Vista panorâmica para o Castelo']
  },
  {
    id: 'cork-shelters',
    name: 'Cork Shelters (Bungalows em Cortiça)',
    tagline: 'Arquitetura Sustentável',
    coords: { x: 52, y: 28 },
    image: '/images/alojamentos/media_10_Gavi_o.jpg',
    description: 'Alojamentos térmicos e acústicos inovadores, construídos e revestidos com cortiça 100% natural portuguesa. Conforto contemporâneo perfeitamente integrado na paisagem rural.',
    highlights: ['Isolamento 100% em cortiça nacional', 'Terraço privativo com vista', 'Ar condicionado e kitchenette']
  },
  {
    id: 'glamping',
    name: 'Tendas Glamping de Luxo',
    tagline: 'Dormir sob as Estrelas',
    coords: { x: 71, y: 73 },
    image: '/images/alojamentos/media_26_Gavi_o.jpg',
    description: 'A experiência mágica de acampar em plena harmonia com a natureza sem abdicar do luxo de uma cama king-size, casa de banho privativa completa e deck panorâmico.',
    highlights: ['Total privacidade sob céu limpo', 'Casa de banho privativa completa', 'Deck exterior suspenso em madeira']
  },
  {
    id: 'vinhas',
    name: 'Vinhas Velhas de Cadafaz',
    tagline: 'A Alma Enológica',
    coords: { x: 42, y: 48 },
    image: '/images/village/media_36_Gavi_o.jpg',
    description: 'Parcelas de vinhas históricas preservadas na herdade, testemunhas da tradição vitivinícola secular de Cadafaz que abastece a carta do nosso restaurante.',
    highlights: ['Vinhas históricas preservadas', 'Provas de vinhos comentadas', 'Passeios pedestres entre cepas']
  },
  {
    id: 'animais',
    name: 'Cantinho dos Animais & Horta Biológica',
    tagline: 'Quinta Pedagógica',
    coords: { x: 24, y: 79 },
    image: '/images/village/media_1_Gavi.jpg',
    description: 'Um espaço de carinho e aprendizagem onde as crianças e adultos podem interagir com póneis, cabrinhas anãs e aves em ambiente natural, colhendo produtos frescos.',
    highlights: ['Póneis, cabrinhas anãs e aves', 'Horta biológica pedagógica', 'Atividades diárias para crianças']
  },
  {
    id: 'wellness',
    name: 'Wellness Center & Spa Térmico',
    tagline: 'Revitalização & Quietude',
    coords: { x: 85, y: 36 },
    image: '/images/wellness/media_38_Gavi_o.jpg',
    description: 'Circuito termal completo com sauna panorâmica, banho turco, jacuzzi interior aquecido e rituais de massagem inspirados nas ervas aromáticas do Alto Alentejo.',
    highlights: ['Sauna com vista exterior', 'Banho turco e Jacuzzi aquecido', 'Massagens de assinatura com óleos locais']
  },
  {
    id: 'retiros',
    name: 'Tenda Geodésica & Retiros',
    tagline: 'Harmonia & Bem-Estar',
    coords: { x: 45, y: 69 },
    image: '/images/village/media_33_Gavi.jpg',
    description: 'Espaço multifuncional circular integrado na vegetação, ideal para práticas de yoga matinal, sessões de meditação ao som da natureza, palestras e celebrações intimistas.',
    highlights: ['Estrutura geodésica em madeira', 'Luz natural de 360 graus', 'Acústica serena e relaxante']
  },
  {
    id: 'parque',
    name: 'Parque de Jogos & Lazer',
    tagline: 'Diversão & Aventura',
    coords: { x: 15, y: 56 },
    image: '/images/village/media_6_Gavi_o.jpg',
