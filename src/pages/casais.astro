---
// src/pages/casais.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingBar from '../components/booking/BookingBar.astro';

const accommodations = [
  {
    title: 'Cork Shelter Suite Romântica',
    image: '/images/alojamentos/media_10_Gavi_o.jpg',
    capacity: '2 Adultos',
    size: '32 m² + Terraço',
    features: ['Cama King-size premium', 'Revestimento 100% cortiça natural', 'Terraço panorâmico privativo', 'Climatização independente', 'Chuveiro walk-in com efeito chuva'],
    desc: 'O refúgio definitivo a dois. O isolamento acústico natural da cortiça alentejana garante um silêncio restaurador, complementado pelo deck de madeira virado para o pôr do sol.'
  },
  {
    title: 'Tenda Glamping King',
    image: '/images/alojamentos/media_27_Gavi_o.jpg',
    capacity: '2 Adultos',
    size: '35 m² + Deck Suspenso',
    features: ['Decoração étnico-chic', 'Casa de banho privativa completa', 'Deck exterior privativo', 'Ar condicionado quente/frio', 'Vistas abertas sobre os montes'],
    desc: 'A emoção de dormir na natureza com todo o luxo e conforto. Desfrute de um café ao nascer do sol no terraço de madeira privativo sob a brisa fresca dos sobreiros.'
  }
];

const experiences = [
  {
    title: 'Rituais de Spa a Dois & Jacuzzi',
    time: 'Wellness Center',
    image: '/images/wellness/media_40_Gavi.jpg',
    desc: 'Piscina de hidromassagem aquecida a 35°C, banho turco e massagens relaxantes em cabine dupla com aromaterapia de lavanda e óleos locais.'
  },
  {
    title: 'Cocktail ao Pôr do Sol no Sky Lounge',
    time: 'Ao Fim da Tarde',
    image: '/images/restaurante/media_19_Gavi.jpg',
    desc: 'Uma vista deslumbrante sobre os sobreiros e o Castelo de Belver banhado pela luz dourada, acompanhado por vinhos selecionados de Cadafaz.'
  },
  {
    title: 'Jantar Romântico no Restaurante Cadafaz',
    time: 'Sabores do Alentejo',
    image: '/images/restaurante/media_21_Gavi_o.jpg',
    desc: 'Gastronomia alentejana autêntica com ingredientes frescos da nossa horta biológica num ambiente íntimo à luz suave das velas.'
  }
];

const surroundingActivities = [
  {
    title: 'Passadiços do Alamal & Rio Tejo',
    distance: '6 km do Resort',
    image: '/images/arredores/passadicos_alamal.jpg',
    desc: 'Um passeio de mãos dadas ao longo do passadiço de madeira que serpenteia a encosta do Tejo, com miradouros sobre as águas serenas.'
  },
  {
    title: 'Castelo Medieval de Belver',
    distance: '8 km do Resort',
    image: '/images/arredores/castelo_belver.jpg',
    desc: 'Fortaleza histórica dos Templários com um dos panoramas mais românticos de Portugal sobre o vale do Tejo.'
  },
  {
    title: 'Passeio de Barco Solar no Tejo',
    distance: 'Cais do Alamal',
    image: '/images/arredores/praia_alamal.jpg',
    desc: 'Navegação silenciosa e ecológica nas águas límpidas da albufeira de Belver, rodeada por arribas verdes e natureza intacta.'
  }
];

const faqs = [
  {
    q: 'É possível solicitar comodidades especiais para comemorações românticas?',
    a: 'Sim! Mediante pedido prévio, podemos preparar o quarto com espumante regional, flores, chocolates artesanais e reserva prioritária para massagem a dois.'
  },
  {
    q: 'Os Cork Shelters e Glamping têm privacidade suficiente?',
    a: 'Sem dúvida. Toda a herdade foi desenhada respeitando uma distância ampla entre cada unidade, virando os decks para o montado e garantindo silêncio absoluto.'
  },
  {
    q: 'O acesso ao Wellness Center está incluído na estadia?',
    a: 'Sim, todos os nossos hóspedes têm acesso livre e diário à piscina aquecida, jacuzzi, sauna panorâmica e banho turco durante o horário de funcionamento.'
  }
];
---

<BaseLayout
  title="Casais & Romance | Gavião Nature Village — Escapadinha a Dois no Alentejo"
  description="Viva momentos inesquecíveis a dois no Gavião Nature Village: Cork Shelters com isolamento acústico em cortiça, jantares românticos ao pôr do sol, circuito termal a dois e silêncio absoluto no Alentejo."
>
  <!-- =========================================================================
       HERO CASAIS & ROMANCE: DESIGN CONSISTENTE COM A VILA
       ========================================================================= -->
  <section class="relative min-h-[42vh] sm:min-h-[46vh] flex flex-col justify-center items-center overflow-hidden bg-charcoal">
    <div class="absolute inset-0 z-0">
      <img 
        src="/images/hero/hero_casais.webp" 
        alt="Casais e Romance no Gavião Nature Village" 
        class="w-full h-full object-cover opacity-50 scale-105"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/25 to-black/40"></div>
    </div>

    <!-- Centro do Hero: Apenas o Nome da Página Centrado -->
    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center my-auto pb-4 sm:pb-6">
      <h1 class="font-catamaran font-extrabold text-3xl sm:text-5xl md:text-6xl uppercase tracking-wider text-white drop-shadow-[0_4px_20px_rgba(0,0,0,0.6)]">
        Casais & Romance
      </h1>
    </div>
  </section>

  <!-- =========================================================================
       1º PASSO: APRESENTAR A VILA (SOB O OLHAR ROMÂNTICO)
       ========================================================================= -->
  <section id="vila-casais" class="relative bg-sand-warm text-charcoal border-b border-sand-border pt-0 pb-16 md:pb-24">
    <!-- BARRA FORMULÁRIO (METADE DENTRO DO HERO, METADE DE FORA - APENAS AS 2 CORES: HERO E SECÇÃO) -->
    <div class="relative z-30 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 -translate-y-1/2">
      <BookingBar isFloating={true} />
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-2 sm:mt-4 md:mt-6">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        <!-- Texto Editorial -->
        <div class="lg:col-span-6 space-y-6">

          <h2 class="font-catamaran font-extrabold text-3xl sm:text-4xl lg:text-5xl uppercase tracking-wide text-charcoal leading-tight">
            Intimidade, Silêncio & <br />
            <span class="font-playfair italic font-normal text-natureGold-dark normal-case">Conexão Genuína</span>
          </h2>

          <p class="text-charcoal-muted text-base sm:text-lg leading-relaxed font-normal">
            O Gavião Nature Village foi desenhado numa herdade de 8 hectares em Cadafaz com um princípio inabalável: respeitar o espaço, a serenidade e a paisagem alentejana.
          </p>

          <p class="text-charcoal-muted text-sm sm:text-base leading-relaxed font-normal">
            Aqui, cada unidade de alojamento está espaçada generosamente para assegurar que a vossa única companhia é a brisa do Tejo, os sobreiros centenários e o pôr do sol dourado sobre o Castelo de Belver. É o refúgio perfeito para celebrarem aniversários, pedidos especiais ou simplesmente para se reencontrarem longe do stress urbano.
          </p>

          <div class="grid grid-cols-2 gap-6 pt-4 border-t border-sand-border font-montserrat">
            <div>
              <div class="text-2xl font-catamaran font-bold text-natureGold-dark">8 Hectares</div>
              <div class="text-xs text-charcoal-muted uppercase tracking-wider mt-1">Privacidade no Campo</div>
            </div>
            <div>
              <div class="text-2xl font-catamaran font-bold text-natureGold-dark">100% Cortiça</div>
              <div class="text-xs text-charcoal-muted uppercase tracking-wider mt-1">Isolamento Acústico Natural</div>
            </div>
          </div>
        </div>

        <!-- Galeria Visual Integrada -->
        <div class="lg:col-span-6 grid grid-cols-2 gap-4">
          <div class="space-y-4">
            <div class="h-64 overflow-hidden border border-sand-border shadow-soft">
              <img src="/images/village/media_35_Gavi.jpg" alt="Vistas dos Sobreiros" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
            </div>
            <div class="h-44 overflow-hidden border border-sand-border shadow-soft">
              <img src="/images/village/media_36_Gavi_o.jpg" alt="Pôr do Sol no Alentejo" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
            </div>
          </div>
          <div class="space-y-4 pt-8">
            <div class="h-44 overflow-hidden border border-sand-border shadow-soft">
              <img src="/images/wellness/media_39_Gavi.jpg" alt="Jacuzzi e Relaxamento" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
            </div>
            <div class="h-64 overflow-hidden border border-sand-border shadow-soft">
              <img src="/images/restaurante/media_19_Gavi.jpg" alt="Sky Lounge à noite" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>


  <!-- =========================================================================
       2º PASSO: OS ALOJAMENTOS (SELEÇÃO PARA CASAIS)
       ========================================================================= -->
  <section class="py-16 md:py-24 bg-white text-charcoal border-t border-sand-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="font-catamaran font-extrabold text-2xl sm:text-3xl md:text-4xl uppercase tracking-wide text-charcoal mb-4">
          Conforto Exclusivo & Silêncio
        </h2>
        <p class="font-catamaran text-charcoal-muted text-sm sm:text-base leading-relaxed">
          Acomodações pensadas para o descanso absoluto, onde o design bioclimático da cortiça se junta aos têxteis macios e decks virados para a imensidão alentejana.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
        {accommodations.map((item) => (
          <div class="bg-sand-warm/50 overflow-hidden border border-sand-border hover:border-natureGold/40 shadow-soft hover:shadow-luxury transition-all duration-300 flex flex-col justify-between group">
            <div>
              <div class="h-72 w-full overflow-hidden relative">
                <img 
                  src={item.image} 
                  alt={item.title} 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" 
                />
              </div>

              <div class="p-8 space-y-4">
                <div class="flex items-center justify-between text-xs text-natureGold-dark font-montserrat tracking-wider uppercase font-semibold">
                  <span>Capacidade: {item.capacity}</span>
                  <span>{item.size}</span>
                </div>

                <h3 class="font-catamaran font-extrabold text-2xl text-charcoal uppercase group-hover:text-natureGold transition-colors">
                  {item.title}
                </h3>

                <p class="text-charcoal-muted text-sm leading-relaxed">
                  {item.desc}
                </p>

                <div class="pt-4 border-t border-sand-border">
                  <h4 class="text-xs uppercase tracking-wider text-charcoal font-bold mb-3 font-montserrat">
                    Comodidades em Destaque:
                  </h4>
                  <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-charcoal-muted">
                    {item.features.map(f => (
                      <li class="flex items-center gap-2">
                        <span class="text-natureGold font-bold">✓</span>
                        <span>{f}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>

            <div class="p-8 pt-0">
              <a 
                href="/reservar?perfil=casais" 
                class="w-full block text-center font-montserrat font-bold text-xs uppercase tracking-widest py-3.5 rounded-xl bg-natureGold hover:bg-natureGold-light text-charcoal-dark transition-all duration-300 shadow-md"
              >
                Verificar Disponibilidade deste Alojamento
              </a>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>


  <!-- =========================================================================
       3º PASSO: AS EXPERIÊNCIAS (MOMENTOS EXCLUSIVOS NO RESORT)
       ========================================================================= -->
  <section class="py-16 md:py-24 bg-sand-warm text-charcoal border-t border-b border-sand-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="font-catamaran font-extrabold text-2xl sm:text-3xl md:text-4xl uppercase tracking-wide text-charcoal mb-4">
          Vivências Criadas para Dois
        </h2>
        <p class="font-catamaran text-charcoal-muted text-sm sm:text-base leading-relaxed">
          Rituais termais de relaxamento, jantares sob o céu estrelado e o melhor da gastronomia regional sem sair da herdade.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {experiences.map((exp) => (
          <div class="bg-white overflow-hidden border border-sand-border hover:border-natureGold/40 shadow-soft hover:shadow-luxury transition-all duration-300 group flex flex-col justify-between">
            <div>
              <div class="h-56 overflow-hidden relative">
                <img 
                  src={exp.image} 
                  alt={exp.title} 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                />
                <span class="absolute bottom-3 left-3 bg-[#181614]/85 backdrop-blur-md px-3 py-1 rounded text-xs text-natureGold font-montserrat font-bold">
                  {exp.time}
                </span>
              </div>
              <div class="p-6 space-y-3">
                <h3 class="font-catamaran font-extrabold text-xl text-charcoal uppercase group-hover:text-natureGold transition-colors">
                  {exp.title}
                </h3>
                <p class="font-catamaran text-charcoal-muted text-sm leading-relaxed">
                  {exp.desc}
                </p>
              </div>
            </div>
            <div class="p-6 pt-0">
              <a 
                href="/experiencias" 
                class="text-xs uppercase tracking-wider text-natureGold-dark hover:text-natureGold font-montserrat font-bold inline-flex items-center gap-1.5"
              >
                <span>Saber Mais</span>
                <span>→</span>
              </a>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>


  <!-- =========================================================================
       4º PASSO: O QUE FAZER (ARREDORES & ATIVIDADES A DOIS)
       ========================================================================= -->
  <section class="py-16 md:py-24 bg-white text-charcoal">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="font-catamaran font-extrabold text-2xl sm:text-3xl md:text-4xl uppercase tracking-wide text-charcoal mb-4">
          Descobrir o Tejo & Belver
        </h2>
        <p class="font-catamaran text-charcoal-muted text-sm sm:text-base leading-relaxed">
          A poucos minutos da herdade, percursos cinematográficos na margem do rio e o património medieval do concelho de Gavião esperam por vocês.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {surroundingActivities.map((act) => (
          <div class="bg-sand-warm/60 overflow-hidden border border-sand-border hover:border-natureGold/40 shadow-soft hover:shadow-luxury transition-all duration-300 group">
            <div class="h-60 overflow-hidden relative">
              <img 
                src={act.image} 
                alt={act.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
              />
              <span class="absolute top-3 right-3 bg-white/95 backdrop-blur-md px-3 py-1 rounded text-xs text-charcoal font-montserrat font-semibold shadow-sm flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-natureGold shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                <span>{act.distance}</span>
              </span>
            </div>
            <div class="p-6 space-y-3">
              <h3 class="font-catamaran font-extrabold text-xl text-charcoal uppercase group-hover:text-natureGold transition-colors">
                {act.title}
              </h3>
              <p class="font-catamaran text-charcoal-muted text-sm leading-relaxed">
                {act.desc}
              </p>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-12 text-center">
        <a 
          href="/arredores" 
          class="inline-flex items-center gap-2 font-montserrat font-bold text-xs uppercase tracking-widest px-8 py-3.5 rounded-full border border-sand-border bg-white text-charcoal hover:border-natureGold hover:text-natureGold shadow-soft transition-all"
        >
          <span>Explorar Todos os Roteiros dos Arredores</span>
          <span>→</span>
        </a>
      </div>

    </div>
  </section>


  <!-- =========================================================================
       FAQS ESPECÍFICAS DE CASAIS
       ========================================================================= -->
  <section class="py-16 md:py-20 bg-sand-warm text-charcoal border-t border-sand-border">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      
      <div class="text-center mb-12">
        <h2 class="font-catamaran font-extrabold text-2xl sm:text-3xl md:text-4xl uppercase tracking-wide text-charcoal">
          Perguntas Frequentes de Casais
        </h2>
      </div>

      <div class="space-y-4">
        {faqs.map((faq) => (
          <div class="p-6 rounded-2xl bg-white border border-sand-border shadow-soft">
            <h3 class="font-catamaran font-bold text-lg text-charcoal mb-2">
              {faq.q}
            </h3>
            <p class="font-catamaran text-charcoal-muted text-sm sm:text-base leading-relaxed">
              {faq.a}
            </p>
          </div>
        ))}
      </div>

    </div>
  </section>


  <!-- =========================================================================
       SECÇÃO DE RESERVA DEDICADA NO FINAL DA PÁGINA (ESTILO A VILA)
       ========================================================================= -->
  <section id="reserva" class="py-12 md:py-16 bg-white border-t border-sand-border">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center mb-6">
      <h2 class="font-catamaran font-extrabold text-2xl sm:text-3xl md:text-4xl uppercase tracking-wide text-charcoal mb-3">
        Reservem a Vossa Escapadinha
      </h2>
      <p class="font-catamaran text-charcoal-muted text-sm sm:text-base max-w-xl mx-auto leading-relaxed">
        Garantam a melhor tarifa disponível diretamente connosco, oferta de garrafa de vinho de boas-vindas e acesso livre ao Wellness Center.
      </p>
    </div>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <BookingBar />
    </div>
  </section>
</BaseLayout>
