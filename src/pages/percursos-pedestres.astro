---
// src/pages/percursos-pedestres.astro
import BaseLayout from '../layouts/BaseLayout.astro';

const items = [
  {
    id: 'pr1',
    code: 'PR1 GAV',
    title: 'PR1 · Encostas do Tejo',
    subtitle: 'Arribas panorâmicas e passadiços com vista para o Castelo de Belver',
    type: 'Linear',
    distance: 'Margem do Rio Tejo',
    difficulty: 'Fácil a Médio',
    image: '/images/arredores/pr1_encostas_tejo.jpg',
    description: 'Um percurso tranquilo e relaxante, com o pano de fundo do Castelo de Belver e do Rio Tejo, construído junto à água em perfeita harmonia com a natureza. A paisagem é deslumbrante e o caminho está repleto de surpresas, com o canto das aves que vivem livres na floresta circundante e os aromas característicos do Alentejo, das estevas e do campo.',
    highlights: [
      'Vistas soberbas sobre a fortaleza medieval e o leito do Tejo',
      'Flora ripícola abundante e observação de aves aquáticas',
      'Passagem pela secular ponte e pelas margens fluviais'
    ],
    infoLink: 'https://www.cm-gaviao.pt/visitar/conhecer/percursos-pedestres/pr1-arribas-do-tejo/'
  },
  {
    id: 'pr2',
    code: 'PR2 GAV',
    title: 'PR2 · Corredor Ecológico das Ribeiras',
    subtitle: 'Ribeiras de Alferreireira e Barrocas com início na aldeia de Atalaia',
    type: 'Circular com 2 Variantes',
    distance: '19 km (Variantes: 3 km e 8 km)',
    difficulty: 'Médio',
    image: '/images/arredores/pr2_corredor_ecologico.jpg',
    description: 'O PR2 é um percurso circular de 19 quilómetros, com início e fim na típica aldeia de Atalaia. Conta com duas variantes mais curtas: a variante dos "Olhos d’Água", de aproximadamente 3 km, e a variante do "Vale de Azenha", com cerca de 8 km. Descubra uma paisagem acompanhada pelo murmúrio da água, que no passado alimentava a força motriz dos moinhos tradicionais.',
    highlights: [
      'Início e fim na aldeia tradicional de Atalaia',
      'Duas variantes adaptáveis: Olhos d’Água (3 km) e Vale de Azenha (8 km)',
      'Antigos moinhos de rodízio e galerias de freixos e amieiros'
    ],
    infoLink: 'https://www.cm-gaviao.pt/visitar/conhecer/percursos-pedestres/pr2-corredor-ecologico-das-ribeiras-de-alferreira-e-barrocas/'
  },
  {
    id: 'pr3',
    code: 'PR3 GAV',
    title: 'PR3 · No Remanso da Ribeira da Venda',
    subtitle: 'Oásis de tranquilidade e frescura no coração do campo alentejano',
    type: 'Circular',
    distance: 'Circuito Ribeirinho',
    difficulty: 'Fácil',
    image: '/images/arredores/pr3_remanso_ribeira.jpg',
    description: 'Um percurso definido pelo encanto da natureza e pela frescura das águas correntes. Passa por um dos recantos mais aprazíveis do concelho, o Parque de Merendas da Ribeira da Venda, famoso pelas suas sombras densas e tranquilidade. É o trilho ideal para desconectar da rotina urbana e conectar-se com a natureza no seu estado mais puro.',
    highlights: [
      'Cruzamento com a praia fluvial e parque da Ribeira da Venda',
      'Passagem pela histórica ponte romana de cantaria',
      'Trilho acessível e muito sombreado, ideal para caminhadas em família'
    ],
    infoLink: 'https://www.cm-gaviao.pt/visitar/conhecer/percursos-pedestres/pr3-no-remanso-da-ribeira-da-venda/'
  },
  {
    id: 'pr4',
    code: 'PR4 GAV',
    title: 'PR4 · Rota dos Moinhos da Ribeira de Margem',
    subtitle: 'Percurso circular histórico com início em Vale de Gaviões',
    type: 'Circular',
    distance: '16,6 km',
    difficulty: 'Médio',
    image: '/images/arredores/pr4_moinhos_margem.jpg',
    description: 'O PR4 é um percurso circular de 16,6 quilómetros com partida e chegada em Vale de Gaviões. Ao longo do trajeto, testemunham-se tanto as marcas da engenharia hidráulica deixadas pelos antigos moleiros como a beleza natural do vale. É marcado por paisagens rurais inesquecíveis e pela presença do busto de Mouzinho da Silveira, figura cimeira do Liberalismo em Portugal.',
    highlights: [
      'Testemunhos da molinologia tradicional na Ribeira de Margem',
      'Monumento em memória do estadista Mouzinho da Silveira',
      'Grandes panorâmicas sobre montados e vales agrícolas'
    ],
    infoLink: 'https://www.cm-gaviao.pt/visitar/conhecer/percursos-pedestres/pr4-rota-dos-moinhos-da-ribeira-de-margem/'
  },
  {
    id: 'pr8',
    code: 'PR8 GAV',
    title: 'PR8 · Rota da Sirga',
    subtitle: 'Estruturas seculares da sirga e falésias com colónias de abutres',
    type: 'Ligação Linear (PR1 a PR2)',
    distance: '6,5 km',
    difficulty: 'Fácil a Médio',
    image: '/images/arredores/pr8_rota_sirga.jpg',
    description: 'O PR8 conecta o PR1 ao PR2 ao longo de 6,5 km, permitindo explorar toda a margem esquerda do Tejo em Gavião e recuperando caminhos outrora usados por pescadores e barqueiros. Parte do percurso assenta sobre os muros de sirga — estruturas erguidas para puxar embarcações contra a corrente. As arribas rochosas abrigam colónias de abutres e aves protegidas que sobrevoam o vale.',
    highlights: [
      'Passeio histórico sobre os antigos muros de sirga do Rio Tejo',
      'Flora ripícola: freixos, álamos, amendoeiras e salgueiros em socalcos',
      'Observação privilegiada de abutres e aves rupícolas nas escarpas'
    ],
    infoLink: 'https://www.cm-gaviao.pt/visitar/conhecer/percursos-pedestres/pr8-percurso-rota-da-sirga/'
  }
];
---

<BaseLayout 
  title="Percursos Pedestres | Gavião Nature Village — Alto Alentejo"
  description="Conheça a rede de Pequenas Rotas (PR) pedestres de Gavião e Belver: PR1 Encostas do Tejo, PR2 Ribeiras, PR3 Ribeira da Venda, PR4 Moinhos e PR8 Rota da Sirga."
>

  <!-- =========================================================================
       HERO DA PÁGINA (PADRÃO UNIFICADO DO WEBSITE)
       ========================================================================= -->
  <section class="relative h-[38vh] min-h-[290px] md:h-[40vh] md:min-h-[330px] flex flex-col justify-center items-center bg-charcoal overflow-hidden text-white">
    <div class="absolute inset-0 z-0">
      <img 
        src="/images/arredores/hero_percursos.jpg" 
        alt="Percursos Pedestres de Gavião e Belver" 
        class="w-full h-full object-cover opacity-50 scale-105"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/25 to-black/40"></div>
    </div>

    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center my-auto">
      <h1 class="font-catamaran font-extrabold text-3xl sm:text-5xl md:text-6xl uppercase tracking-wider text-white drop-shadow-[0_4px_20px_rgba(0,0,0,0.6)]">
        Percursos Pedestres
      </h1>
    </div>
  </section>


  <!-- =========================================================================
       INTRODUÇÃO EDITORIAL
       ========================================================================= -->
  <section class="py-8 md:py-12 bg-white border-b border-sand-border/70">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
        
        <!-- Coluna Esquerda: Título Editorial -->
        <div class="lg:col-span-5 space-y-4">
          <span class="text-natureGold-dark font-montserrat font-bold text-xs uppercase tracking-widest block">
            Rede de Trilhos PR · Alto Alentejo
          </span>
          <h2 class="font-catamaran font-extrabold text-2xl sm:text-3xl md:text-4xl text-charcoal leading-tight">
            Trilhos marcados entre olivais, ribeiras sonoras, moinhos e muralhas históricas.
          </h2>
        </div>

        <!-- Coluna Direita: Narrativa de Contexto -->
        <div class="lg:col-span-7 lg:pl-8 lg:border-l border-sand-border">
          <p class="font-catamaran text-charcoal text-base sm:text-lg leading-relaxed font-light">
            Caminhar em Gavião é descobrir uma terra onde a mão humana e a natureza convivem em harmonia há milénios. Os percursos pedestres estão devidamente sinalizados segundo as normas da Federação Portuguesa de Campismo e Montanhismo, variando entre passeios ribeirinhos suaves e travessias mais exigentes de 19 km. Para os hóspedes do Gavião Nature Village, estes trilhos são o prolongamento natural da estadia ao ar livre.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- =========================================================================
       SHOWCASE DOS 5 PERCURSOS PEDESTRES (PR)
       ========================================================================= -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20 md:space-y-24">
      
      {items.map((item, idx) => (
        <article id={item.id} class={`grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-center ${idx % 2 === 1 ? 'lg:flex-row-reverse' : ''}`}>
          
          <!-- Imagem Fotográfica -->
          <div class={`lg:col-span-6 ${idx % 2 === 1 ? 'lg:order-2' : ''}`}>
            <div class="relative overflow-hidden shadow-luxury group">
              <img 
                src={item.image} 
                alt={item.title} 
                class="w-full h-80 sm:h-[420px] object-cover transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
              />
              <!-- Código e Distância -->
              <div class="absolute bottom-4 left-4 flex flex-wrap gap-2">
                <span class="bg-natureGold text-charcoal-dark font-montserrat text-xs font-bold px-3 py-1 rounded-full shadow-soft">
                  {item.code}
                </span>
                <span class="bg-black/75 backdrop-blur-md text-white font-montserrat text-xs font-medium px-3 py-1 rounded-full flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 text-natureGold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path></svg>
                  {item.distance}
                </span>
              </div>
            </div>
          </div>

          <!-- Conteúdo Editorial -->
          <div class={`lg:col-span-6 space-y-5 ${idx % 2 === 1 ? 'lg:order-1' : ''}`}>
            <div>
              <div class="flex items-center gap-3 mb-1">
                <span class="text-xs font-montserrat font-bold text-natureGold-dark uppercase tracking-widest">
                  {item.type}
                </span>
                <span class="text-charcoal-muted text-xs">•</span>
                <span class="text-xs font-montserrat font-semibold text-charcoal-muted">
                  Dificuldade: {item.difficulty}
                </span>
              </div>
              <h3 class="font-catamaran font-extrabold text-2xl sm:text-3xl lg:text-4xl uppercase tracking-wide text-charcoal">
                {item.title}
              </h3>
              <p class="font-catamaran text-charcoal-muted text-sm sm:text-base font-semibold mt-1">
                {item.subtitle}
              </p>
            </div>

            <p class="font-catamaran text-charcoal-muted text-sm sm:text-base leading-relaxed">
              {item.description}
            </p>

            <!-- Destaques -->
            <div class="bg-sand-warm rounded-2xl p-5 sm:p-6 border border-sand-border space-y-2.5">
              <h4 class="font-montserrat font-bold text-xs uppercase tracking-wider text-charcoal flex items-center gap-2">
                <svg class="w-4 h-4 text-natureGold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path></svg>
                Características do Percurso:
              </h4>
              <ul class="space-y-1.5 text-xs font-montserrat text-charcoal-muted">
                {item.highlights.map(h => (
                  <li class="flex items-start gap-2">
                    <span class="text-natureGold font-bold">•</span>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Botões / Links -->
            <div class="pt-2 flex flex-wrap items-center gap-3 sm:gap-4">
              {item.infoLink && (
                <a 
                  href={item.infoLink} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 btn-gold font-montserrat font-bold text-xs uppercase tracking-wider px-6 py-3 rounded-xl shadow-soft hover:shadow-gold transition-all whitespace-nowrap cursor-pointer"
                >
                  <span>Guia do Percurso (C.M. Gavião)</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                </a>
              )}
            </div>

          </div>

        </article>
      ))}

    </div>
  </section>

  <!-- =========================================================================
       RODAPÉ EDITORIAL / CONTINUAR A EXPLORAR OS ARREDORES
       ========================================================================= -->
  <section class="py-16 md:py-20 bg-sand-warm border-t border-sand-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      <span class="text-xs uppercase tracking-widest text-natureGold-dark font-bold font-montserrat block">
        Continue a Descobrir o Alto Alentejo
      </span>
      <h3 class="font-catamaran font-extrabold text-2xl sm:text-4xl text-charcoal">
        Conheça Também o Património Histórico e Praias Fluviais
      </h3>
      <p class="font-catamaran text-charcoal-muted text-sm sm:text-base max-w-2xl mx-auto">
        Visite o Castelo de Belver e refresque-se nas águas límpidas da Praia Fluvial do Alamal.
      </p>
      <div class="pt-4 flex flex-wrap items-center justify-center gap-4">
        <a 
          href="/patrimonio-e-cultura" 
          class="btn-gold font-montserrat font-bold text-xs uppercase tracking-wider px-8 py-3.5 rounded-xl shadow-soft hover:shadow-gold transition-all"
        >
          Ver Património e Cultura →
        </a>
        <a 
          href="/natureza-e-lazer" 
          class="bg-white hover:bg-sand-warm text-charcoal border border-sand-border font-montserrat font-bold text-xs uppercase tracking-wider px-8 py-3.5 rounded-xl shadow-sm transition-all"
        >
          Ver Natureza e Lazer →
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
